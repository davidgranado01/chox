<?xml version="1.0" encoding="UTF-8"?>
<project
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
    xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>chox</artifactId>
        <groupId>idas</groupId>
        <version>2.0</version>
    </parent>
    <groupId>idas.chox</groupId>
    <artifactId>web</artifactId>
    <version>2.0</version>
    <packaging>war</packaging>
    <name>idas.chox.web</name>
    <description>chox web</description>
    <url>https://www.idaschox.com</url>

    <properties>
        <cxf.version>2.7.17</cxf.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <netbeans.hint.deploy.server>Tomcat</netbeans.hint.deploy.server>
    </properties>

    <build>
        <finalName>idas.chox.web</finalName>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>1.8</source>
                        <target>1.8</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>1.0-alpha-2</version>
                <executions>
                    <!-- Associate the read-project-properties goal with the initialize phase, 
                    to read the properties file. -->
                    <execution>
                        <phase>initialize</phase>
                        <goals>
                            <goal>read-project-properties</goal>
                        </goals>
                        <configuration>
                            <files>
                                <file>${basedir}/src/main/resources/application.properties</file>
                            </files>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>yuicompressor-maven-plugin</artifactId>
                <version>1.1</version>
                <executions>
                    <execution>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>compress</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- For non-minimised (i.e. development=true) builds, the include order for js/css files is defined in the styles/scripts files. -->
                    <aggregations>
                        <!--  JS aggregation  -->
                        <aggregation>
                            <insertNewLine>true</insertNewLine>
                            <removeIncluded>false</removeIncluded>
                            <includes>
                                <include>**/jquery/jquery-1.7.1-min.js</include>
                                <include>**/jquery/jquery.form-min.js</include>
                                <include>**/jquery/jquery.validate-min.js</include>
                                <include>**/jquery/jquery.blockUI-min.js</include>
                                <include>**/query/jquery.metadata-min.js</include>
                                <include>**/extjs/ext-jquery-adapter-min.js</include>
                                <include>**/jquery/additional-methods-min.js</include>
                                <include>**/jquery/jquery.timer-min.js</include>
                                <include>**/extjs/ext-base-3.4.1-min.js</include>
                                <include>**/extjs/ext-all-3.4.1-min.js</include>
                                <include>**/extjs/SuperBoxSelect-min.js</include>
                                <include>**/extjs/RowEditor-3.3.1-min.js</include>
                                <include>**/extjs/ProgressBarPager-3.4.0-min.js</include>
                            </includes>
                            <output>${project.build.directory}/${project.build.finalName}/scripts/libs-${js.aggregator.libs}-min.js</output>
                        </aggregation>
                        <aggregation>
                            <insertNewLine>true</insertNewLine>
                            <removeIncluded>false</removeIncluded>
                            <includes>
                                <include>**/Application-min.js</include>
                                <include>**/actionPanelLib-min.js</include>
                                <include>**/activityMonitor-min.js</include>
                                <include>**/ajax-min.js</include>
                                <include>**/claim_detail-min.js</include>
                                <include>**/general-min.js</include>
                                <include>**/inbox-min.js</include>
                                <include>**/report-min.js</include>
                                <include>**/ui-min.js</include>
                                <include>**/common/choxcommon-min.js</include>
                            </includes>
                            <output>${project.build.directory}/${project.build.finalName}/scripts/choxall-${js.aggregator.choxall}-min.js</output>
                        </aggregation>
                        <!--  CSS aggregation  -->
                        <aggregation>
                            <insertNewLine>true</insertNewLine>
                            <removeIncluded>false</removeIncluded>
                            <includes>
                                <include>**/ext-all-3.4.1-min.css</include>
                                <include>**/ext-roweditor-3.4.0-min.css</include>
                                <include>**/ext-statusbar-3.4.0-min.css</include>
                                <include>**/superboxselect-min.css</include>
                            </includes>
                            <output>${project.build.directory}/${project.build.finalName}/css/libs-${js.aggregator.libs}-min.css</output>
                        </aggregation>
                        <aggregation>
                            <insertNewLine>true</insertNewLine>
                            <removeIncluded>false</removeIncluded>
                            <includes>
                                <include>**/xtheme-erac-min.css</include>
                                <include>**/xtheme-erac_ie6-min.css</include>
                            </includes>
                            <output>${project.build.directory}/${project.build.finalName}/css/branding-libs-${js.aggregator.libs}-min.css</output>
                        </aggregation>
                        <aggregation>
                            <insertNewLine>true</insertNewLine>
                            <removeIncluded>false</removeIncluded>
                            <includes>
                                <include>**/branding_panel_theme-min.css</include>
                            </includes>
                            <output>${project.build.directory}/${project.build.finalName}/css/branding_panel_theme-${js.aggregator.choxall}-min.css</output>
                        </aggregation>
                        <aggregation>
                            <insertNewLine>true</insertNewLine>
                            <removeIncluded>false</removeIncluded>
                            <includes>
                                <include>**/chox_panel_theme-min.css</include>
                            </includes>
                            <output>${project.build.directory}/${project.build.finalName}/css/chox_panel_theme-${js.aggregator.choxall}-min.css</output>
                        </aggregation>
                        <aggregation>
                            <insertNewLine>true</insertNewLine>
                            <removeIncluded>false</removeIncluded>
                            <includes>
                                <include>**/chox-min.css</include>
                            </includes>
                            <output>${project.build.directory}/${project.build.finalName}/css/chox-${js.aggregator.choxall}-min.css</output>
                        </aggregation>
                    </aggregations>
                </configuration>             
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>2.3.2</version>
                <configuration>
                    <source>1.7</source>
                    <target>1.7</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>tomcat-maven-plugin</artifactId>
                <version>1.0-SNAPSHOT</version>
                <configuration>
                    <path>/</path>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>2.4.3</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- WSDL2Java (Apache-CXF) plugin Uncomment only when WSDL (contract-first) 
            changes Yhe JAX-WS maven plugin (wsimport) can also be used - see below -->
            <plugin>
                <groupId>org.apache.cxf</groupId>
                <artifactId>cxf-codegen-plugin</artifactId>
                <version>2.5.11</version>
                <executions>
                    <execution>
                        <id>choxws-generate-sources</id>
                        <phase>generate-sources</phase>
                        <configuration>
                            <sourceRoot>${project.build.directory}/generated-sources/wsdl2java</sourceRoot>
                            <wsdlOptions>
                                <wsdlOption>
                                    <wsdl>${basedir}/src/main/resources/wsdl/chox-webservices.wsdl</wsdl>
                                </wsdlOption>
                            </wsdlOptions>
                        </configuration>
                        <goals>
                            <goal>wsdl2java</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- No longer used - use (the above) CXF codegen plugin instead -->
            <!-- wsimport (JAX-WS) maven plugin Uncomment only when WSDL (contract-first) changes -->
            <!--
                        <plugin>
                            <groupId>org.codehaus.mojo</groupId>
                            <artifactId>jaxws-maven-plugin</artifactId> 
                            <version>1.10</version>
                            <executions>
                                <execution>
                                    <goals>
                                        <goal>wsimport</goal> 
                                    </goals>
                                    <configuration>
                                        <wsdlDirectory>${basedir}/src/main/resources/wsdl</wsdlDirectory>
                                        <wsdlFiles>
                                            <wsdlFile>chox-webservices.wsdl</wsdlFile> 
                                        </wsdlFiles>
                                        <staleFile>${project.build.directory}/jaxws/stale/chox-webservices.stale</staleFile> 
                                    </configuration>
                                    <id>wsimport-generate-chox-webservices</id>
                                    <phase>generate-sources</phase> 
                                </execution>
                            </executions>
                            <dependencies>
                                <dependency>
                                    <groupId>javax.xml</groupId> 
                                    <artifactId>webservices-api</artifactId>
                                    <version>1.4</version>
                                </dependency> 
                                            </dependencies>
                            <configuration>
                                <sourceDestDir>${project.build.directory}/generated-sources/jaxws-wsimport</sourceDestDir> 
                                <xnocompile>true</xnocompile>
                                <verbose>true</verbose>
                                <extension>true</extension> 
                                <catalog>${basedir}/src/jax-ws-catalog.xml</catalog>
                            </configuration>
                        </plugin>
            -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <warName>idas.chox.web</warName>
                    <webResources>
                        <resource>
                            <directory>${basedir}/src</directory>
                            <targetPath>WEB-INF</targetPath>
                            <includes>
                                <include>jax-ws-catalog.xml</include>
                                <include>wsdl/**</include>
                            </includes>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>cobertura-maven-plugin</artifactId>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <filtering>false</filtering>
                <directory>${basedir}/src/main/resources</directory>
            </resource>
        </resources>
    </build>

