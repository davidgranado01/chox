<%@page contentType="text/html" pageEncoding="UTF-8"%>
<script type="text/javascript">

    $(function(){
        createHelpNote(); 

        var liabilityAgreedDatePicker = ui.unvalidatedDateField('liabilityAgreedDate','<s:date format="dd/MM/yyyy" name="liabilityAgreedDate" />','liabilityAgreedDateDiv');
        
        $("#liabilityStatus").change(function(evt){
            var liabilityStatus = $("#liabilityStatus").val();
          
            if ( isLiabilityAccepted()){
                if ( liabilityStatus != 5){
                    $("#percentageLiabilityAccepted").val((100.00).toFixed(2));
                    $("#percentageLiabilityCho").val((0.00).toFixed(2));
                }else {
                    $("#percentageLiabilityAccepted").val((0.00).toFixed(2));
                    $("#percentageLiabilityCho").val((0.00).toFixed(2));
                }
                Ext.getCmp('liabilityAgreedDate').setValue(new Date());
            }else if (isLiabilityRepudiated()) {
                $("#percentageLiabilityAccepted").val((0.00).toFixed(2));
                $("#percentageLiabilityCho").val((100.00).toFixed(2));
                Ext.getCmp('liabilityAgreedDate').setValue("");
            }else{
                $("#percentageLiabilityAccepted").val((0.00).toFixed(2));;
                $("#percentageLiabilityCho").val((0.00).toFixed(2));                              
                Ext.getCmp('liabilityAgreedDate').setValue("");
            }
        });

        $("#percentageLiabilityAccepted").blur(function(){
            var liabilityStatus = $("#liabilityStatus").val();
            var ins = parseFloat($("#percentageLiabilityAccepted").val());
            if (!isNaN(ins)&& ins >= 0 && ins <=100){
                if (liabilityStatus == 5   ){
                    ins = ins.toFixed(2);
                    $("#percentageLiabilityAccepted").val(ins);
                    var cho = (100.00-ins);
                    cho = cho.toFixed(2);
                    $("#percentageLiabilityCho").val(cho);
                } 
            }
        });
        
        $.validator.addMethod(
        "checkRepudiated",
        function(value, element) {
            if ( $("#name").val()=="rejectClaim" & !isLiabilityRepudiated()) {
                return false;
            }
            if (isLiabilityRepudiated()){
                if ($("#name").val()!="rejectClaim") {
                    return false;
                }
            }
            return true;
        }
    );

        $.validator.addMethod(
        "checkTotal",
        function(value, element) {
            if ( isLiabilitySplit()){
                var total = parseFloat($("#percentageLiabilityAccepted").val()) + parseFloat($("#percentageLiabilityCho").val());
                if (isNaN(total) || total > 100 || total <= 0    ) {
                    return false;
                }
            }
            return true;
        }
    );
            
        $.validator.addMethod(
        "checkNotZero",
        function(value, element) {
            if ( isLiabilityAccepted()){
                var total = parseFloat($("#percentageLiabilityAccepted").val()) + parseFloat($("#percentageLiabilityCho").val());
                if (isNaN(total) || total == 0    ) {
                    return false;
                }
            }
            return true;
        }
    );
            
        $.validator.addMethod(
        "checkZero",
        function(value, element) {
            if (  isLiabilityRepudiated()){
                var total = parseFloat($("#percentageLiabilityAccepted").val());
                if (isNaN(total) || total != 0    ) {
                    return false;
                }
            }
            return true;
        }
    );
        
        $.validator.addMethod(
        "checkNegativeValue",
        function(value, element) {
            if (  isLiabilitySplit()){
                var liabilityIns = parseFloat($("#percentageLiabilityAccepted").val());
                var liabilityCho = parseFloat($("#percentageLiabilityCho").val());
                if (isNaN(liabilityIns) || isNaN(liabilityCho) || liabilityIns < 0 || liabilityCho < 0  ) {
                    return false;
                }
            }
            return true;
        }
    );
        

        $.validator.addMethod(
        "checkInsurerNotZero",
        function(value, element) {
            if (  isLiabilitySplit()){
                var total = parseFloat($("#percentageLiabilityAccepted").val());
                if (isNaN(total) || total <= 0    ) {
                    return false;
                }
            }
            return true;
        }
    );

        $.validator.addMethod(
        "checkAcceptedDate",
        function(value, element) {
            if (isLiabilityAccepted()){
                var accdate = $('#liabilityAgreedDate').val();
                var composedDate = new Date();
                var matches = /^(\d{2})[-\/](\d{2})[-\/](\d{4})$/.exec(accdate);
                if(matches != null){
                    var d = matches[1];
                    var m = matches[2] - 1;
                    var y = matches[3];
                    composedDate = new Date(y, m, d);
                }
                if ( accdate == "" ){
                    return false;
                }
                var cur = new Date();
                if ( ( cur - composedDate) < 0 ){
                    return false;
                }
            }
            return true;
        }
    );

        $.validator.addMethod(
        "checkDateBlank",
        function(value, element) {
            if (!isLiabilityAccepted()){
                var accdate = $('#liabilityAgreedDate').val();
                if ( accdate != "" ){
                    return false;
                }
            }
            return true;
        }
    );
        
        $.validator.addMethod(
        "checkDateFormat",
        function(value, element) {
            if(isLiabilityAccepted()){
                var accdate = $("form#formAcknowledgeAction #liabilityAgreedDate").val();
                if ( !isValidDate(accdate) ){
                    return false;
                }
            }
            return true;
        }
    );

        $.validator.addMethod(
        "checkFullAccepted",
        function(value, element) {
            if (isFullAccepted()){
                var ins = parseFloat($("#percentageLiabilityAccepted").val())
                var cho = parseFloat($("#percentageLiabilityCho").val());
                if ( ins != 100){
                    return false;
                }
                if ( cho != 0){
                    return false;
                }
            }
            return true;
        }
    );

        $.validator.addMethod(
        "mustBeFullLiabilityAcepted",
        function(value, element) {
            return (value == 1) || (value == 6);
        }           
    );

        $.validator.addMethod(
        "mustBeFullLiabilityOrSplit",
        function(value, element) {
            return (value == 1) || (value == 5) || (value == 6);
        }           
    );

        $("form#formAcknowledgeAction").validate(
        {

            errorLabelContainer: "#ACKmessageBox",
            rules: {
                claimNumber:{
                    required:true
                },
                liabilityStatus:{
                    range:[1,6]
                },
                percentageLiabilityAccepted:{
                    checkFullAccepted:true,
                    checkTotal:true,
                    checkNotZero:true,
                    checkZero:true,
                    checkNegativeValue:true,
                    max : 100
                },
                percentageLiabilityCho:{
                    max : 100
                },
                indemnityAmount: {
                    number:true
                },
                liabilityAgreedDate:{
                    checkAcceptedDate:true,
                    checkDateFormat: true,
                    checkDateBlank:true
                }
            },
            messages: {
                claimNumber:{
                    required:"You must supply a value for 'Claim Number'"
                },
                liabilityStatus:{
                    range:"You must select a liability status"
                },
                percentageLiabilityAccepted:{
                    checkFullAccepted:"Insurer Liability Percentage Agreed Must Be 100 And CHO Liability Percentage Agreed Must Be 0 To Accept Full Liability",
                    checkTotal:"Sum of percentage liability split must be greater than 0 and not exceed 100",
                    checkNotZero:"Sum of percentage liability split must not be zero",
                    checkInsurerNotZero:"A Value In The 'Liability Percentage Agreed(Insurer)' Field Is Required In Order To proceed On A Split Liability Basis",
                    checkZero:"The Insurer Percentage Liability Agreed Must Equal Zero When The Liability Status Is Repudiated",
                    checkNegativeValue:"Negative values are not allowed in the 'Liability Percentage Agreed' fields",
                    max :"'Liability Percentage Agreed (Insurer)' Must Be Less Than Or Equal To 100."
                },
                percentageLiabilityCho:{
                    max :"'Liability Percentage Agreed (CHO)' Must Be Less Than Or Equal To 100."
                },
                indemnityAmount: {
                    number:"You Must Supply A Numeric Value For 'Indemnity Value'"
                },
                liabilityAgreedDate:{
                    checkAcceptedDate:"Liability agreed date cannot be empty or a future date",
                    checkDateFormat:"Not a valid Liability agreed date - must be in the format DD/MM/YYYY ",
                    checkDateBlank:"Liability agreed date should be empty when liability status is 'In Negotiation','Repudiated' or 'Unknown'"
                }
            }
        });
    });
    
    function doUpdateLiabilityFormSubmit(action){        
        actionPanel.registerAction(action);        
        doFormValidationSetup(action);      
        var form = $("form#formAcknowledgeAction");
        if(form.valid()){
            Ext.get('claimDetailScreenDiv').mask("Reloading Claim...");
            form.submit();
        }
    }

    function doAcknowledgeFormSubmit(action){

        actionPanel.registerAction(action);
        doFormValidationSetup(action);

        if($("#formAcknowledgeAction").valid()){
            $('#ACKmessageBox').text("");
            var reasonOfRejectionDropDown = $("form#formAcknowledgeAction #reasonOfRejectionId");
            //TODO: this is a quick solution for reason of rejeciton validation (in case we press "refer to fnol" and then reject)
            if(action=='rejectClaim' && (reasonOfRejectionDropDown.val() == "" || reasonOfRejectionDropDown.val() == -1) 
                && $('#ACKmessageBox').text().indexOf('Reason For Rejection') == -1){
                $('#ACKmessageBox').append('<br/>').append("You must choose a 'Reason For Rejection'").append('<br/>').show();
            }else if(action=='rejectClaim' && Ext.MessageBox.confirm('Confirm', 'Are you sure you want to reject this claim?',function(btn){if(btn=='yes'){
                    var claimNumber = $("form#formAcknowledgeAction #claimNumber").val();
                    var claimId = $("form#formAcknowledgeAction #claimId").val();
                    var form = $("form#formAcknowledgeAction");

                    if(claimNumber && claimNumber.length > 0){
                        checkClaimNumberDuplicationAndSubmit(claimNumber, claimId, form);
                    }else{
                        Ext.get('claimDetailScreenDiv').mask("Reloading Claim...");
                        form.submit();
                    }
                }else { 
                    return false;
                }})) {
                return false;
            }
            else{
               
                var claimNumber = $("form#formAcknowledgeAction #claimNumber").val();
                var claimId = $("form#formAcknowledgeAction #claimId").val();
                var form = $("form#formAcknowledgeAction");

                if(claimNumber && claimNumber.length > 0){
                    checkClaimNumberDuplicationAndSubmit(claimNumber, claimId, form);
                }else{
                    Ext.get('claimDetailScreenDiv').mask("Reloading Claim...");
                    form.submit();
                }
            }
        }
    }

    function doFormValidationSetup(action){
        //in case there is not a valid date inserted into 'liability agreed date' and the date is not mandatory, we set it to '' 
        var dateValue = $("form#formAcknowledgeAction #liabilityAgreedDate");
        if(dateValue.val().indexOf(' ') >= 0)
            dateValue.val($.trim(dateValue.val()));

        // Clear the validation error box
        $('#ACKmessageBox').text("");

        // First, lets remove all validation from the Liability Status drop-down and Supporting Notes text entry box
        $("form#formAcknowledgeAction #liabilityStatus").rules("remove");
        $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("remove");
        // and remove validation from the Rejection Reason drop-down and Supporting Notes text-entry box
        if (action!='resolveLiability' && action!='updateLiability') {
            $("form#formAcknowledgeAction #reasonOfRejectionId").rules("remove");
            $("form#formAcknowledgeAction #rejecDescJspfId").rules("remove");
        }

        var selectedLiabilityStatusValue = $("#liabilityStatus").val();
        var currentLiabilityStatusValue= <s:property value="liabilityStatusValue"/>;
        var liabilityStatusModified=false;
        if(selectedLiabilityStatusValue != currentLiabilityStatusValue){
                liabilityStatusModified=true;
        }

        var subscriberLiability = <s:property value="fullLiability"/>;
        var fixedFeeLiability = <s:property value="fullLiabilityOrSplit"/>;

        if(action=='rejectClaim'){
            $("form#formAcknowledgeAction #rejecDescJspfId").rules("add", {
                required: true,
                messages: {required: "You must enter 'Supporting Rejection Notes'"}
            });
            $("form#formAcknowledgeAction #reasonOfRejectionId").rules("add", {
                required: true,
                messages: {required: "You must choose a 'Reason For Rejection'"}
            });
            $("form#formAcknowledgeAction #liabilityStatus").rules("add", {
                range:[1,6],
                messages: {range: "You must select a liability status"}
                });
            
            if(liabilityStatusModified){
                addSupportingLiabilityNotesCheck(selectedLiabilityStatusValue);
            }
            
        }else if(action=='acknowledgeClaim'){
            if(subscriberLiability){
                $("form#formAcknowledgeAction #liabilityStatus").rules("add", {
                    mustBeFullLiabilityAcepted: true,
                    messages: {mustBeFullLiabilityAcepted: "Subscriber Claims Can Only Be Accepted When Liability Is Either Full Liability Accepted Or Proceed Without Prejudice."}
                });         
                
                $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("remove","required");
                

            } else if (fixedFeeLiability){
                $("form#formAcknowledgeAction #liabilityStatus").rules("add", {
                    mustBeFullLiabilityOrSplit: true,
                    messages: {mustBeFullLiabilityOrSplit: "Fixed Fee claims can only be accepted when liability is either Full Liability Accepted, Proceed Without Prejudice or Liability Split."}
                }); 
                
                $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("remove","required");
                if (isLiabilitySplit() && liabilityStatusModified)
                    addSupportingLiabilityNotesCheck(selectedLiabilityStatusValue);
            } else {
                $("form#formAcknowledgeAction #liabilityStatus").rules("add", {
                    range:[1,6],
                    messages: {range: "You must select a liability status"}
                });
                
                if(liabilityStatusModified){
                    addSupportingLiabilityNotesCheck(selectedLiabilityStatusValue);
                }
            }
        }else if(action=='referEng'){
            $("form#formAcknowledgeAction #liabilityStatus").rules("add", {
                range:[1,6],
                messages: {range: "You must select a liability status"}
                });
            if (liabilityStatusModified){
                addSupportingLiabilityNotesCheck(selectedLiabilityStatusValue);
            }
        }else if(action=='referFNOL'){
            $("form#formAcknowledgeAction #claimNumber").rules("remove","required");
            $("form#formAcknowledgeAction #liabilityStatus").rules("add", {
                range:[1,6],
                messages: {range: "You must select a liability status"}
                });
            if (liabilityStatusModified){
                addSupportingLiabilityNotesCheck(selectedLiabilityStatusValue);
            }
        }else if(action=='pending'){
            $("form#formAcknowledgeAction #liabilityStatus").rules("add", {
                range:[1,6],
                messages: {range: "You must select a liability status"}
                });
            if (liabilityStatusModified){
                addSupportingLiabilityNotesCheck(selectedLiabilityStatusValue);
            }
        }else if (action=='resolveLiability' || action=='updateLiability'){
            $("form#formAcknowledgeAction #liabilityStatus").rules("add", {
                    range:[1,6],
                    messages: {range: "You must select a liability status"}
            });
            
            $("form#formAcknowledgeAction #claimNumber").rules("remove","required");

            if(liabilityStatusModified){
                addSupportingLiabilityNotesCheck(selectedLiabilityStatusValue);
            }
        }
        
// Not sure what this bit of code is doing here, but this prevents the correct
// display of the "You must choose a 'Reason For Rejection'" validation message"
//        if(action!='rejectClaim' && $("#reasonOfRejectionId").val() == ''){
//            $("#reasonOfRejectionId option[value='']").val(-1);
//        }
    } 

    function addSupportingLiabilityNotesCheck(liabilityStatus){

        if ( liabilityStatus == 2 ){
            $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("add", {
                required: true,
                messages: {required: "You Must Enter Details In The 'Supporting Liability Note (Public)' Field When Selecting The Liability Status 'Liability In Negotiation'"}
            });

        }
        if ( liabilityStatus == 3  ){
            $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("add", {
                required: true,
                messages: {required: "You Must Enter Details In The 'Supporting Liability Note (Public)' Field When Selecting The Liability Status 'Liability Unknown'"}
            });
        }
        if (  liabilityStatus == 4  ){
            $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("add", {
                required: true,
                messages: {required: "You Must Enter Details In The 'Supporting Liability Note (Public)' Field When Selecting The Liability Status 'Liability Repudiated'"}
            });
        }
        if ( liabilityStatus == 5 ){
            $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("add", {
                required: true,
                messages: {required: "You Must Enter Details In The 'Supporting Liability Note (Public)' Field When Selecting The Liability Status 'Liability Split'"}
            });
        }

    }

    function isLiabilityDisputed(){
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 2 || liabilityStatus == 3 || liabilityStatus == 4 ){
            return true;
        }
        return false;
    }

    function isLiabilityUnknown(){
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 0 || liabilityStatus == 3){
            return true;
        }
        return false;
    }

    function isLiabilityRepudiated(){
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 4){
            return true;
        }
        return false;
    }
    function isLiabilitySplit(){
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 5 || liabilityStatus == 6){
            return true;
        }
        return false;
    }
    function isLiabilityAccepted(){
        
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 1 || liabilityStatus == 5 || liabilityStatus == 6){
            return true;
        }
        return false;
    }
    function isFullAccepted(){
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 1 ){
            return true;
        }
        return false;
    }
    function checkClaimNumberDuplicationAndSubmit(claimNumber, claimId, form)
    {
        var url = "<%=request.getContextPath()%>/prv/p/checkIsClaimNumberDuplicated.action";
        var param = {
            claimNumber: claimNumber,
            claimId: claimId
        };

        ajax.loadJson2(url, param, function(data){

            if(data.result && data.resultType=='YesNo'){
                Ext.MessageBox.confirm('Confirm', data.result,function(btn){
                    if(btn=='yes')
                    {
                        Ext.get('claimDetailScreenDiv').mask("Reloading Claim...");
                        form.submit();
                    }
                });
            }
            else {
                Ext.get('claimDetailScreenDiv').mask("Reloading Claim...");
                form.submit();
            }
        });

    }

    function createHelpNote(){
        var note = $('#liabilityStatusHelpNotes').html();
        new Ext.ToolTip({
            target: 'liabilityStatusHelp',
            html: note,
            title: 'Liability Status',
            autoHide: false,
            closable: true,
            draggable:true
        });

        Ext.QuickTips.init();
    }
    
    function isValidDate(date) {
        var matches = /^(\d{2})[-\/](\d{2})[-\/](\d{4})$/.exec(date);
        if (matches == null) return false;
        var d = matches[1];
        var m = matches[2] - 1;
        var y = matches[3];
        var composedDate = new Date(y, m, d);
        return composedDate.getDate() == d &&
            composedDate.getMonth() == m &&
            composedDate.getFullYear() == y;
    }
    
</script>