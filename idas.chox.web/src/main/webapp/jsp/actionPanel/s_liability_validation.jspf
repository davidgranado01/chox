<%@page contentType="text/html" pageEncoding="UTF-8"%>
<script type="text/javascript">

    $(function(){
        createHelpNote();

        var liabilityAgreedDatePicker = ui.dateField('liabilityAgreedDate','<s:date format="dd/MM/yyyy" name="liabilityAgreedDate" />','liabilityAgreedDateDiv');
        
        $("#liabilityStatus").change(function(evt){
            var liabilityStatus = $("#liabilityStatus").val();

           
          
            if ( isLiabilityAccepted()){
                if ( liabilityStatus != 5){
                    $("#percentageLiabilityAccepted").val((100.00).toFixed(2));
                    $("#percentageLiabilityCho").val((0.00).toFixed(2));
                }else {
                    $("#percentageLiabilityAccepted").val((0.00).toFixed(2));
                    $("#percentageLiabilityCho").val((0.00).toFixed(2));
                }
                //                else{
                //                    $("#percentageLiabilityAccepted").val((50.00).toFixed(2));
                //                    $("#percentageLiabilityCho").val((50.00).toFixed(2));
                //                }
                Ext.getCmp('liabilityAgreedDate').setValue(new Date());
            }else if (isLiabilityRepudiated()) {
                $("#percentageLiabilityAccepted").val((0.00).toFixed(2));
                $("#percentageLiabilityCho").val((100.00).toFixed(2));
                Ext.getCmp('liabilityAgreedDate').setValue("");
            }else{
                $("#percentageLiabilityAccepted").val((0.00).toFixed(2));;
                $("#percentageLiabilityCho").val((0.00).toFixed(2));                              
                Ext.getCmp('liabilityAgreedDate').setValue("");
            }
        });

        $("#percentageLiabilityAccepted").blur(function(){
            var liabilityStatus = $("#liabilityStatus").val();
            var ins = parseFloat($("#percentageLiabilityAccepted").val());
            if (!isNaN(ins)&& ins >= 0 && ins <=100){
                if (liabilityStatus == 5   ){
                    ins = ins.toFixed(2);
                    $("#percentageLiabilityAccepted").val(ins);
                    var cho = (100.00-ins);
                    cho = cho.toFixed(2);
                    $("#percentageLiabilityCho").val(cho);
                } 
            }
        });
        
        $.validator.addMethod(
        "checkRepudiated",
        function(value, element) {
            if ( $("#name").val()=="rejectClaim" & !isLiabilityRepudiated()) {
                return false;
            }
            if (isLiabilityRepudiated()){
                if ($("#name").val()!="rejectClaim") {
                    return false;
                }
            }
            return true;
        }
    );

        $.validator.addMethod(
        "checkTotal",
        function(value, element) {
            if ( isLiabilitySplit()){
                var total = parseFloat($("#percentageLiabilityAccepted").val()) + parseFloat($("#percentageLiabilityCho").val());
                if (isNaN(total) || total > 100 || total <= 0    ) {
                    return false;
                }
            }
            return true;
        }
    );
            
        $.validator.addMethod(
        "checkNotZero",
        function(value, element) {
            if ( isLiabilityAccepted()){
                var total = parseFloat($("#percentageLiabilityAccepted").val()) + parseFloat($("#percentageLiabilityCho").val());
                if (isNaN(total) || total == 0    ) {
                    return false;
                }
            }
            return true;
        }
    );
            
        $.validator.addMethod(
        "checkZero",
        function(value, element) {
            if (  isLiabilityRepudiated()){
                var total = parseFloat($("#percentageLiabilityAccepted").val());
                if (isNaN(total) || total != 0    ) {
                    return false;
                }
            }
            return true;
        }
    );

        $.validator.addMethod(
        "checkInsurerNotZero",
        function(value, element) {
            if (  isLiabilitySplit()){
                var total = parseFloat($("#percentageLiabilityAccepted").val());
                if (isNaN(total) || total <= 0    ) {
                    return false;
                }
            }
            return true;
        }
    );

        $.validator.addMethod(
        "checkAcceptedDate",
        function(value, element) {
            if (isLiabilityAccepted()){
                var accdate = Ext.getCmp('liabilityAgreedDate').getValue();
                if ( accdate == "" ){
                    return false;
                }
                var cur = new Date();
                if ( ( cur - accdate) < 0 ){
                    return false;
                }
            }
            return true;
        }
    );

        $.validator.addMethod(
        "checkDateBlank",
        function(value, element) {
            if (!isLiabilityAccepted()){
                var accdate = Ext.getCmp('liabilityAgreedDate').getValue();
                if ( accdate != "" ){
                    return false;
                }
            }
            return true;
        }
    );

        $.validator.addMethod(
        "checkFullAccepted",
        function(value, element) {
            if (isFullAccepted()){
                var ins = parseFloat($("#percentageLiabilityAccepted").val())
                var cho = parseFloat($("#percentageLiabilityCho").val());
                if ( ins != 100){
                    return false;
                }
                if ( cho != 0){
                    return false;
                }
            }
            return true;
        }
    );
            
        $("form#formAcknowledgeAction").validate(
        {

            errorLabelContainer: "#ACKmessageBox",
            rules: {
                claimNumber:{
                    required:true
                },
                liabilityStatus:{
                    range:[1,6]
                },
                percentageLiabilityAccepted:{
                    checkFullAccepted:true,
                    checkTotal:true,
                    checkNotZero:true,
                    checkZero:true
                },
                liabilityAgreedDate:{
                    checkAcceptedDate:true,
                    checkDateBlank:true
                }
            },
            messages: {
                claimNumber:{
                    required:"You must supply a value for 'Claim Number'"
                },
                liabilityStatus:{
                    range:"You must select a liability status"
                },
                percentageLiabilityAccepted:{
                    checkFullAccepted:"Insurer Liability Percentage Agreed Must Be 100 And CHO Liability Percentage Agreed Must Be 0 To Accept Full Liability",
                    checkTotal:"Sum of percentage liability split must be greater than 0 and not exceed 100",
                    checkNotZero:"Sum of percentage liability split must not be zero",
                    checkInsurerNotZero:"A Value In The 'Liability Percentage Agreed(Insurer)' Field Is Required In Order To proceed On A Split Liability Basis",
                    checkZero:"The Insurer Percentage Liability Agreed Must Equal Zero When The Liability Status Is Repudiated"
                },
                liabilityAgreedDate:{
                    checkAcceptedDate:"Liability agreed date cannot be empty or a future date",
                    checkDateBlank:"Liability agreed date should be empty when liability status is 'In Negotiation','Repudiated' or 'Unknown'"
                }
            }
        });

    });
    
    function doUpdateLiabilityFormSubmit(action){        
        actionPanel.registerAction(action);        
        doFormValidationSetup(action);        
        if($("#formAcknowledgeAction").valid()){
            var form = $("form#formAcknowledgeAction");
            form.submit();
        }
    }

    function doAcknowledgeFormSubmit(action){

        actionPanel.registerAction(action);
        doFormValidationSetup(action);

        if($("#formAcknowledgeAction").valid()){

            if(action=='rejectClaim' && !confirm('Are you sure you want to reject this claim?')){
                return;
            }

            var claimNumber = $("form#formAcknowledgeAction input[name$='claimNumber']").val();
            var claimId = $("form#formAcknowledgeAction #claimId").val();
            var form = $("form#formAcknowledgeAction");

            if(claimNumber && claimNumber.length > 0){
                checkClaimNumberDuplicationAndSubmit(claimNumber, claimId, form);
            }else{
                form.submit();
            }
        }
    }

    function doFormValidationSetup(action){
        $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("remove");
        $("form#formAcknowledgeAction #reasonOfRejectionId").rules("remove");
        var liabilityStatus = $("#liabilityStatus").val();
        var validationCheck=false;
        if(<s:property value="liabilityStatusValue"/>>=0){
            if(liabilityStatus!=<s:property value="liabilityStatusValue"/>){
                validationCheck=true;
            }
        }else{
            validationCheck=true;
        }
         
        if(action=='rejectClaim'){
            $("form#formAcknowledgeAction #reasonOfRejectionId").rules("add", {
                required: true,
                messages: {required: "You must choose a 'Reason For Rejection'"}
            });
            if(validationCheck){
                supportingLiabilityCheck(liabilityStatus);
            }
            
        }else if(action=='acknowledgeClaim' && validationCheck){

            supportingLiabilityCheck(liabilityStatus);
        
        }else if(action=='referEng' && validationCheck){

            supportingLiabilityCheck(liabilityStatus);

        }else if(action=='referFNOL' && validationCheck){
            
            supportingLiabilityCheck(liabilityStatus);

        }else if(action=='pending' && validationCheck){
        
            supportingLiabilityCheck(liabilityStatus);

        }else if (action=='resolveLiability'){

            $("form#formAcknowledgeAction #claimNumber").rules("remove","required");

            if(validationCheck){
                supportingLiabilityCheck(liabilityStatus);
            }
            


        }else if(action=='updateLiability'){
            $("form#formAcknowledgeAction #claimNumber").rules("remove","required");

            if(validationCheck){
                supportingLiabilityCheck(liabilityStatus);
            }
            
        }
    }

    function supportingLiabilityCheck(liabilityStatus){

        
        if ( liabilityStatus == 2 ){
            $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("add", {
                required: true,
                messages: {required: "You Must Enter Details In The 'Supporting Liability Note (Public)' Field When Selecting The Liability Status 'Liability In Negotiation'"}
            });

        }
        if ( liabilityStatus == 3  ){
            $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("add", {
                required: true,
                messages: {required: "You Must Enter Details In The 'Supporting Liability Note (Public)' Field When Selecting The Liability Status 'Liability Unknown'"}
            });
        }
        if (  liabilityStatus ==4  ){
            $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("add", {
                required: true,
                messages: {required: "You Must Enter Details In The 'Supporting Liability Note (Public)' Field When Selecting The Liability Status 'Liability Repudiated'"}
            });
        }
        if ( liabilityStatus==5 ){
            $("form#formAcknowledgeAction #supportingLiabilityNotesId").rules("add", {
                required: true,
                messages: {required: "You Must Enter Details In The 'Supporting Liability Note (Public)' Field When Selecting The Liability Status 'Liability Split'"}
            });
        }


    }



    function isLiabilityDisputed(){
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 2 || liabilityStatus == 3 || liabilityStatus ==4 ){
            return true;
        }
        return false;
    }

    function isLiabilityUnknown(){
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 0 || liabilityStatus == 3){
            return true;
        }
        return false;
    }

    function isLiabilityRepudiated(){
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 4){
            return true;
        }
        return false;
    }
    function isLiabilitySplit(){
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 5 || liabilityStatus == 6){
            return true;
        }
        return false;
    }
    function isLiabilityAccepted(){
        
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 1 || liabilityStatus == 5 || liabilityStatus == 6){
            return true;
        }
        return false;
    }
    function isFullAccepted(){
        var liabilityStatus = $("#liabilityStatus").val();
        if ( liabilityStatus == 1 ){
            return true;
        }
        return false;
    }
    function checkClaimNumberDuplicationAndSubmit(claimNumber, claimId, form)
    {
        var url = "<%=request.getContextPath()%>/prv/p/checkIsClaimNumberDuplicated.action";
        var param = {
            claimNumber: claimNumber,
            claimId: claimId
        };

        ajax.loadJson2(url, param, function(data){

            if(data.result && data.resultType=='YesNo'){
                if(confirm(data.result))
                {
                    form.submit();
                }
            }
            else form.submit();
        });

    }

    function createHelpNote(){
        var note = $('#liabilityStatusHelpNotes').html();
        new Ext.ToolTip({
            target: 'liabilityStatusHelp',
            html: note,
            title: 'Liability Status',
            autoHide: false,
            closable: true,
            draggable:true
        });

        Ext.QuickTips.init();
    }

</script>