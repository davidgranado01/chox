<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@ taglib uri="/struts-tags" prefix="s" %>
<script type="text/javascript">
    var invoiceSavingsWindow;
    var formChanged = false;

    Ext.onReady(function () {
        Ext.QuickTips.init();
//        Ext.form.Field.prototype.msgTarget = 'side';
        if (typeof isFormChanged !== 'undefined'){
            formChanged=isFormChanged;
        }

        choxExtAjaxRequest({
            url: '/prv/p/getBreRuleFailures.action',
            params: {
                id: <s:property value="claimId" />
            },
            callback: function (options, success, response) {
                createInvoiceSavingDialog(response.responseText);
            }
        });

    });

    function confirmInvoiceSavingsAction() {
        if (formChanged) {
            Ext.MessageBox.alert('Error', 'The invoice has been adjusted. Please save or reset your changes before agreeing quantum.', function () {
                return false;
            });
        } else {
            Ext.get('claimDetailScreenDiv').mask();
            invoiceSavingsWindow.show(document.body);
        }
        return false;
    }

    function createInvoiceSavingDialog(dataString) {
        var data = Ext.decode(dataString);

        var breRulesJsonReader = new Ext.data.JsonReader({
            totalProperty: 'totalCount',
            root: 'results',
            fields: [
                {type: 'integer', name: 'id'},
                {type: 'string', name: 'ruleName'},
                {type: 'string', name: 'ruleDescription'}
            ]
        });

        var store = new Ext.data.Store({reader: breRulesJsonReader, idProperty: 'ruleName'});

        store.loadData(data);

        var itemsInGroup = [];
        itemsInGroup.push({
            xtype: 'label',
//            itemCls: 'x-check-group-alt',
//            text: "                                            <25%     25-50%     >50%",
            html: "<25%&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;25-50%&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;>50%",
//            fieldStyle: 'text-align: right;',
            labelSeparator:'',
            fieldLabel: " "
            });

        store.each(function (record) {
            var itemsInRuleGroup = [];
            
            itemsInRuleGroup.push({
                hideLabel: true,
//                boxLabel: record.data.ruleDescription,
                name: record.data.ruleName,
                inputValue: record.data.ruleName + ':1'
            });
            itemsInRuleGroup.push({
                hideLabel: true,
//                boxLabel: record.data.ruleDescription,
                name: record.data.ruleName,
                inputValue: record.data.ruleName + ':2'
            });
            itemsInRuleGroup.push({
                hideLabel: true,
//                boxLabel: record.data.ruleDescription,
                name: record.data.ruleName,
                inputValue: record.data.ruleName + ':3'
            });
            itemsInGroup.push({
                    xtype: 'radiogroup',
//            itemCls: 'x-check-group-alt',
                    fieldLabel: record.data.ruleDescription,
                    columns: 3,
                    allowBlank: true,
                    items: itemsInRuleGroup
            });
        });

        var checkGroup = {
            xtype: 'fieldset',
            title: 'BRE Rule Failures',
            layout: 'form',
            collapsible: false,
            items: itemsInGroup
        };


        var invoiceSavingsForm = new choxExtJsFormPanel({
            autoHeight: true,
            labelWidth: 210,
            frame: true,
            title: '<div class="status-info">A saving of £<s:property value="invoiceSavingValue"/> was made on this invoice. Please select from the following failed Business Rules the approximate percentage of the saving for any business rule which contributed to this saving.</div>',
            buttonAlign: 'center',
            items: [
                checkGroup
            ],
            buttons: [{
                    text: 'Ok',
                    handler: function () {
                        if (invoiceSavingsForm.getForm().isValid()) {
                            var selectedRules = Ext.DomQuery.select("input[type='radio']:checked");
                            var rules = '';
                            Ext.each(selectedRules,function(selectedRule){
                                var cmp = Ext.getCmp(selectedRule.id);
                                rules = rules + ',' + cmp.inputValue;
                                },this); //assigning the correct context
                            if (rules.length ===0) {
                                Ext.MessageBox.show({
                                        title: 'Error',
                                        msg: 'You must select at least one rule',
                                        width: 300,
                                        buttons: Ext.MessageBox.OK,
                                        icon: Ext.MessageBox.ERROR
                                });
                                return;
                            }
                            rules = rules.substring(1);
                            Ext.get('claimDetailScreenDiv').unmask();
                            invoiceSavingsWindow.hide();
                            invoiceSavingsForm.getForm().submit({
                                method: 'POST',
                                url: contextPath + '/prv/p/setInvoiceSavingsRule.action?name=invoiceSaving&rules=' + rules,
                                success: function (f, a) {

                                    if (a.result.success) {
                                        pageRefresh();
                                    }
                                },
                                failure: function (f, a) {
                                    Ext.MessageBox.show({
                                        title: 'Error',
                                        msg: a.result.errors,
                                        width: 300,
                                        buttons: Ext.MessageBox.OK,
                                        icon: Ext.MessageBox.ERROR
                                    });
                                }
                            });

                        }
                    }
                }, {
                    text: 'Cancel',
                    handler: function () {
                        invoiceSavingsForm.getForm().reset();
                        Ext.get('claimDetailScreenDiv').unmask();
                        invoiceSavingsWindow.hide();
                    }
                }, {
                    text: 'Reset',
                    handler: function () {
                        invoiceSavingsForm.getForm().reset();
                    }
                }]

        });



        invoiceSavingsWindow = new Ext.Window({
            layout: 'fit',
            width: 450,
            autoHeight: true,
            closable: false,
            resizable: false,
            items: [
                invoiceSavingsForm
            ]
        });
    }

</script>
