<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@ taglib uri="/struts-tags" prefix="s" %>
<script type="text/javascript">

    Ext.onReady(function(){
        
        var brandingJsonReader = new Ext.data.JsonReader({
            totalProperty: 'totalCount',
            root: 'results',
            fields:
                [
                {name:'text'},
                {name:'value'}
            ]
        });
                
        var brandingData = Ext.util.JSON.decode('<s:property value="brandingJsonString" escape="false"/>');
        
        var brandingStore = new Ext.data.Store({
            data : brandingData,
            reader : brandingJsonReader
        });
                
        var brandingCombo = new Ext.form.ComboBox({
            store: brandingStore,
            width: 80,
            renderTo: 'brandingComboDiv',
            valueField: 'value',
            value : '<s:property value="branding.getDescription()"/>',
            id: 'brandingComboId',
            hiddenName: 'branding',
            displayField:'text',
            mode: 'local',
            triggerAction: 'all',
            selectOnFocus: true,
            forceSelection : true,
            editable : false
        });
        
    });


</script>
