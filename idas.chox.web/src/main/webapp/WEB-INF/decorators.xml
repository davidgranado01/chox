<?xml version="1.0" encoding="ISO-8859-1"?>

<decorators defaultdir="/WEB-INF/decorators">
    <!-- Any urls that are excluded will never be decorated by Sitemesh -->
    <excludes>
        <pattern>/messadmin*</pattern>
        <pattern>/download/*</pattern>
        <pattern>/css/*</pattern>
        <pattern>/scripts/*</pattern>
        <pattern>/images/*</pattern>
        <pattern>/struts/*</pattern>
        <pattern>/p/*</pattern>
        <pattern>/prv/p/*</pattern>
        <pattern>/prv/processBatchClaims.action*</pattern>
        <pattern>/login.action*</pattern>
        <pattern>/logBack/*</pattern>
        <!--pattern>/RSA_chox_support.html</pattern-->
    </excludes>

    <decorator name="simple" page="simple.jsp">
        <pattern>/prv/openUserAccountRedirect.action</pattern>
    </decorator>
    
    <decorator name="bare" page="bare.jsp">
        <pattern>/*.html</pattern>
    </decorator>
    
    <decorator name="main" page="main.jsp">
        <pattern>/*</pattern>
    </decorator>

</decorators>
