                <bean class="idas.chox.service.bre.rules.EstateChargeCheck"></bean>
                <bean class="idas.chox.service.bre.rules.NonStandardRiskInsurancePremiumCheck"></bean>
                <bean class="idas.chox.service.bre.rules.CDWChargeCheck"></bean>
