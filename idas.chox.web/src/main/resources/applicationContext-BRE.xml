                <bean class="idas.chox.service.bre.rules.ClaimHasZeroDiscountForDA"></bean>
                <bean class="idas.chox.service.bre.rules.HandlingInvoiceAmountAddedToDeductionForHandlingFeeEqualsZero"></bean>
                <bean class="idas.chox.service.bre.rules.HasSuppliedCorrectTotalToPay"></bean>
