                <bean class="idas.chox.service.bre.rules.HireGrossSumCheck"></bean>
                <bean class="idas.chox.service.bre.rules.RepairGrossSumCheck"></bean>
                <bean class="idas.chox.service.bre.rules.TotalLossFeeGrossSumCheck"></bean>
