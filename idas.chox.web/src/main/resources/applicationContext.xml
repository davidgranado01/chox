            </list>
        </constructor-arg>
    </bean>

    <bean id="dataSource" class="com.jolbox.bonecp.BoneCPDataSource" destroy-method="close">
        <property name="driverClass" value="org.postgresql.Driver"></property>
        <property name="jdbcUrl" value="${db.url}"></property>
        <property name="username" value="chox_user"/>
        <property name="password" value="ch0xpa33"/>
        <property name="partitionCount" value="${db.partitionCount}"/>
        <property name="minConnectionsPerPartition" value="${db.minConnectionsPerPartition}"/>
        <property name="maxConnectionsPerPartition" value="${db.maxConnectionsPerPartition}"/>
        <property name="idleMaxAgeInMinutes" value="2"/>
        <property name="acquireIncrement" value="1"/>
        <property name="idleConnectionTestPeriodInMinutes" value="0"/>
        <property name="statementsCacheSize" value="100"/>
        <property name="releaseHelperThreads" value="2"/>
        <property name="closeConnectionWatch" value="false"/>
        <property name="logStatementsEnabled" value="${db.logStatements}"/>
        <property name="transactionRecoveryEnabled" value="false"/>
        <property name="queryExecuteTimeLimitInMs" value="1000"/>
        <property name="poolAvailabilityThreshold" value="0"/>
        <property name="disableConnectionTracking" value="true"/>
        <property name="connectionTimeoutInMs" value="0"/>
        <property name="lazyInit" value="false"/>
        <property name="poolName" value="ApplicationDataSource"/>
    </bean>
    
    <bean id="reportsDataSource" class="com.jolbox.bonecp.BoneCPDataSource" destroy-method="close">
        <property name="driverClass" value="org.postgresql.Driver"></property>
        <property name="jdbcUrl" value="${db.reportUrl}"></property>
        <property name="username" value="chox_mi"/>
        <property name="password" value="ch0xpa33"/>
        <property name="partitionCount" value="${db.reportPartitionCount}"/>
        <property name="minConnectionsPerPartition" value="${db.reportMinConnectionsPerPartition}"/>
        <property name="maxConnectionsPerPartition" value="${db.reportMaxConnectionsPerPartition}"/>
        <property name="idleMaxAgeInMinutes" value="2"/>
        <property name="acquireIncrement" value="1"/>
        <property name="idleConnectionTestPeriodInMinutes" value="0"/>
        <property name="statementsCacheSize" value="100"/>
        <property name="releaseHelperThreads" value="1"/>
        <property name="closeConnectionWatch" value="false"/>
        <property name="logStatementsEnabled" value="${db.logStatements}"/>
        <property name="transactionRecoveryEnabled" value="false"/>
        <property name="queryExecuteTimeLimitInMs" value="1000"/>
        <property name="poolAvailabilityThreshold" value="0"/>
        <property name="disableConnectionTracking" value="true"/>
        <property name="connectionTimeoutInMs" value="0"/>
        <property name="lazyInit" value="false"/>
        <property name="poolName" value="ReportDataSource"/>
    </bean>
    
    <bean id="sessionFactory" class="org.springframework.orm.hibernate3.LocalSessionFactoryBean">
        <property name="entityInterceptor">
            <ref bean="auditInterceptor"/>
        </property>
        <property name="dataSource">
            <ref bean="dataSource" />
        </property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.cache.use_second_level_cache">true</prop>
                <prop key="hibernate.cache.use_query_cache">true</prop>
                <prop key="hibernate.cache.region.factory_class">net.sf.ehcache.hibernate.EhCacheRegionFactory</prop>
                <!-- <prop key="net.sf.ehcache.configurationResourceName">/my/path/ehcache.xml</prop> -->
            </props>
        </property>
        <property name="mappingResources">
            <ref bean="mappingResource" /> 
        </property>
    </bean>
    
    <bean id="reportsSessionFactory" class="org.springframework.orm.hibernate3.LocalSessionFactoryBean">
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.cache.use_second_level_cache">false</prop>
                <prop key="hibernate.cache.use_query_cache">false</prop>
                <prop key="hibernate.cache.region.factory_class">net.sf.ehcache.hibernate.EhCacheRegionFactory</prop>
            </props>
        </property>
        <property name="dataSource">
            <ref bean="reportsDataSource" />
        </property>
        <property name="mappingResources">
            <ref bean="mappingResource" />
        </property>
    </bean>


    <bean id="transactionManager" class="org.springframework.orm.hibernate3.HibernateTransactionManager">
        <property name="sessionFactory" ref="sessionFactory"/>
    </bean>
    
    <bean id="reportsTransactionManager" class="org.springframework.orm.hibernate3.HibernateTransactionManager">
        <property name="sessionFactory" ref="reportsSessionFactory"/>
    </bean>
    
    <tx:annotation-driven transaction-manager="transactionManager" proxy-target-class="true" />
    
    <tx:advice id="reportTransactionAdvice" transaction-manager="reportsTransactionManager">
        <tx:attributes>
            <tx:method name="*" read-only="true"/>
        </tx:attributes>
    </tx:advice>
    
    <aop:config>
        <aop:pointcut id="reportServiceMethods" expression="execution(* idas.chox.core.services.ReportDataService.*(..))"/>
        <aop:advisor pointcut-ref="reportServiceMethods" advice-ref="reportTransactionAdvice"/>
    </aop:config>
    
    <bean id="securityInfoProvider" class="idas.chox.web.security.WebSecurityInfoProvider"/>

    <bean id="userDetailsService" class="idas.chox.web.security.WebUserService">
        <property name="userService">
            <ref bean="userService" />
        </property>
    </bean>

    <bean id="auditInterceptor" class="idas.chox.data.DBInterceptor">
        <property name="securityInfoProvider" ref="securityInfoProvider"/>
        <!-- The following creates a circular dependency!! -->
        <!--property name="fullAuditService" ref="fullAuditService"/-->
    </bean>

    <bean id="hpiCheck" class="idas.chox.core.hpi.Hpi" factory-method="getInstance">
        <property name="active" value="${hpi.active}"/>
        <property name="hpiUrl" value="http://www.hpixml.com/servlet/HpiGate1_0"/>
        <property name="efxidParam" value="0458006"/>
        <property name="passwordParam" value="EXCEL"/>
        <property name="initialsParam" value="er"/>
    </bean>

</beans>
