<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:aop="http://www.springframework.org/schema/aop"
    xmlns:tx="http://www.springframework.org/schema/tx"
    xsi:schemaLocation="
    http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
    http://www.springframework.org/schema/tx http://www.springframework.org/schema/tx/spring-tx-2.5.xsd
    http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop-2.5.xsd"
    default-autowire="autodetect" >

    <bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource">
        <property name="driverClassName" value="org.postgresql.Driver"></property>
        <property name="url" value="jdbc:postgresql://localhost:5432/chox"></property>
        <property name="username" value="chox_user"/>
        <property name="password" value="ch0xpa33"/>
        <property name="initialSize" value="15"/>
        <property name="maxActive" value="75"/>
    </bean>

    <bean id="sessionFactory" class="org.springframework.orm.hibernate3.LocalSessionFactoryBean">
        <property name="dataSource">
            <ref bean="dataSource" />
        </property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.cache.use_second_level_cache">true</prop>
                <prop key="hibernate.cache.use_query_cache">true</prop>
                <prop key="hibernate.cache.region.factory_class">net.sf.ehcache.hibernate.EhCacheRegionFactory</prop>
                <!-- <prop key="net.sf.ehcache.configurationResourceName">/my/path/ehcache.xml</prop> -->
            </props>
        </property>
        <property name="mappingResources">
            <list>
                <value>hbm/History.hbm.xml</value>
                <value>hbm/WebUser.hbm.xml</value>
                <value>hbm/WebUserRole.hbm.xml</value>
                <value>hbm/BreBandOrganisation.hbm.xml</value>
                <value>hbm/Chorganisation.hbm.xml</value>
                <value>hbm/Claim.hbm.xml</value>
                <value>hbm/Customer.hbm.xml</value>
                <value>hbm/EngineerReport.hbm.xml</value>
                <value>hbm/HireMonitoringDetail.hbm.xml</value>
                <value>hbm/Incident.hbm.xml</value>
                <value>hbm/Injury.hbm.xml</value>
                <value>hbm/Insurer.hbm.xml</value>
                <value>hbm/Invoice.hbm.xml</value>
                <value>hbm/InvoiceOriginal.hbm.xml</value>
                <value>hbm/ThirdParty.hbm.xml</value>
                <value>hbm/VehicleClass.hbm.xml</value>
                <value>hbm/VehicleClassPrice.hbm.xml</value>
                <value>hbm/VehicleClassPriceSpecialRate.hbm.xml</value>
                <value>hbm/VehicleHire.hbm.xml</value>
                <value>hbm/Witness.hbm.xml</value>
                <value>hbm/BreBand.hbm.xml</value>
                <value>hbm/InsurerAlias.hbm.xml</value>
                <value>hbm/Accessibility.hbm.xml</value>
                <value>hbm/AccessibilityItem.hbm.xml</value>
                <value>hbm/Comment.hbm.xml</value>
                <value>hbm/Attachment.hbm.xml</value>
                <value>hbm/HireMonitoringEcd.hbm.xml</value>
                <value>hbm/AuditTrail.hbm.xml</value>
                <value>hbm/ReasonOfRejection.hbm.xml</value>
                <value>hbm/WebUserUserRole.hbm.xml</value>
                <value>hbm/InsurerChorganisation.hbm.xml</value>
                <value>hbm/ReasonOfDelay.hbm.xml</value>
                <value>hbm/AttachmentType.hbm.xml</value>
                <value>hbm/Bordereau.hbm.xml</value>
                <value>hbm/BordereauWithoutFile.hbm.xml</value>
                <value>hbm/Workgroup.hbm.xml</value>
                <value>hbm/WebUserWorkgroup.hbm.xml</value>
                <value>hbm/Notification.hbm.xml</value>
                <value>hbm/VehicleClassCeiling.hbm.xml</value>
                <value>hbm/AutomaticRouting.hbm.xml</value>
                <value>hbm/AutomaticRoutingPrice.hbm.xml</value>
                <value>hbm/BillingCho.hbm.xml</value>
                <value>hbm/BillingChoDetail.hbm.xml</value>
                <value>hbm/BillingInsurer.hbm.xml</value>
                <value>hbm/BillingInsurerDetail.hbm.xml</value>
                <value>hbm/BillingChoRate.hbm.xml</value>
                <value>hbm/Task.hbm.xml</value>
                <value>hbm/UploadedXMLClaimsDetail.hbm.xml</value>
                <value>hbm/WebBordereau.hbm.xml</value>
                <value>hbm/PasswordHistory.hbm.xml</value>
                <value>hbm/InsurerDiscount.hbm.xml</value>
            </list>
        </property>
    </bean>

    <bean id="securityInfoProvider" class="idas.chox.web.security.WebSecurityInfoProvider"/>

    <bean id="userDetailsService" class="idas.chox.web.security.WebUserService">
        <property name="userService">
            <ref bean="userService" />
        </property>
    </bean>

    <!-- Transaction manager for a single Hibernate SessionFactory (alternative to JTA) -->
    <bean id="transactionManager" class="org.springframework.orm.hibernate3.HibernateTransactionManager">
        <property name="sessionFactory" ref="sessionFactory"/>
    </bean>

    <tx:annotation-driven transaction-manager="transactionManager" proxy-target-class="true" />

    <bean id="auditInterceptor" class="idas.chox.data.DBInterceptor">
        <property name="securityInfoProvider" ref="securityInfoProvider"/>
    </bean>

    <bean id="hpiCheck" class="idas.chox.core.hpi.Hpi" factory-method="getInstance">
        <property name="active" value="true"/>
        <property name="hpiUrl" value="http://www.hpixml.com/servlet/HpiGate1_0"/>
        <property name="efxidParam" value="0458006"/>
        <property name="passwordParam" value="EXCEL"/>
        <property name="initialsParam" value="er"/>
    </bean>

</beans>
