    <!-- HikariCP configuration for main datasource-->
    <bean id="hikariConfig" class="com.zaxxer.hikari.HikariConfig">
        <property name="dataSourceProperties">
            <props>
                <prop key="url">${db.url}</prop>
                <prop key="user">chox_user</prop>
                <prop key="password">ch0xpa33</prop>
            </props>
        </property>
        <property name="poolName" value="hikariCP" />
        <property name="dataSourceClassName" value="org.postgresql.ds.PGSimpleDataSource" />
        <property name="maximumPoolSize" value="${db.maxPoolSize}" />
        <property name="autoCommit" value="true" /> 
        <property name="idleTimeout" value="60000" /> <!-- default  600000 (10mins) -->
        <property name="maxLifetime" value="1800000" /> <!-- default 1800000 (30mins) -->
        <property name="connectionTimeout" value="30000" /> <!-- default  30000 (10mins) -->
        <property name="leakDetectionThreshold" value="15000" /> <!-- default  0 (disabled) -->
        <property name="registerMbeans" value="true" /> 
    </bean>
    
     <bean id="mainDataSource" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
        <constructor-arg ref="hikariConfig" />
    </bean>

    <!-- HikariCP configuration for Report/MI datasource-->
    <bean id="hikariConfigReports" class="com.zaxxer.hikari.HikariConfig">
        <property name="dataSourceProperties">
            <props>
                <prop key="url">${db.url}</prop>
                <prop key="user">chox_mi</prop>
                <prop key="password">ch0xpa33</prop>
            </props>
        </property>
        <property name="poolName" value="hikariReportCP" />
        <property name="dataSourceClassName" value="org.postgresql.ds.PGSimpleDataSource" />
        <property name="maximumPoolSize" value="${db.maxReportPoolSize}" />
        <property name="autoCommit" value="true" /> 
        <property name="idleTimeout" value="60000" /> <!-- default  600000 (10mins) -->
        <property name="maxLifetime" value="1800000" /> <!-- default 1800000 (30mins) -->
    </bean>
 
    <bean id="reportsDataSource" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
        <constructor-arg ref="hikariConfigReports" />
    </bean>
    
    <bean id="sessionFactory" class="org.springframework.orm.hibernate3.LocalSessionFactoryBean">
        <property name="entityInterceptor">
            <ref bean="auditInterceptor"/>
        </property>
        <property name="dataSource">
            <ref bean="mainDataSource" />
        </property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.cache.use_second_level_cache">false</prop>
                <prop key="hibernate.cache.use_query_cache">false</prop>
                <prop key="hibernate.connection.autocommit">true</prop>
                <!--prop key="hibernate.connection.release_mode">after_statement</prop--> <!-- auto (default), after_transaction, after_statement  -->
<!--                <prop key="hibernate.cache.region.factory_class">net.sf.ehcache.hibernate.EhCacheRegionFactory</prop>-->
                <!-- <prop key="net.sf.ehcache.configurationResourceName">/my/path/ehcache.xml</prop> -->
            </props>
        </property>
        <property name="mappingResources">
            <ref bean="mappingResource" /> 
        </property>
    </bean>
    
    <bean id="reportsSessionFactory" class="org.springframework.orm.hibernate3.LocalSessionFactoryBean">
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.cache.use_second_level_cache">false</prop>
                <prop key="hibernate.cache.use_query_cache">false</prop>
                <prop key="hibernate.connection.autocommit">true</prop>
<!--                <prop key="hibernate.cache.region.factory_class">net.sf.ehcache.hibernate.EhCacheRegionFactory</prop>-->
            </props>
        </property>
        <property name="dataSource">
            <ref bean="reportsDataSource" />
        </property>
        <property name="mappingResources">
            <ref bean="mappingResource" />
        </property>
    </bean>


    <bean id="transactionManager" class="org.springframework.orm.hibernate3.HibernateTransactionManager">
        <property name="sessionFactory" ref="sessionFactory"/>
    </bean>
    
    <bean id="reportsTransactionManager" class="org.springframework.orm.hibernate3.HibernateTransactionManager">
        <property name="sessionFactory" ref="reportsSessionFactory"/>
    </bean>
    
    <tx:annotation-driven transaction-manager="transactionManager" proxy-target-class="true" />
    
    <tx:advice id="reportTransactionAdvice" transaction-manager="reportsTransactionManager">
        <tx:attributes>
            <tx:method name="*" read-only="true"/>
        </tx:attributes>
    </tx:advice>
    
    <aop:config>
        <aop:pointcut id="reportServiceMethods" expression="execution(* idas.chox.core.services.ReportDataService.*(..))"/>
        <aop:advisor pointcut-ref="reportServiceMethods" advice-ref="reportTransactionAdvice"/>
    </aop:config>
    
    <bean id="securityInfoProvider" class="idas.chox.web.security.WebSecurityInfoProvider"/>

    <bean id="userDetailsService" class="idas.chox.web.security.WebUserService">
        <property name="userService">
            <ref bean="userService" />
        </property>
    </bean>

    <bean id="auditInterceptor" class="idas.chox.data.DBInterceptor">
        <property name="securityInfoProvider" ref="securityInfoProvider"/>
        <!-- The following creates a circular dependency!! -->
        <!--property name="fullAuditService" ref="fullAuditService"/-->
    </bean>

