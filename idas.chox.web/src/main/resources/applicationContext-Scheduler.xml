<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:s="http://www.springframework.org/schema/security"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
	http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security-2.0.2.xsd">
	
	<bean id="imapMailReceiver" class="idas.chox.web.scheduler.ImapMailReceiver" scope="singleton">
		<property name="mailHost" value="${mailHost}"/>
		<property name="mailStoreProtocol" value="${mailStoreProtocol}"/>
		<property name="mailPort" value="${mailPort}"/>
		<property name="mailFolder" value="${mailFolder}"/>
	</bean>
	
	<bean id="mailSecurityAthenticator" class="idas.chox.web.scheduler.MailSecurityAthenticator">
		<property name="authenticationManager" ref="authenticationManager" />
	</bean>
	
	<bean id="xlsFileParser" class="idas.chox.web.scheduler.XlsFileParser" scope="singleton"/>
	
	<bean id="mailUtil" class="idas.chox.web.scheduler.MailUtil" scope="singleton"/>
	
    <!--  CHO Reference Update -->
	<bean id="referenceUpdateJob" class="idas.chox.web.scheduler.ReferenceUpdateJob">
		<property name="imapMailReceiver" ref="imapMailReceiver"/>
		<property name="mailSecurityAthenticator" ref="mailSecurityAthenticator"/>
		<property name="xlsFileParser" ref="xlsFileParser"/>
		<property name="claimService" ref="claimService" />
		<property name="mailUtil" ref="mailUtil" />
		
		<property name="emailAccount" value="${emailAccount}"/>
		<property name="emailAccountPassword" value="${emailAccountPassword}"/>
		
		<property name="privilegedUsers" value="${refUpdate_privilegedUsers}"/>
		<property name="bccReceivers" value="${refUpdate_bccReceivers}"/>
		<property name="emailSubject" value="${refUpdate_emailSubject}"/>
		<property name="updateUserName" value="${refUpdate_updateUserName}"/>
		<property name="updatePassword" value="${refUpdate_updatePassword}"/>
		
		<property name="smtpHostName" value="${smtpHostName}"/>
		<property name="smtpPort" value="${smtpPort}"/>
		<property name="smtpEmailUser" value="${smtpEmailUser}"/>
		<property name="smtpEmailPassword" value="${smtpEmailPassword}"/>
		
	</bean>
	
	<bean id="referenceUpdateJobDetail" class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
  		<property name="targetObject" ref="referenceUpdateJob" />
  		<property name="targetMethod" value="execute" />
  		<property name="concurrent" value="false" />
	</bean>


	<!-- Simple Trigger -->
<!--	<bean id="simpleTrigger" class="org.springframework.scheduling.quartz.SimpleTriggerBean">
		<property name="jobDetail" ref="referenceUpdateJobDetail" />
		<property name="repeatInterval" value="120000" />
		<property name="startDelay" value="1000" />
	</bean>-->

	<!-- Cron Trigger -->
 	<bean id="cronRefUpdateTriggerWeek" class="org.springframework.scheduling.quartz.CronTriggerBean"> 
 		<property name="jobDetail" ref="referenceUpdateJobDetail" /> 
 		<property name="cronExpression" value="0 0,30 7-19 ? * 2-6" /> 
 	</bean> 
 	<bean id="cronRefUpdateTriggerWeekend" class="org.springframework.scheduling.quartz.CronTriggerBean"> 
 		<property name="jobDetail" ref="referenceUpdateJobDetail" /> 
 		<property name="cronExpression" value="0 0,30 8-14 ? * 1,7" /> 
 	</bean> 



    <!--  Penalty Charge Start Date Update -->
	<bean id="penaltyStartDateUpdateJob" class="idas.chox.web.scheduler.PenaltyChargeUpdateJob">
		<property name="imapMailReceiver" ref="imapMailReceiver"/>
		<property name="mailSecurityAthenticator" ref="mailSecurityAthenticator"/>
		<property name="xlsFileParser" ref="xlsFileParser"/>
		<property name="claimService" ref="claimService" />
		<property name="mailUtil" ref="mailUtil" />
		
		<property name="emailAccount" value="${emailAccount}"/>
		<property name="emailAccountPassword" value="${emailAccountPassword}"/>
		
		<property name="privilegedUsers" value="${penUpdate_privilegedUsers}"/>
		<property name="bccReceivers" value="${penUpdate_bccReceivers}"/>
		<property name="emailSubject" value="${penUpdate_emailSubject}"/>
		<property name="updateUserName" value="${penUpdate_updateUserName}"/>
		<property name="updatePassword" value="${penUpdate_updatePassword}"/>
		
		<property name="smtpHostName" value="${smtpHostName}"/>
		<property name="smtpPort" value="${smtpPort}"/>
		<property name="smtpEmailUser" value="${smtpEmailUser}"/>
		<property name="smtpEmailPassword" value="${smtpEmailPassword}"/>
		
	</bean>
	
	<bean id="penaltyStartDateUpdateJobDetail" class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
  		<property name="targetObject" ref="penaltyStartDateUpdateJob" />
  		<property name="targetMethod" value="execute" />
  		<property name="concurrent" value="false" />
	</bean>


	<!-- Simple Trigger -->
<!--	<bean id="simplePenaltyUpdateTrigger" class="org.springframework.scheduling.quartz.SimpleTriggerBean">
		<property name="jobDetail" ref="penaltyStartDateUpdateJobDetail" />
		<property name="repeatInterval" value="120000" />
		<property name="startDelay" value="60000" />
	</bean>-->

	<!-- Cron Trigger -->
 	<bean id="cronPenaltyUpdateTriggerWeek" class="org.springframework.scheduling.quartz.CronTriggerBean"> 
 		<property name="jobDetail" ref="penaltyStartDateUpdateJobDetail" /> 
 		<property name="cronExpression" value="0 0/5 17-18 ? * 2-6" /> 
 	</bean> 
<!-- 	<bean id="cronPenaltyUpdateTriggerWeekend" class="org.springframework.scheduling.quartz.CronTriggerBean"> 
 		<property name="jobDetail" ref="penaltyStartDateUpdateJobDetail" /> 
 		<property name="cronExpression" value="0/5 * * * * ?" /> 
 	</bean>-->
    

	<bean class="org.springframework.scheduling.quartz.SchedulerFactoryBean">
		<property name="autoStartup" value="true" />
		<property name="quartzProperties">
			<props>
				<prop key="org.quartz.jobStore.class">org.quartz.simpl.RAMJobStore</prop>
				<prop key="org.quartz.jobStore.misfireThreshold">60000</prop>				
			</props>
		</property>
		<property name="jobDetails">
			<list>
				<ref bean="referenceUpdateJobDetail" />
				<ref bean="penaltyStartDateUpdateJobDetail" />
			</list>
		</property>
		<property name="triggers">
			<list>
<!--				<ref bean="simpleTrigger" /> -->
<!--				<ref bean="simplePenaltyUpdateTrigger" /> -->
				<ref bean="cronRefUpdateTriggerWeek" />
				<ref bean="cronRefUpdateTriggerWeekend" />
				<ref bean="cronPenaltyUpdateTriggerWeek" />
			</list>
		</property>
	</bean>

</beans>