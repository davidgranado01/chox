    <!-- Alllow us to use system properties -->
    <!--bean class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer"/-->

    <broker id="localBrokerId" xmlns="http://activemq.apache.org/schema/core" useJmx="false" persistent="false" brokerName="localBroker">
        <networkConnectors>
            <networkConnector
                    uri="static:(failover:tcp://localhost:61616)?maxReconnectDelay=60000"
                    networkTTL="3" 
                    dynamicOnly="true"
                    staticBridge="true">
                <staticallyIncludedDestinations>
                    <topic physicalName="topic.choxEvents"/>
                </staticallyIncludedDestinations>
            </networkConnector>
        </networkConnectors>
        
<!--        <persistenceAdapter>
            <memoryPersistenceAdapter/>
            kahaDB directory="${activemq.base}/data/kahadb"
        </persistenceAdapter>-->
        
        <transportConnectors>
            <transportConnector uri="vm://localhost:7001"/>
        </transportConnectors>

    </broker>
 
    <!-- JMS ConnectionFactory to use for local bridging -->
    <bean id="localBrokerConnectionFactory" class="org.apache.activemq.ActiveMQConnectionFactory" depends-on="localBrokerId">
        <property name="brokerURL" value="vm://localhost:7001" />
    </bean>
    <bean id="cachingBrokerConnectionFactory"
          class="org.springframework.jms.connection.CachingConnectionFactory"
          p:targetConnectionFactory-ref="localBrokerConnectionFactory"
          p:sessionCacheSize="10" />
    
    <!--  ActiveMQ Destination  -->
    <!--queue xmlns="http://activemq.apache.org/schema/core" id="choxEventsQueue" physicalName="queue.choxEvents" /-->
    <topic xmlns="http://activemq.apache.org/schema/core" id="choxEventsTopic" physicalName="topic.choxEvents" />
    <!--bean id="queuedestination" class="org.apache.activemq.command.ActiveMQQueue">
