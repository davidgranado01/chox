<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:amq="http://activemq.apache.org/schema/core"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:p="http://www.springframework.org/schema/p"
       xsi:schemaLocation="http://www.springframework.org/schema/beans 
                           http://www.springframework.org/schema/beans/spring-beans-4.1.xsd
                           http://activemq.apache.org/schema/core
                           http://activemq.apache.org/schema/core/activemq-core.xsd">

    <!-- schedulerSupport="false" networkConnectorStartAsync="true" -->
    <broker id="embeddedLocalBroker" xmlns="http://activemq.apache.org/schema/core" useJmx="false"
            persistent="true" brokerName="embeddedLocalBroker" start="false">
 

        <networkConnectors>
            <networkConnector name="networkConnector_to_standalone"
                              uri="static:(failover:tcp://localhost:61616)?maxReconnectDelay=60000"
                              staticBridge="true">
                              <!-- networkTTL="3" -->
                <staticallyIncludedDestinations>
                    <!--queue physicalName="CHOX.EventQueue"/ -->
                    <topic physicalName="CHOX.Events"/>
                </staticallyIncludedDestinations>
            </networkConnector>
        </networkConnectors>

        <persistenceAdapter>
            <jdbcPersistenceAdapter dataSource="#amq_dataSource" createTablesOnStartup="false">
                <databaseLocker>
                    <database-locker queryTimeout="-1" />
                </databaseLocker>
            </jdbcPersistenceAdapter>
        </persistenceAdapter>
     
        <transportConnectors>
            <transportConnector uri="vm://localhost:7001"/>
        </transportConnectors>

        <plugins>
            <loggingBrokerPlugin logAll="false" logConnectionEvents="true" logInternalEvents="false"/>
        </plugins>

    </broker>
 
    <bean id="hikariAMQConfig" class="com.zaxxer.hikari.HikariConfig">
        <property name="dataSourceProperties">
            <props>
                <!--prop key="database">${db.database}</prop-->
                <prop key="url">${db.url}</prop>
                <prop key="user">chox_amq</prop>
                <prop key="password">ch0xpa33</prop>
            </props>
        </property>
        <property name="poolName" value="hikariAMQCP" />
        <!--property name="dataSourceClassName" value="com.impossibl.postgres.jdbc.PGDataSource" /-->
        <property name="dataSourceClassName" value="org.postgresql.ds.PGSimpleDataSource" />
        <property name="maximumPoolSize" value="${db.maxActiveMQPoolSize}" />
    </bean>

    <!-- HikariCP configuration -->
    <bean id="amq_dataSource" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
        <constructor-arg ref="hikariAMQConfig" />
    </bean>

    <!-- JMS Data Source -->
