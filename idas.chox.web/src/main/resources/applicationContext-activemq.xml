    <!-- JMS ConnectionFactory to use for local bridging -->
    <bean id="localBrokerConnectionFactory" class="org.apache.activemq.ActiveMQConnectionFactory" depends-on="embeddedLocalBroker">
        <property name="brokerURL" value="vm://localhost:7001" />
    </bean>

    <bean id="cachingBrokerConnectionFactory"
          class="org.springframework.jms.connection.CachingConnectionFactory"
          p:targetConnectionFactory-ref="localBrokerConnectionFactory"
          p:sessionCacheSize="10" />
    
    <!--  ActiveMQ Local Destination  -->
    <topic xmlns="http://activemq.apache.org/schema/core" id="choxEventsTopic" physicalName="CHOX.Events" />

    <!-- Define a message template to send to CHOX.EventQueue -->
    <bean id="queue1JMSTemplate"
          class="org.springframework.jms.core.JmsTemplate"
          p:connectionFactory-ref="cachingBrokerConnectionFactory"
          p:timeToLive="691200000"
          p:deliveryPersistent="true"
          p:defaultDestination-ref="choxEventsTopic" />

</beans>