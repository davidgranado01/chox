<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
       xmlns:p="http://www.springframework.org/schema/p"
       xmlns:jms="http://www.springframework.org/schema/jms"
       default-autowire="byName">
 
    
    <!-- local broker with embedded Jms to Jms bridge -->
    <bean id="localBroker" class="org.apache.activemq.broker.BrokerService"
          init-method="start" destroy-method="stop">
        <property name="brokerName" value="localBroker"/>
        <property name="persistent" value="true"/>
        <property name="transportConnectorURIs"> 
            <list>
                <value>vm://localhost:7001</value>
            </list>
        </property>
        <property name="jmsBridgeConnectors">
            <list>
                <ref bean="jmsConnector"/>
            </list>
        </property>
    </bean>

    <!-- JMS ConnectionFactory to use local broker (the one with the bridge) -->
    <bean id="localBrokerConnectionFactory"
      class="org.apache.activemq.ActiveMQConnectionFactory"
      p:brokerURL="vm://localhost:7001" />

    <!--JmsTopicConnector - the Jms bridge -->
    <bean id="jmsConnector" class="org.apache.activemq.network.jms.JmsQueueConnector">
        <property name="outboundQueueConnectionFactory" ref="remoteFactory"/>
        <property name="outboundQueueBridges">
            <list>
                <bean class="org.apache.activemq.network.jms.OutboundQueueBridge">
                    <constructor-arg value="jms/queue/foo"/>
                </bean>
            </list>
        </property>
    </bean>
    
    <bean id="remoteFactory" class="org.apache.activemq.ActiveMQConnectionFactory">
        <property name="brokerURL" 
                  value="failover:(tcp://localhost:61616)?maxReconnectDelay=10" />
    </bean>


    <bean id="cachingBrokerConnectionFactory"
      class="org.springframework.jms.connection.CachingConnectionFactory"
      p:targetConnectionFactory-ref="localBrokerConnectionFactory"
      p:sessionCacheSize="10" />

    <bean id="queue1destination" class="org.apache.activemq.command.ActiveMQQueue">
        <constructor-arg value="jms/queue/foo" />
    </bean>


    <bean id="queue1JMSTemplate"
      class="org.springframework.jms.core.JmsTemplate"
      p:connectionFactory-ref="cachingBrokerConnectionFactory"
      p:defaultDestination-ref="queue1destination" />

</beans>