<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
       default-autowire="byName">
    <bean id="newECDAddedChecker" class="idas.chox.data.notifications.ClaimAnomalousChecker">
        <property name="anomalousChecks">
            <list>
                <bean class="idas.chox.data.notifications.EcdAnomalousNotificationChecker"></bean>
            </list>
        </property>
    </bean>
    <bean id="hireMonitoringDetailUpdatedChecker" class="idas.chox.data.notifications.ClaimAnomalousChecker">
        <property name="anomalousChecks">
            <list>
                <bean class="idas.chox.data.notifications.RepairBookedInOnFridayNotificationChecker"></bean>
                <bean class="idas.chox.data.notifications.RepairBookedInOnSaturdayNotificationChecker"></bean>
                <bean class="idas.chox.data.notifications.RepairBookedInOnSundayNotificationChecker"></bean>
            </list>
        </property>
    </bean>
</beans>
