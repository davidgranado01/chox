    </bean>

    <bean id="hireMonitoringDetailService" class="idas.chox.data.services.HireMonitoringDetailServiceImpl" scope="prototype">
        <property name="sessionFactory" ref="sessionFactory"/>
    </bean>

    <bean id="customerService" class="idas.chox.data.services.CustomerServiceImpl" scope="prototype">
        <property name="sessionFactory" ref="sessionFactory"/>
    </bean>
</beans>