    </logger>
    <logger name="idas.chox.keoghs" level="INFO" additivity="false">
        <appender-ref ref="chox"/>
    </logger>
    <logger name="net.sf.ehcache" level="WARN" additivity="false">
        <appender-ref ref="chox"/>
    </logger>
    <!-- Stop warnings when generating ecel from report: the warnings are juust for null/empty parameters -->
    <logger name="org.apache.commons.jexl2.JexlEngine" level="ERROR" additivity="false">
        <appender-ref ref="chox"/>
    </logger>
    <!-- Set following to DEBUG to log POST requests, to TRACE to log all requests and the POST response-->
    <logger name="idas.chox.web.RequestDumpFilter" level="INFO" additivity="false">
        <appender-ref ref="RD"/>
    </logger>
    <!-- Log Hibernate SQL -->
    <logger name="org.hibernate" level="INFO" additivity="false">
        <appender-ref ref="Hibernate"/>
    </logger>
    <logger name="org.hibernate.stat" additivity="false" level="INFO">
        <appender-ref ref="Hibernate"/>
    </logger>
    <logger name="org.hibernate.SQL" additivity="false" level="INFO">
        <appender-ref ref="HibernateSQL"/>
    </logger>
    <!-- Log Hibernate SQL Parameters -->
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" additivity="false" level="INFO" >
        <appender-ref ref="HibernateSQL" />
    </logger>
    <!-- To also see extracted values, use the below logger on org.hibernate.type -->
    <!--logger name="org.hibernate.type" level="DEBUG" additivity="false">
        <appender-ref ref="HibernateSQL"/>
    </logger-->
        
    <logger name="com.zaxxer.hikari" level="DEBUG" additivity="false">
        <appender-ref ref="Hikari"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="chox"/>
    </root>
