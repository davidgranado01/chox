    <logger name="idas.chox.web.ws" level="INFO" additivity="false">
        <appender-ref ref="WebServices"/>
    </logger>
    <logger name="org.apache.cxf" level="INFO" additivity="false">
        <appender-ref ref="WebServices"/>
    </logger>
    <logger name="org.apache.struts2" level="INFO" additivity="false">
        <appender-ref ref="SpringStruts"/>
    </logger>
    <logger name="org.acegisecurity" level="WARN" additivity="false">
        <appender-ref ref="SpringStruts"/>
    </logger>
    <logger name="net.sf.jxls" level="ERROR" additivity="false">
        <appender-ref ref="SpringStruts"/>
    </logger>
    <logger name="com.opensymphony" level="WARN" additivity="false">
        <appender-ref ref="SpringStruts"/>
    </logger>
    <logger name="org.springframework" level="WARN" additivity="false">
        <appender-ref ref="SpringStruts"/>
    </logger>
    <logger name="org.quartz" level="INFO" additivity="false">
        <appender-ref ref="Quartz"/>
    </logger>
    <logger name="idas.chox.web.scheduler.StoredProcSchedulerJob" level="INFO" additivity="false">
        <appender-ref ref="Quartz"/>
    </logger>
    <logger name="org.springframework.scheduling" level="INFO" additivity="false">
        <appender-ref ref="Quartz"/>
    </logger>
    <logger name="idas.chox.web.scheduler" level="INFO" additivity="false">
        <appender-ref ref="Quartz"/>
    </logger>
    <logger name="idas.chox.web.scheduler.GmailSchedulerJob" level="DEBUG" additivity="false">
