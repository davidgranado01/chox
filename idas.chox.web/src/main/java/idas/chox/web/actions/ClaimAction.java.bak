    public void prepare() throws Exception {

        if (id <= 0) {
            claim = new Claim();
        } else {
            claim = service.getClaim(id);
        }
    }

    @Override
    public String execute() throws Exception {

        if (tab > 0) {
            session.put("tabIndex", tab);
        }
        if (claim == null) {
            return "ClaimNotFound";
        } else {
            return SUCCESS;
        }
    }

