<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.Invoice" table="invoice">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="net" name="net" not-null="true"/>
    <property column="vat" name="vat" not-null="true"/>
    <property column="gross" name="gross" not-null="true"/>
    <many-to-one class="chox.model.Rental" column="rental_id" name="rental"/>
  </class>
</hibernate-mapping>
