<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.Rental" table="rental">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="uuid" name="uuid" not-null="true"/>
    <property column="supplier_reference" name="supplierReference" not-null="true"/>
    <property column="rental_status" name="rentalStatus" not-null="true"/>
    <property column="first_contact" name="firstContact" not-null="true"/>
    <property column="created" name="created" not-null="true"/>
    <many-to-one class="chox.model.Supplier" column="supplier_id" name="supplier"/>
  </class>
</hibernate-mapping>
