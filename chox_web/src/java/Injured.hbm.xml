<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.Injured" table="injured">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="uuid" name="uuid" not-null="true"/>
    <property column="name" name="name"/>
    <property column="address1" name="address1"/>
    <property column="address2" name="address2"/>
    <property column="address3" name="address3"/>
    <property column="address4" name="address4"/>
    <property column="address5" name="address5"/>
    <property column="postcode" name="postcode"/>
    <property column="telephone_day" name="telephoneDay"/>
    <property column="telephone_evening" name="telephoneEvening"/>
    <property column="email" name="email"/>
    <property column="solicitor_appointed" name="solicitorAppointed" not-null="true"/>
    <property column="solicitor_name" name="solicitorName"/>
    <property column="solicitor_address1" name="solicitorAddress1"/>
    <property column="solicitor_address2" name="solicitorAddress2"/>
    <property column="solicitor_address3" name="solicitorAddress3"/>
    <property column="solicitor_address4" name="solicitorAddress4"/>
    <property column="solicitor_address5" name="solicitorAddress5"/>
    <property column="solicitor_postcode" name="solicitorPostcode"/>
    <property column="solicitor_telephone" name="solicitorTelephone"/>
    <property column="solicitor_email" name="solicitorEmail"/>
    <many-to-one class="chox.model.Claim" column="claim_id" name="claim"/>
  </class>
</hibernate-mapping>
