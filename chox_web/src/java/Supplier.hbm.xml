<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.Supplier" table="supplier">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="name" name="name" not-null="true"/>
    <property column="address1" name="address1" not-null="true"/>
    <property column="address2" name="address2" not-null="true"/>
    <property column="address3" name="address3"/>
    <property column="address4" name="address4"/>
    <property column="address5" name="address5"/>
    <property column="postcode" name="postcode" not-null="true"/>
    <property column="vat_no" name="vatNo" not-null="true"/>
    <property column="company_no" name="companyNo" not-null="true"/>
    <many-to-one class="chox.model.Country" column="country_id" name="country"/>
  </class>
</hibernate-mapping>
