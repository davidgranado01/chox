<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.Message" table="message">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="message" name="message" not-null="true"/>
    <property column="received" name="received" not-null="true"/>
    <property column="session_id" name="sessionId"/>
    <property column="status_id" name="statusId" not-null="true"/>
  </class>
</hibernate-mapping>
