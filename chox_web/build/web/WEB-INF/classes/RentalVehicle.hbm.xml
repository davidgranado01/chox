<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.RentalVehicle" table="rental_vehicle">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="uuid" name="uuid" not-null="true"/>
    <property column="vehicle_registration" name="vehicleRegistration" not-null="true"/>
    <property column="vehicle_manufacturer" name="vehicleManufacturer" not-null="true"/>
    <property column="vehicle_model" name="vehicleModel" not-null="true"/>
    <property column="rental_start" name="rentalStart" not-null="true"/>
    <property column="rental_end" name="rentalEnd"/>
    <property column="days" name="days"/>
    <many-to-one class="chox.model.Rental" column="rental_id" name="rental"/>
    <many-to-one class="chox.model.VehicleClass" column="vehicle_class_id" name="vehicleClass"/>
  </class>
</hibernate-mapping>
