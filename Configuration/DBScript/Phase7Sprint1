--------------------------------------------------------------------------------
-- 7.1.1 - Make 'Rejection Reason' dependent on claim type                    --
--------------------------------------------------------------------------------
ALTER TABLE reason_of_rejection ADD gta_active boolean DEFAULT TRUE;
ALTER TABLE reason_of_rejection ADD insurer_vs_insurer_active boolean DEFAULT TRUE;
ALTER TABLE reason_of_rejection ADD subscriber_active boolean DEFAULT TRUE;
ALTER TABLE reason_of_rejection ADD insurer_upload_active boolean DEFAULT TRUE;
ALTER TABLE reason_of_rejection ADD tpi_active boolean DEFAULT TRUE;

UPDATE reason_of_rejection ror
SET gta_active = status,
    insurer_vs_insurer_active = status,
    subscriber_active = status,
    insurer_upload_active = status,
    tpi_active = status;

ALTER TABLE reason_of_rejection DROP COLUMN status;

ALTER TABLE reason_of_rejection_template DROP COLUMN status;

