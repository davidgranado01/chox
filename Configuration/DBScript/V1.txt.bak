ALTER TABLE web_user DROP COLUMN role_id;

CREATE TABLE web_user_user_role
(
  id serial NOT NULL,
  web_user_id integer,
  wer_user_role_id integer,
  created_by integer NOT NULL,
  created_date timestamp without time zone NOT NULL DEFAULT now(),
  last_modified_by integer NOT NULL,
  last_modified_date timestamp without time zone NOT NULL DEFAULT now(),
  is_active boolean NOT NULL DEFAULT true,
  CONSTRAINT web_user_user_role_pkey PRIMARY KEY (id),
  CONSTRAINT web_user_fkey FOREIGN KEY (web_user_id)
      REFERENCES web_user (id) MATCH SIMPLE
      ON UPDATE NO ACTION ON DELETE NO ACTION,
  CONSTRAINT web_user_role_fkey FOREIGN KEY (wer_user_role_id)
      REFERENCES web_user_role (id) MATCH SIMPLE
      ON UPDATE NO ACTION ON DELETE NO ACTION
)
WITH (OIDS=FALSE);
ALTER TABLE web_user_user_role OWNER TO postgres;


CREATE TABLE insurer_allias
(
  insurer_id integer NOT NULL,
  allias_name character varying NOT NULL,
  created_by integer NOT NULL,
  created_date timestamp without time zone NOT NULL DEFAULT now(),
  last_modified_by integer NOT NULL,
  last_modified_date timestamp without time zone NOT NULL DEFAULT now(),
  id serial NOT NULL
)
WITH (OIDS=FALSE);
ALTER TABLE insurer_allias OWNER TO postgres;

