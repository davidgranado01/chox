              <stringProp name="script">String finishedProcessing = vars.get(&quot;finishedProcessing&quot;);
String doneProcessing = props.get(&quot;processBordereauFinished_5&quot;);
//log.info(&quot;5-finishedProcessing=&quot;+finishedProcessing);
//log.info(&quot;5-doneProcessing=&quot;+doneProcessing);
Boolean finished = new Boolean(finishedProcessing);
Boolean done = new Boolean(doneProcessing);
//int number = ctx.getThread().getThreadNum();
if (finished) {
//    log.info(&quot;Finished processing in 5th Bordereau Monitor Thread Group&quot; + &quot; [&quot; + number + &quot;]&quot;);
    prev.setStopThread(true); // for Beanshell Post Processor
    props.put(&quot;processBordereauFinished_5&quot;, &quot;True&quot;);
} else if (done) {
//    log.info(&quot;Done processing in 5th Bordereau Monitor Thread Group&quot; + &quot; [&quot; + number + &quot;]&quot;);
    prev.setStopThread(true); // for Beanshell Post Processor
}
</stringProp>
