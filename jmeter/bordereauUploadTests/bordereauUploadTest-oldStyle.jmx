	String[] cells = row2.split(&quot;,&quot;);    //split row into cells using comma as delimiter
	String jsessionId = cells[0];
	String bordereauFileId = cells[1];

//	log.info(&quot;2-jsessionid  = &quot; + jsessionId);
//	log.info(&quot;2-bordereauFileId  = &quot; + bordereauFileId);
	vars.put(&quot;jsessionid&quot;, jsessionId);
	vars.put(&quot;bordereauFileId&quot;, bordereauFileId);   
} catch (Throwable ex) {
    log.error(&quot;2-Exception thrown: &quot; + ex.getMessage(), ex);
}</stringProp>
