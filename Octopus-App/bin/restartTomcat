#!/bin/bash

export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64/
export JAVA_OPTS=${JAVA_OPTS}' -Djava.util.prefs.systemRoot=/home/chox/.java -Djava.util.prefs.userRoot=/home/chox/.java/.userPrefs'
export TOMCAT_HOME=/opt/tomcat/
export CATALINA_HOME=/opt/tomcat
export CATALINA_BASE=/home/chox/tomcat/chox_9080
export LD_LIBRARY_PATH=:${CATALINA_HOME}/lib
export PATH=/bin:${JAVA_HOME}/bin:${CATALINA_HOME}/bin:${PATH}
export HTTP_PROXY=#{HTTP_PROXY}
export HTTPS_PROXY=#{HTTPS_PROXY}

echo "**************************************************************************"
echo "**       Restarting Tomcat: `date`      **"
echo "**************************************************************************"

# Define which GC to use - G1 or CMS
GC=G1

# Production config general GC flag parameters
# Set total heap, depending upon select GC mechanism
if [ "${GC}" = "CMS" ]
then
	memory=#{TOMCAT_MEM} # Total heap when using CMS garbage collector (10G for young generation - see below) leaving 1G for old generation. NB. old generation uses < 400MB so can reduce this
elif [ "${GC}" = "G1" ]
then
	memory=#{TOMCAT_MEM} # Total heap when using G1 garbage collector
else
	echo "Invalid Garbage Collection specified: mustbe either G1 or CMS";
	exit 1;
fi
ttl=5

# Standard options + Fix size of heap
CATALINA_OPTS='-XX:+UseStringDeduplication -XX:+OptimizeStringConcat -XX:+AlwaysPreTouch -Xms'${memory}' -Xmx'${memory}' -Dsun.net.inetaddr.ttl='${ttl}

# add a proxy
proxy=`echo ${HTTP_PROXY}|sed 's#http://\(.*\):\([0-9]*\).*$#\1#'`
proxyport=`echo ${HTTP_PROXY}|sed 's#http://\(.*\):\([0-9]*\).*$#\2#'`
if [ $proxy"a" != "a" ]; then
       CATALINA_OPTS="${CATALINA_OPTS} -Dhttp.proxyHost=$proxy -Dhttp.proxyPort=$proxyport -Dhttps.proxyHost=$proxy -Dhttps.proxyPort=$proxyport -Dhttp.nonProxyHosts=\"127.0.0.1|127.0.0.1:8848|127.0.0.1:8080|localhost|localhost:8080\""
fi

# Set max cache buffer size for NIO due to memory leak - see http://www.evanjones.ca/java-bytebuffer-leak.html
CATALINA_OPTS=${CATALINA_OPTS}' -Djdk.nio.maxCachedBufferSize=262144'

# Dump Heap on out-of-memory
CATALINA_OPTS=${CATALINA_OPTS}' -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/home/chox/logs/chox-heap-$(date +%Y_%m_%d-%H_%M).hprof'

# Track Native Memory use - needs UnlockDiagnosticVMOptions
CATALINA_OPTS=${CATALINA_OPTS}' -XX:NativeMemoryTracking=detail -XX:+UnlockDiagnosticVMOptions -XX:+PrintNMTStatistics'

# Add GC logging options
CATALINA_OPTS=${CATALINA_OPTS}' -Xlog:gc*:chox-gc-verbose.log:time'

# Metaspace options
#maxMetaspaceSize=#{TOMCAT_MAXMETA} # maximum size of metaspace
#metaspaceSize=#{TOMCAT_META} # initial size of metaspace
#maxMetaspaceExpansion=0 # force GC before growing metaspace size
#CATALINA_OPTS=${CATALINA_OPTS}' -XX:MaxMetaspaceSize='${maxMetaspaceSize}' -XX:MetaspaceSize='${metaspaceSize}' -XX:MaxMetaspaceExpansion='${maxMetaspaceExpansion}

# Not Used
##minMetaspaceExpansion=64m # the minumum size by which a Metaspace is exanded
##CATALINA_OPTS=${CATALINA_OPTS}' -XX:MinMetaspaceExpansion='${minMetaspaceExpansion}
#maxMetaspaceFreeRatio=100  # to reduce the chance of Metaspaces shrinking
#minMetaspaceFreeRatio=0  # to reduce the chance of Metaspaces growing
#CATALINA_OPTS=${CATALINA_OPTS}' -XX:MaxMetaspaceFreeRatio='${maxMetaspaceFreeRatio}' -XX:MinMetaspaceFreeRatio='${minMetaspaceFreeRatio}

# Add options to allow monitoring via JMX
#rmiPort=1099
#CATALINA_OPTS=${CATALINA_OPTS}' -Dcom.sun.management.jmxremote=true -Dcom.sun.management.jmxremote.port='${rmiPort}' -Dcom.sun.management.jmxremote.ssl=false -Dcom.sun.management.jmxremote.authenticate=false'

# Add options for better heap/thread dumps with JFR
#CATALINA_OPTS=${CATALINA_OPTS}' -XX:+UnlockDiagnosticVMOptions -XX:+DebugNonSafepoints'

# Use Large Page size - not tried
#CATALINA_OPTS=${CATALINA_OPTS}' -XX:+UseLargePages -XX:+UseLargePagesInMetaspace'

# Fix for JAXB memeory leak - see
#       https://issues.apache.org/jira/browse/CXF-2939
#       https://stackoverflow.com/questions/33255578/old-jaxb-and-jdk8-metaspace-outofmemory-issue
# Should not be needed - fixed in 2.2.10
#CATALINA_OPTS=${CATALINA_OPTS}' -Dcom.sun.xml.bind.v2.bytecode.ClassTailor.noOptimize=true'

if [ "${GC}" = "CMS" ]
then # Options for ConcurrentMarkSweep Garbage Collector
	cmsInitiatingOccupancyFraction=60 # perform GC when 60% of oldGen is taken, default 92
	youngSize=2g # Fix size of young generation
	CATALINA_OPTS=${CATALINA_OPTS}' -XX:+UseConcMarkSweepGC -XX:CMSInitiatingOccupancyFraction='${cmsInitiatingOccupancyFraction}' -Xmn'${youngSize}' -XX:+ScavengeBeforeFullGC -XX:+CMSScavengeBeforeRemark -XX:+CMSParallelRemarkEnabled -XX:+UseCMSInitiatingOccupancyOnly'
elif [ "${GC}" = "G1" ] # options for G1 Garbage Collector
then
	maxPause=200 # Sets a target value for desired maximum pause time. Default 200
	reservePercent=10 # Sets the percentage of reserve memory to keep free so as to reduce the risk of to-space overflows. Default 10
	CATALINA_OPTS=${CATALINA_OPTS}' -XX:+UseG1GC -XX:+UseStringDeduplication -XX:MaxGCPauseMillis='${maxPause}' -XX:G1ReservePercent='${reservePercent}
	# Tune parallel GC
#	parallelGCThread=16
#	concGCThreads=4
#	CATALINA_OPTS=${CATALINA_OPTS}' -XX:ParallelGCThreads='${parallelGCThread}' -XX:ConcGCThreads='${concGCThreads}
	# Experimental Options
#	maxNewSizePercent=80 # Sets the percentage of the heap size to use as the maximum for young generation size. Default is 60 (need to unlock experimental VM options)
#	CATALINA_OPTS=${CATALINA_OPTS}' -XX:+UnlockExperimentalVMOptions -XX:G1MaxNewSizePercent='${maxNewSizePercent}
#	newSizePercent=50 # Sets the percentage of the heap to use as the minimum for the young generation size. Default is 5 (need to unlock experimental VM options)
#	CATALINA_OPTS=${CATALINA_OPTS}' -XX:+UnlockExperimentalVMOptions -XX:G1NewSizePercent='${newSizePercent}
	# Set G1 Region size to allow for humungous allocation
	heapRegionSize=16M
	CATALINA_OPTS=${CATALINA_OPTS}' -XX:G1HeapRegionSize='${heapRegionSize}
	fi

export CATALINA_OPTS

prog=tomcat


if [ `ps auxww|grep $prog|grep chox|grep -v grep|wc -l` -gt 0 ]
then
	echo 'Stopping tomcat...'
	${CATALINA_HOME}/bin/shutdown.sh 60
	/bin/sleep 3
	echo 'Done.'
fi

if [ `ps auxww|grep $prog|grep chox|grep -v grep|wc -l` -gt 0 ]
then
	echo 'Forcibly stopping tomcat...'
	${CATALINA_HOME}/bin/shutdown.sh 30 -force
	/bin/sleep 3
	echo 'Done.'
fi

if [ `ps auxww|grep $prog|grep chox|grep -v grep|wc -l` -gt 0 ]
then
	echo 'Tomcat still running...killing...'
	for pid in `ps auxwww|grep $prog|grep chox|grep -v grep|tr -s ' '|cut -d ' ' -f2`
	do
		/bin/kill -9 ${pid} 2>&1 > /dev/null
		echo "Killed tomcat with pid ${pid}"
		/bin/sleep 5
	done
fi

if [ `ps auxww|grep $prog|grep chox|grep -v grep|wc -l` -gt 0 ]
then
	echo 'Tomcat still running - aborting.'
	exit 1
fi

/bin/rm -rf ${CATALINA_BASE}/work/Catalina/localhost/*

#if [ -e "${CATALINA_BASE}/logs/tomcat.log" ]
#then
#mv ${CATALINA_BASE}/logs/tomcat.log ${CATALINA_BASE}/logs/old/tomcat-`date +"%F"`.log
#fi

if [ -e "${CATALINA_BASE}/logs/catalina.out" ]
then
	mv ${CATALINA_BASE}/logs/catalina.out ${CATALINA_BASE}/logs/old/catalina-`date +"%Y%m%d_%H%M%S"`.out
fi

echo 'Starting tomcat....'
echo 'CATALINA_OPTS='${CATALINA_OPTS}
${CATALINA_HOME}/bin/startup.sh
echo 'Done.'
echo "**************************************************************************"

exit 0

