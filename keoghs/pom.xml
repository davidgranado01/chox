<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>idas</groupId>
        <artifactId>chox</artifactId>
        <version>2.0</version>
    </parent>
    <groupId>idas.chox</groupId>
    <artifactId>keoghs</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <build>
        <resources>
            <resource>
                <targetPath>.</targetPath>
                <directory>src/main/resources</directory>
                <includes>
                    <include>jax-ws-catalog.xml</include>
                    <include>wsdl/**</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>2.3.2</version>
                <configuration>
                    <source>1.7</source>
                    <target>1.7</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <compilerArgs>
                        <arg>-XDignore.symbol.file</arg>
                    </compilerArgs>
                    <fork>true</fork>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>2.4.3</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
<!--            <plugin>
                <groupId>org.apache.cxf</groupId>
                <artifactId>cxf-codegen-plugin</artifactId>
                <version>2.5.11</version>
                <executions>
                    <execution>
                        <id>choxws-generate-sources</id>
                        <phase>generate-sources</phase>
                        <configuration>
                            <sourceRoot>${project.build.directory}/generated-sources/wsdl2java</sourceRoot>
                            <wsdlOptions>
                                <wsdlOption>
                                    <wsdl>${basedir}/src/main/resources/wsdl/ADAPublicServices.wsdl</wsdl>
                                    <extraargs>
                                        <extraarg>-verbose</extraarg>
                                        <extraarg>-b</extraarg>
                                        <extraarg>${basedir}/src/main/resources/wsdl/javabindings.xml</extraarg>
                                    </extraargs>                                     
                                </wsdlOption>
                            </wsdlOptions>
                        </configuration>
                        <goals>
                            <goal>wsdl2java</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>-->
            <plugin>
                <groupId>org.jvnet.jax-ws-commons</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>2.3</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <arguments>-extension</arguments> 
                            <wsdlFiles>
                                <wsdlFile>ADAPublicServices.wsdl</wsdlFile>
                                <wsdlFile>ADAPublicServicesDebug.wsdl</wsdlFile>
                            </wsdlFiles>
                            <wsdlDirectory>src/main/resources/wsdl</wsdlDirectory>
                            <bindingDirectory>src/main/resources/wsdl</bindingDirectory>
                            <bindingFiles>
                                <bindingFile>javabindings.xml</bindingFile>
                            </bindingFiles>
                            <packageName>com.keoghs.ADAPublicServices</packageName>
                            <wsdlUrls>
                                <wsdlUrl>https://ada-uat-ws.keoghs.co.uk/ADAWebServicesV1/ADAPublicServices.svc?singleWsdl</wsdlUrl>
<!--                                <wsdlUrl>https://ada-uat-ws.keoghs.co.uk/ADAWebServicesV1/ADAPublicServicesDebug.svc?singleWsdl</wsdlUrl>
                                <wsdlUrl>https://ada-ws.keoghs.co.uk/ADAWebServicesV1/ADAPublicServices.svc?singleWsdl</wsdlUrl> -->
                            </wsdlUrls> 
<!--                            <wsdlLocation>file:${project.build.directory}/src/main/resources/wsdl/ADAPublicServices.wsdl</wsdlLocation>-->
                            <wsdlLocation>https://ada-uat-ws.keoghs.co.uk/ADAWebServicesV1/ADAPublicServices.svc?singleWsdl</wsdlLocation> 
<!--                            <wsdlLocation>https://ada-uat-ws.keoghs.co.uk/ADAWebServicesV1/ADAPublicServicesDebug.svc?singleWsdl</wsdlLocation> -->
<!--                            <wsdlLocation>https://ada-ws.keoghs.co.uk/ADAWebServicesV1/ADAPublicServices.svc?singleWsdl</wsdlLocation> -->
                            <staleFile>${project.build.directory}/jaxws/stale/ADAPublicServices.stale</staleFile>
                        </configuration>
                        <id>wsimport-generate-ADAPublicServices</id>
                        <phase>generate-sources</phase>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>javax.xml</groupId>
                        <artifactId>webservices-api</artifactId>
                        <version>2.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <sourceDestDir>${project.build.directory}/generated-sources/jaxws-wsimport</sourceDestDir>
                    <xnocompile>true</xnocompile>
                    <verbose>true</verbose>
                    <extension>true</extension>
                    <catalog>${basedir}/src/jax-ws-catalog.xml</catalog>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>idas.chox</groupId>
            <artifactId>core</artifactId>
            <version>${chox.core.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>webservices-rt</artifactId>
            <version>1.6.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>