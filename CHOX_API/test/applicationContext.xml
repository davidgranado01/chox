<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN" "http://www.springframework.org/dtd/spring-beans.dtd">
<beans default-autowire="autodetect">
    <bean id="securityInfoProvider" class="chox.data.FakeSecurityInfoProvider" singleton="false"/>
    <bean id="auditInterceptor" class="chox.data.DBInterceptor" singleton="false">
        <property name="securityInfoProvider" ref="securityInfoProvider"/>
    </bean>

    <bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource">
        <property name="driverClassName" value="org.h2.Driver">
        </property>
        <property name="url" value="jdbc:h2:mem:test">
        </property>
        <property name="username" value="sa">
        </property>
        <property name="password" value="">
        </property>
    </bean>
    <bean id="sessionFactory" class="org.springframework.orm.hibernate3.LocalSessionFactoryBean">
        <property name="dataSource">
            <ref bean="dataSource" />
        </property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.dialect">org.hibernate.dialect.H2Dialect
                </prop>
                <prop key="hibernate.show_sql">true
                </prop>
                <prop key="hibernate.cache.provider_class">org.hibernate.cache.EhCacheProvider</prop>
                <prop key="hibernate.cache.use_query_cache">true</prop>
                <prop key="hibernate.hbm2ddl.auto">create</prop>
            </props>
        </property>
        <property name="mappingResources">
            <list>
                <value>chox/model/GlobalConfiguration.hbm.xml</value>
                <value>chox/model/History.hbm.xml</value>
                <value>chox/model/WebUser.hbm.xml</value>
                <value>chox/model/WebUserRole.hbm.xml</value>
                <value>chox/model/ChoBandOrganisation.hbm.xml</value>
                <value>chox/model/Chorganisation.hbm.xml</value>
                <value>chox/model/Claim.hbm.xml</value>
                <value>chox/model/Customer.hbm.xml</value>
                <value>chox/model/EngineerReport.hbm.xml</value>
                <value>chox/model/HireMonitoringDetail.hbm.xml</value>
                <value>chox/model/Incident.hbm.xml</value>
                <value>chox/model/Injury.hbm.xml</value>
                <value>chox/model/Insurer.hbm.xml</value>
                <value>chox/model/Invoice.hbm.xml</value>
                <value>chox/model/LineOfBusiness.hbm.xml</value>
                <value>chox/model/Solicitor.hbm.xml</value>
                <value>chox/model/ThirdParty.hbm.xml</value>
                <value>chox/model/VehicleClass.hbm.xml</value>
                <value>chox/model/VehicleHire.hbm.xml</value>
                <value>chox/model/Witness.hbm.xml</value>
                <value>chox/model/ChoBand.hbm.xml</value>
                <value>chox/model/InsurerAllias.hbm.xml</value>
                <value>chox/model/Accessibility.hbm.xml</value>
                <value>chox/model/AccessibilityItem.hbm.xml</value>
                <value>chox/model/Comment.hbm.xml</value>
                <value>chox/model/Attachment.hbm.xml</value>
                <value>chox/model/HireMonitoringEcd.hbm.xml</value>
                <value>chox/model/AuditTrail.hbm.xml</value>
                <value>chox/model/ReasonOfRejection.hbm.xml</value>
                <value>chox/model/SupportMessage.hbm.xml</value>
                <value>chox/model/SystemLog.hbm.xml</value>
                <value>chox/model/WebUserUserRole.hbm.xml</value>
                <value>chox/model/InsurerChorganisation.hbm.xml</value>
                <value>chox/model/ReasonOfDelay.hbm.xml</value>
                <value>chox/model/AttachmentType.hbm.xml</value>
                <value>chox/model/Bordereau.hbm.xml</value>
                <value>chox/model/Workgroup.hbm.xml</value>
                <value>chox/model/UserWorkgroup.hbm.xml</value>
                <value>chox/model/Notification.hbm.xml</value>
                <value>chox/model/VehicleClassCeiling.hbm.xml</value>
            </list>
        </property>
        <property name="entityInterceptor" ref="auditInterceptor"/>
    </bean>
        <!-- Transaction manager for a single Hibernate SessionFactory (alternative to JTA) -->
    <bean id="transactionManager" class="org.springframework.orm.hibernate3.HibernateTransactionManager">
        <property name="sessionFactory" ref="sessionFactory"/>
    </bean>   
</beans>
