<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.RentalPaymentRequest" table="rental_payment_request">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="uuid" column="uuid" not-null="true" />
    <property name="insurerCountryId" column="insurer_country_id" not-null="true" />
    <property name="invoiceType" column="invoice_type" not-null="true" />
    <property name="netAmount" column="net_amount" not-null="true" />
    <property name="vatAmount" column="vat_amount" not-null="true" />
    <property name="grossAmount" column="gross_amount" not-null="true" />
    <property name="updated" column="updated" not-null="true" />
    <property name="ackSessionId" column="ack_session_id" />
    <property name="ackDate" column="ack_date" />
    <many-to-one name="rental" class="chox.model.Rental" column="rental_id" />
    <many-to-one name="supplier" class="chox.model.Supplier" column="supplier_id" />
  </class>
</hibernate-mapping>

