<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.Chobandoperative" table="cho_band_operative">
    <composite-id>
      <key-property name="id" column="id" />
      <key-property name="bandId" column="band_id" />
      <key-property name="chorganisationId" column="chorganisation_id" />
    </composite-id>
    <property name="createdBy" column="created_by" not-null="true" />
    <property name="createdDate" column="created_date" not-null="true" />
    <property name="lastModifiedBy" column="last_modified_by" not-null="true" />
    <property name="lastModifiedDate" column="last_modified_date" not-null="true" />
  </class>
</hibernate-mapping>

