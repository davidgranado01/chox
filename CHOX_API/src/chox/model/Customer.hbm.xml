<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.Customer" table="Customer">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="title" column="title" not-null="true" />
    <property name="firstnames" column="firstnames" not-null="true" />
    <property name="lastname" column="lastname" not-null="true" />
    <property name="address1" column="address1" />
    <property name="address2" column="address2" />
    <property name="address3" column="address3" />
    <property name="address4" column="address4" />
    <property name="address5" column="address5" />
    <property name="postcode" column="postcode" />
    <property name="telephoneDay" column="telephoneDay" />
    <property name="telephoneEvening" column="telephoneEvening" />
    <property name="email" column="email" />
    <property name="vehicleRegistration" column="vehicleRegistration" not-null="true" />
    <property name="vehicleManufacturer" column="vehicleManufacturer" not-null="true" />
    <property name="vehicleModel" column="vehicleModel" not-null="true" />
    <property name="location" column="location" />
    <property name="damage" column="damage" />
    <property name="initialEcd" column="initialEcd" not-null="true" />
    <property name="name" column="name" />
    <property name="policyNumber" column="policyNumber" />
    <property name="claimReference" column="claimReference" />
    <property name="comprehensive" column="comprehensive" />
    <property name="createdBy" column="createdBy" />
    <property name="createdDate" column="createdDate" />
    <property name="lastModifiedBy" column="lastModifiedBy" />
    <property name="lastModifiedDate" column="lastModifiedDate" />
    <property name="isPrimaryDriver" column="isPrimaryDriver" not-null="true" />
    <property name="isUsable" column="isUsable" not-null="true" />
    <property name="isActive" column="isActive" not-null="true" />
    <many-to-one name="vehicleClass" class="chox.model.VehicleClass" column="vehicleClassId" />
  </class>
</hibernate-mapping>

