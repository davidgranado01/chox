<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.Customer" table="customer">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="title" column="title" not-null="true" />
    <property name="firstName" column="first_name" not-null="true" />
    <property name="lastName" column="last_name" not-null="true" />
    <property name="address1" column="address1" />
    <property name="address2" column="address2" />
    <property name="address3" column="address3" />
    <property name="address4" column="address4" />
    <property name="address5" column="address5" />
    <property name="postcode" column="postcode" />
    <property name="telephoneDay" column="telephone_day" />
    <property name="telephoneEvening" column="telephone_evening" />
    <property name="email" column="email" />
    <property name="vehicleRegistration" column="vehicle_registration" not-null="true" />
    <property name="vehicleManufacturer" column="vehicle_manufacturer" not-null="true" />
    <property name="vehicleModel" column="vehicle_model" not-null="true" />
    <property name="location" column="location" />
    <property name="damage" column="damage" />
    <property name="initialEcd" column="initial_ecd" not-null="true" />
    <property name="policyNumber" column="policy_number" />
    <property name="claimReference" column="claim_reference" />
    <property name="createdBy" column="created_by" not-null="true" />
    <property name="createdDate" column="created_date" not-null="true" />
    <property name="lastModifiedBy" column="last_modified_by" not-null="true" />
    <property name="lastModifiedDate" column="last_modified_date" not-null="true" />
    <property name="isPrimaryDriver" column="is_primary_driver" not-null="true" />
    <property name="isUsable" column="is_usable" not-null="true" />
    <property name="isActive" column="is_active" not-null="true" />
    <property name="comprehensive" column="comprehensive" not-null="true" />
    <property name="insurerId" column="insurer_id" not-null="true" />
    <many-to-one name="vehicleClass" class="chox.model.VehicleClass" column="vehicle_class_id" />
  </class>
</hibernate-mapping>

