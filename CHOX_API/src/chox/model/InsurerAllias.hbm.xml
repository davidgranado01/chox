<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class lazy="false" name="chox.model.InsurerAllias" table="insurer_allias">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="allias_name" name="alliasName"/>
    <many-to-one class="chox.model.WebUser" column="created_by" name="createdBy" not-null="true"/>
    <property column="created_date" name="createdDate" not-null="true"/>
    <many-to-one class="chox.model.WebUser" column="last_modified_by" name="lastModifiedBy" not-null="true"/>
    <property column="last_modified_date" name="lastModifiedDate" not-null="true"/>
    <many-to-one class="chox.model.Insurer" column="insurer_id" lazy="false" name="insurer"/>
  </class>
</hibernate-mapping>
