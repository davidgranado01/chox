<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.HandlingFee" table="handling_fee">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="netFee" column="net_fee" not-null="true" />
    <property name="feeVat" column="fee_vat" not-null="true" />
    <property name="grossFee" column="gross_fee" not-null="true" />
    <many-to-one name="rental" class="chox.model.Rental" column="rental_id" />
  </class>
</hibernate-mapping>

