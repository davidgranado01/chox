<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.Message" table="message">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="message" column="message" not-null="true" />
    <property name="received" column="received" not-null="true" />
    <property name="sessionId" column="session_id" />
    <property name="statusId" column="status_id" not-null="true" />
  </class>
</hibernate-mapping>

