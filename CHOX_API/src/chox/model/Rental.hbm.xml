<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="chox.model.Rental" table="rental">
        <id name="id" column="id">
            <generator class="increment" />
        </id>
        <property name="uuid" column="uuid" not-null="true" />
        <property name="supplierReference" column="supplier_reference" not-null="true" />
        <property name="rentalStatus" column="rental_status" not-null="true" />
        <property name="firstContact" column="first_contact" not-null="true" />
        <property name="created" column="created" not-null="true" />
        <many-to-one name="supplier" class="chox.model.Supplier" column="supplier_id" />
    </class>
</hibernate-mapping>

