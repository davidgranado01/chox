<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.RentalVehicle" table="rental_vehicle">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="uuid" column="uuid" not-null="true" />
    <property name="vehicleRegistration" column="vehicle_registration" not-null="true" />
    <property name="vehicleManufacturer" column="vehicle_manufacturer" not-null="true" />
    <property name="vehicleModel" column="vehicle_model" not-null="true" />
    <property name="vehicleClassId" column="vehicle_class_id" not-null="true" />
    <property name="rentalStart" column="rental_start" not-null="true" />
    <property name="rentalEnd" column="rental_end" />
    <property name="days" column="days" />
    <many-to-one name="rental" class="chox.model.Rental" column="rental_id" />
  </class>
</hibernate-mapping>

