    <property name="adminFee" column="adminFee" />
    <property name="adminQty" column="adminQty" />
    <property name="roofRackFee" column="roofRackFee" />
    <property name="roofRackQty" column="roofRackQty" />
    <property name="dualControlFee" column="dualControlFee" />
    <property name="dualControlQty" column="dualControlQty" />
    <property name="deliveryCollectionFee" column="deliveryCollectionFee" />
    <property name="deliveryCollectionQty" column="deliveryCollectionQty" />
    <property name="createdBy" column="createdBy" />
    <property name="createdDate" column="createdDate" />
    <property name="lastModifiedBy" column="lastModifiedBy" />
    <property name="lastModifiedDate" column="lastModifiedDate" />
  </class>
</hibernate-mapping>

