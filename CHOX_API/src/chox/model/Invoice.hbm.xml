    <property name="engineerFeeGross" column="engineerFeeGross" not-null="true" />
    <property name="storageRecoveryNet" column="storageRecoveryNet" not-null="true" />
    <property name="storageRecoveryVat" column="storageRecoveryVat" not-null="true" />
    <property name="storageRecoveryGross" column="storageRecoveryGross" not-null="true" />
    <property name="totalNet" column="totalNet" not-null="true" />
    <property name="totalVat" column="totalVat" not-null="true" />
    <property name="totalGross" column="totalGross" not-null="true" />
    <property name="claimsHandlingInvoiceAmount" column="claimsHandlingInvoiceAmount" not-null="true" />
    <property name="deductionForClaimsHandlingFee" column="deductionForClaimsHandlingFee" not-null="true" />
    <property name="discount" column="discount" not-null="true" />
    <property name="totaltoPay" column="totaltoPay" not-null="true" />
    <property name="handlingInvoiceNo" column="handlingInvoiceNo" />
    <property name="claimInvoiceNo" column="claimInvoiceNo" />
    <property name="cdwFee" column="cdwFee" />
    <property name="cdwQty" column="cdwQty" />
    <property name="automaticFee" column="automaticFee" />
    <property name="automaticQty" column="automaticQty" />
    <property name="satNavFee" column="satNavFee" />
    <property name="satNavQty" column="satNavQty" />
