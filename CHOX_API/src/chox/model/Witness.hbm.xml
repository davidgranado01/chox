<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.Witness" table="witness">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="name" name="name"/>
    <property column="address1" name="address1"/>
    <property column="address2" name="address2"/>
    <property column="address3" name="address3"/>
    <property column="address4" name="address4"/>
    <property column="address5" name="address5"/>
    <property column="postcode" name="postcode"/>
    <property column="telephone_day" name="telephoneDay"/>
    <property column="telephone_evening" name="telephoneEvening"/>
    <property column="email" name="email"/>
    <many-to-one class="chox.model.WebUser" column="created_by" name="createdBy"/>
    <property column="created_date" name="createdDate"/>
    <many-to-one class="chox.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <many-to-one class="chox.model.Incident" column="incident_id" name="incident"/>
  </class>
</hibernate-mapping>
