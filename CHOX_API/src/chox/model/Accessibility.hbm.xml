<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.Accessibility" table="accessibility">
    <cache usage="read-write"/>
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="name" name="name" not-null="true"/>
    <set name="AccessibilityItem" lazy="extra">
      <key column="accessibility_id"/>
      <one-to-many class="chox.model.AccessibilityItem"/>
    </set>
    <set name="AccessibilityEditable" lazy="extra">
      <key column="accessibility_id"/>
      <one-to-many class="chox.model.AccessibilityEditable"/>
    </set>
  </class>
</hibernate-mapping>