<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.hibernate.Claim" table="Claim">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="managingRepair" column="managingRepair" />
    <property name="policyHolderContactDate" column="policyHolderContactDate" />
    <property name="choReference" column="choReference" />
    <property name="status" column="status" not-null="true" />
    <property name="incidentId" column="incidentId" not-null="true" />
    <property name="createdBy" column="createdBy" />
    <property name="createdDate" column="createdDate" />
    <property name="lastModifiedBy" column="lastModifiedBy" />
    <property name="lastModifiedDate" column="lastModifiedDate" />
    <many-to-one name="chorganisation" class="chox.model.hibernate.Chorganisation" column="cHOrganisationId" />
    <many-to-one name="customer" class="chox.model.hibernate.Customer" column="customerId" />
    <many-to-one name="engineerReport" class="chox.model.hibernate.EngineerReport" column="engineerReportId" />
    <many-to-one name="incident" class="chox.model.hibernate.Incident" column="engineerReportId" />
    <many-to-one name="insurer" class="chox.model.hibernate.Insurer" column="insurerId" />
    <many-to-one name="invoice" class="chox.model.hibernate.Invoice" column="invoiceId" />
    <many-to-one name="lineOfBusiness" class="chox.model.hibernate.LineOfBusiness" column="lineOfBusinessId" />
    <many-to-one name="thirdParty" class="chox.model.hibernate.ThirdParty" column="thirdPartyId" />
    <many-to-one name="vehicleHire" class="chox.model.hibernate.VehicleHire" column="vehicleHireId" />
  </class>
</hibernate-mapping>

