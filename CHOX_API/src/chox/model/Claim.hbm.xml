<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class lazy="false" name="chox.model.Claim" table="claim">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="managing_repair" name="managingRepair" not-null="true"/>
    <property column="policy_holder_contact_date" name="policyHolderContactDate"/>
    <property column="cho_reference" name="choReference"/>
    <property column="status" name="status" not-null="true"/>
    <property column="created_by" name="createdBy" not-null="true"/>
    <property column="created_date" name="createdDate" not-null="true"/>
    <property column="last_modified_by" name="lastModifiedBy" not-null="true"/>
    <property column="last_modified_date" name="lastModifiedDate" not-null="true"/>
    <property column="claim_number" name="claimNumber"/>
    <property column="gta_notice_date" name="gtaNoticeDate"/>
    <property column="credit_agreement_date" name="creditAgreementDate"/>
    <property column="indeminty_amount" name="indemintyAmount"/>
    <property column="percentage_liability_accepted" name="percentageLiabilityAccepted"/>
    <property column="is_quantum_dispute" name="isQuantumDispute"/>
    <property column="engineer_claim_review_notes" name="engineerClaimReviewNotes"/>
    <property column="is_invoice_review_required" name="isInvoiceReviewRequired"/>
    <many-to-one class="chox.model.Chorganisation" column="chorganisation_id" lazy="false" name="chorganisation"/>
    <many-to-one class="chox.model.Customer" column="customer_id" lazy="false" name="customer"/>
    <many-to-one class="chox.model.EngineerReport" column="engineer_report_id" lazy="false" name="engineerReport"/>
    <many-to-one class="chox.model.HireMonitoringDetail" column="hire_monitoring_detail_id" lazy="false" name="hireMonitoringDetail"/>
    <many-to-one class="chox.model.Incident" column="incident_id" lazy="false" name="incident"/>
    <many-to-one class="chox.model.Insurer" column="insurer_id" lazy="false" name="insurer"/>
    <many-to-one class="chox.model.Invoice" column="invoice_id" lazy="false" name="invoice"/>
    <many-to-one class="chox.model.LineOfBusiness" column="line_of_business_id" lazy="false" name="lineOfBusiness"/>
    <many-to-one class="chox.model.ThirdParty" column="third_party_id" lazy="false" name="thirdParty"/>
    <many-to-one class="chox.model.VehicleHire" column="vehicle_hire_id" lazy="false" name="vehicleHire"/>
    <filter condition=":chorganisationId = chorganisation_id" name="Claim_CHOFilter"/>
    <filter condition=":insurerId = insurer_id" name="Claim_InsurerFilter"/>
  </class>
  <filter-def name="Claim_CHOFilter">
    <filter-param name="chorganisationId" type="integer"/>
  </filter-def>
  <filter-def name="Claim_InsurerFilter">
    <filter-param name="insurerId" type="integer"/>
  </filter-def>
</hibernate-mapping>
