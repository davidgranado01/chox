<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.Claim" table="claim" lazy="false">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="managing_repair" name="managingRepair" not-null="true"/>
    <property column="policy_holder_contact_date" name="policyHolderContactDate"/>
    <property column="cho_reference" name="choReference"/>
    <property column="status" name="status" not-null="true"/>
    <property column="created_by" name="createdBy" not-null="true"/>
    <property column="created_date" name="createdDate" not-null="true"/>
    <property column="last_modified_by" name="lastModifiedBy" not-null="true"/>
    <property column="last_modified_date" name="lastModifiedDate" not-null="true"/>
    <many-to-one class="chox.model.Chorganisation" column="chorganisation_id" name="chorganisation" lazy="false"/>
    <many-to-one class="chox.model.Customer" column="customer_id" name="customer" lazy="false"/>
    <many-to-one class="chox.model.EngineerReport" column="engineer_report_id" name="engineerReport" lazy="false"/>
    <many-to-one class="chox.model.HireMonitoringDetail" column="hire_monitoring_detail_id" name="hireMonitoringDetail" lazy="false"/>
    <many-to-one class="chox.model.Incident" column="incident_id" name="incident" lazy="false"/>
    <many-to-one class="chox.model.Insurer" column="insurer_id" name="insurer" lazy="false"/>
    <many-to-one class="chox.model.Invoice" column="invoice_id" name="invoice" lazy="false"/>
    <many-to-one class="chox.model.LineOfBusiness" column="line_of_business_id" name="lineOfBusiness" lazy="false"/>
    <many-to-one class="chox.model.ThirdParty" column="third_party_id" name="thirdParty" lazy="false"/>
    <many-to-one class="chox.model.VehicleHire" column="vehicle_hire_id" name="vehicleHire" lazy="false"/>
    <filter condition=":chorganisationId = chorganisation_id" name="Claim_CHOFilter"/>
    <filter condition=":insurerId = insurer_id" name="Claim_InsurerFilter"/>
  </class>
  <filter-def name="Claim_CHOFilter">
    <filter-param name="chorganisationId" type="integer"/>
  </filter-def>
  <filter-def name="Claim_InsurerFilter">
    <filter-param name="insurerId" type="integer"/>
  </filter-def>
</hibernate-mapping>
