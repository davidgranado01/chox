<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.RepairCost" table="repair_cost">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="netRepair" column="net_repair" not-null="true" />
    <property name="repairVat" column="repair_vat" not-null="true" />
    <property name="grossRepair" column="gross_repair" not-null="true" />
    <many-to-one name="claim" class="chox.model.Claim" column="claim_id" />
  </class>
</hibernate-mapping>

