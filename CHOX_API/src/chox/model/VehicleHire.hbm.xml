<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.VehicleHire" table="VehicleHire">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="vehicleRegistration" column="vehicleRegistration" not-null="true" />
    <property name="vehicleManufacturer" column="vehicleManufacturer" not-null="true" />
    <property name="vehicleModel" column="vehicleModel" not-null="true" />
    <property name="rentalStart" column="rentalStart" not-null="true" />
    <property name="rentalEnd" column="rentalEnd" />
    <property name="collectionReason" column="collectionReason" not-null="true" />
    <property name="days" column="days" />
    <property name="cdwFee" column="cdwFee" not-null="true" />
    <property name="automaticFee" column="automaticFee" not-null="true" />
    <property name="satNavFee" column="satNavFee" not-null="true" />
    <property name="estateFee" column="estateFee" not-null="true" />
    <property name="babySeatFee" column="babySeatFee" not-null="true" />
    <property name="towBarsFee" column="towBarsFee" not-null="true" />
    <property name="nonStandardInsurancePremiumFee" column="nonStandardInsurancePremiumFee" not-null="true" />
    <property name="adminFee" column="adminFee" not-null="true" />
    <property name="roofRackFee" column="roofRackFee" not-null="true" />
    <property name="dualControlFee" column="dualControlFee" not-null="true" />
    <property name="deliveryCollectionFee" column="deliveryCollectionFee" not-null="true" />
    <property name="createdBy" column="createdBy" not-null="true" />
    <property name="createdDate" column="createdDate" not-null="true" />
    <property name="lastModifiedBy" column="lastModifiedBy" not-null="true" />
    <property name="lastModifiedDate" column="lastModifiedDate" not-null="true" />
    <many-to-one name="vehicleClass" class="chox.model.VehicleClass" column="vehicleClassId" />
  </class>
</hibernate-mapping>

