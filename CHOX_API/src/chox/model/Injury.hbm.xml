<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.Injury" table="Injury">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="name" column="name" />
    <property name="address1" column="address1" />
    <property name="address2" column="address2" />
    <property name="address3" column="address3" />
    <property name="address4" column="address4" />
    <property name="address5" column="address5" />
    <property name="postcode" column="postcode" />
    <property name="telephoneDay" column="telephoneDay" />
    <property name="telephoneEvening" column="telephoneEvening" />
    <property name="email" column="email" />
    <property name="createdBy" column="createdBy" />
    <property name="createdDate" column="createdDate" />
    <property name="lastModifiedBy" column="lastModifiedBy" />
    <property name="lastModifiedDate" column="lastModifiedDate" />
    <many-to-one name="chorganisation" class="chox.model.Chorganisation" column="incidentId" />
  </class>
</hibernate-mapping>

