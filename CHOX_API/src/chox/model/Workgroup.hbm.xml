<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.Workgroup" table="workgroup">
    <cache usage="read-write"/>
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="name" name="name" not-null="true"/>
    <many-to-one class="chox.model.Insurer" column="insurer_id" name="insurer" not-null="true"/>
    <property column="status" name="status" not-null="true"/>
    <many-to-one class="chox.model.WebUser" column="created_by" name="createdBy"/>
    <property column="created_date" name="createdDate"/>
    <many-to-one class="chox.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <filter condition=":insurerId = insurer_id" name="Workgroup_InsurerFilter"/>
    <filter condition=":workgroupId = id" name="Workgroup_WorkgroupFilter"/>
  </class>
  <filter-def name="Workgroup_InsurerFilter">
    <filter-param name="insurerId" type="integer"/>
  </filter-def>
  <filter-def name="Workgroup_WorkgroupFilter">
    <filter-param name="workgroupId" type="integer"/>
  </filter-def>
</hibernate-mapping>
