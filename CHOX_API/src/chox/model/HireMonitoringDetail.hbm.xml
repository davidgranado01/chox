<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.HireMonitoringDetail" table="HireMonitoringDetail">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="createdBy" column="createdBy" />
    <property name="createdDate" column="createdDate" />
    <property name="lastModifiedBy" column="lastModifiedBy" />
    <property name="lastModifiedDate" column="lastModifiedDate" />
    <property name="nameOfRepairer" column="nameOfRepairer" />
    <property name="repairBookInDate" column="repairBookInDate" />
    <property name="inspectionBookedDate" column="inspectionBookedDate" />
    <property name="inspectionDate" column="inspectionDate" />
    <property name="nameOfIME" column="nameOfIME" />
    <property name="repairCompletionDate" column="repairCompletionDate" />
    <property name="totalLossInspectionReport" column="totalLossInspectionReport" />
    <property name="isTotalLostCheck" column="isTotalLostCheck" not-null="true" />
  </class>
</hibernate-mapping>

