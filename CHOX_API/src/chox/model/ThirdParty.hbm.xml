<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.ThirdParty" table="ThirdParty">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="policyNumber" column="policyNumber" />
    <property name="claimReference" column="claimReference" />
    <property name="vehicleRegistration" column="vehicleRegistration" />
    <property name="vehicleManufacturer" column="vehicleManufacturer" />
    <property name="vehicleModel" column="vehicleModel" />
    <property name="firstNames" column="firstNames" />
    <property name="address1" column="address1" />
    <property name="address2" column="address2" />
    <property name="address3" column="address3" />
    <property name="address4" column="address4" />
    <property name="address5" column="address5" />
    <property name="postcode" column="postcode" />
    <property name="telephoneDay" column="telephoneDay" />
    <property name="telephoneEvening" column="telephoneEvening" />
    <property name="email" column="email" />
    <property name="createdBy" column="createdBy" not-null="true" />
    <property name="createdDate" column="createdDate" not-null="true" />
    <property name="lastModifiedBy" column="lastModifiedBy" not-null="true" />
    <property name="lastModifiedDate" column="lastModifiedDate" not-null="true" />
    <property name="lastName" column="lastName" />
    <property name="title" column="title" />
    <many-to-one name="insurer" class="chox.model;.hibernate.Insurer" column="insurerId" />
    <many-to-one name="vehicleClass" class="chox.model;.hibernate.VehicleClass" column="vehicleClassId" />
  </class>
</hibernate-mapping>

