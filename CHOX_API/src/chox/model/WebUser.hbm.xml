<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="chox.model.WebUser" table="web_user">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="email" name="email" not-null="true"/>
    <property column="first_name" name="firstName" not-null="true"/>
    <property column="last_name" name="lastName" not-null="true"/>
    <property column="password" name="password" not-null="true"/>
    <property column="status" name="status" not-null="true"/>
    <many-to-one class="chox.model.WebUser" column="created_by" name="createdBy"/>
    <property column="created_date" name="createdDate"/>
    <many-to-one class="chox.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <many-to-one class="chox.model.Chorganisation" column="chorganisation_id" lazy="false" name="chorganisation"/>
    <many-to-one class="chox.model.Insurer" column="insurer_id" lazy="false" name="insurer"/>
    <set cascade="all" lazy="false" name="roles" table="web_user_user_role">
      <key column="web_user_id"/>
      <many-to-many class="chox.model.WebUserRole" column="wer_user_role_id"/>
    </set>
  </class>
</hibernate-mapping>
