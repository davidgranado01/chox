<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="chox.model.RentalRate" table="rental_rate">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="insurerCountryId" column="insurer_country_id" not-null="true" />
    <property name="vehicleClassId" column="vehicle_class_id" not-null="true" />
    <property name="cost" column="cost" not-null="true" />
    <many-to-one name="supplier" class="chox.model.Supplier" column="supplier_id" />
  </class>
</hibernate-mapping>

