<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
    <constant name="struts.objectFactory" value="org.apache.struts2.spring.StrutsSpringObjectFactory" />
    <constant name="struts.devMode" value="true" />
    <constant name="struts.multipart.maxSize" value="1000000" />
    <package name="home-package" extends="struts-default" namespace="/">
        <interceptors>
            <interceptor name="acegi" class="chox.web.security.AcegiInterceptor" />
            <interceptor-stack name="authenticated">
                <interceptor-ref name="acegi"/>
                <interceptor-ref name="paramsPrepareParamsStack"/>
            </interceptor-stack>
        </interceptors>
        <default-interceptor-ref name="acegi" />
        <action name="index" class="chox.web.actions.IndexAction" >
            <result name="success">/jsp/index.jsp
            </result>
        </action>
        <action name="login" class="chox.web.actions.BaseAction" >
            <result name="success">/jsp/login.jsp?login_error=${login_error}
            </result>
        </action>
    </package>
    <package name="user" namespace="/user" extends="home-package">
        <default-interceptor-ref name="authenticated" />
        <action name ="processClaimsAction" class ="chox.web.actions.ProcessClaimsAction">
            <result name ="success">/jsp/user/UploadStatus.jsp
            </result>
            <result name ="error">/jsp/user/UploadFailed.jsp
            </result>
        </action>
        <action name="uploadClaims" class="chox.web.actions.UploadClaimsAction">
            <result>/jsp/user/UploadClaims.jsp</result>
        </action>
        <action name="inbox" class="chox.web.actions.InboxAction">
            <result>/jsp/user/Inbox.jsp</result>
        </action>
        <action name="searchClaim" class="chox.web.actions.SearchClaimAction">
            <result name="success">/jsp/user/p_searchClaim.jsp
            </result>
        </action>
        <action name="doSearchClaim" class="chox.web.actions.SearchClaimAction" method="doSearchClaim">
            <result name="success">/jsp/JsonData.jsp
            </result>
        </action>
        <!-- Start Claim Detail -->
        <action name="openClaimDetail" class="chox.web.actions.ClaimAction">
            <result name="success">/jsp/user/ClaimDetail.jsp
            </result>
        </action>
        <action name="UpdateClaimDetail" class="chox.web.actions.ClaimAction" method="updateClaimDetail">
            <result name="success" type="redirect">inbox.action</result>
        </action>  
        <!-- End Claim Detail -->
        <!-- Start Incident Detail -->
        <action name="openIncident" class="chox.web.actions.IncidentAction">
            <result name="success">/jsp/user/p_incident.jsp</result>
        </action>
        <action name="updateIncident" class="chox.web.actions.IncidentAction" method="updateIncident">
            <result name="success">/jsp/actionResult.jsp</result>
        </action>
        <!-- End Incident Detail -->
    </package>
    <include file="config-browser.xml"/>
</struts>
