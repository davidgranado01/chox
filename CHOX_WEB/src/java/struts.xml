<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>

    <constant name="struts.objectFactory" value="org.apache.struts2.spring.StrutsSpringObjectFactory" />
    <constant name="struts.devMode" value="true" />
    <constant name="struts.multipart.maxSize" value="1000000" />
    <package name="home-package" extends="struts-default" namespace="/">
        <interceptors>
            <interceptor name="acegi" class="chox.web.security.AcegiInterceptor" />
            <interceptor-stack name="authenticated">
                <interceptor-ref name="acegi"/>
                <interceptor-ref name="paramsPrepareParamsStack"/>
            </interceptor-stack>
        </interceptors>
        
        <default-interceptor-ref name="acegi" />
        <action name="index" class="chox.web.actions.IndexAction" >
            <result name="success">/jsp/index.jsp
            </result>
        </action>
        <action name="login" class="chox.web.actions.BaseAction" >
            <result name="success">/jsp/login.jsp?login_error=${login_error}
            </result>
        </action>
        <action name="route" class="chox.web.actions.RouteAction" >
            <result name="ins" type="redirect-action">
                <param name="actionName">inbox.action</param>
                <param name="namespace">ins</param>
            </result>
           <result name="cho" type="redirect-action">
                <param name="actionName">inbox.action</param>
                <param name="namespace">cho</param>
            </result>
            <result name="error" type="redirect-action">
                <param name="actionName">index.action</param>
            </result>
        </action>
    </package>
    <package name="cho" namespace="/cho" extends="home-package">
        <default-interceptor-ref name="paramsPrepareParamsStack"/>

        <action name ="processClaimsAction" class ="chox.web.actions.cho.ProcessClaimsAction">
            <result name ="success">/jsp/cho/UploadStatus.jsp
            </result>
            <result name ="error">/jsp/cho/Uploadfailed.jsp
            </result>
        </action>
        <action name="uploadClaims" class="chox.web.actions.cho.UploadClaimsAction">
            <result>/jsp/cho/UploadClaims.jsp</result>
        </action>
    </package>
    
    <package name="ins" namespace="/ins" extends="home-package">
        <default-interceptor-ref name="paramsPrepareParamsStack"/>

        <action name="inbox" class="chox.web.actions.ins.InboxAction">
            <result>/jsp/ins/Inbox.jsp</result>
        </action>
        <action name="getClaimsbyStatus" class="chox.web.actions.ins.ClaimsAction" method="getClaimsbyStatus">
            <param name="status">status</param>
            <result name="success">/jsp/JsonData.jsp</result>
        </action>
    </package>
    <include file="config-browser.xml"/>
</struts>
