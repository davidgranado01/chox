<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="com.mycompany.myapp.hibernate.Claim" table="claim">
    <id name="id" column="id">
      <generator class="increment" />
    </id>
    <property name="uuid" column="uuid" not-null="true" />
    <property name="rentalId" column="rental_id" not-null="true" />
    <property name="insurerCountryId" column="insurer_country_id" />
    <property name="policyNumber" column="policy_number" />
    <property name="claimReference" column="claim_reference" />
    <property name="comprehensive" column="comprehensive" />
    <property name="policyHolderName" column="policy_holder_name" not-null="true" />
    <property name="vehicleRegistration" column="vehicle_registration" not-null="true" />
    <property name="vehicleManufacturer" column="vehicle_manufacturer" not-null="true" />
    <property name="vehicleModel" column="vehicle_model" not-null="true" />
    <property name="vehicleClassId" column="vehicle_class_id" not-null="true" />
    <property name="usable" column="usable" not-null="true" />
    <property name="damageDescription" column="damage_description" />
    <property name="tpInsurerCountryId" column="tp_insurer_country_id" not-null="true" />
    <property name="tpPolicyNumber" column="tp_policy_number" />
    <property name="tpClaimReference" column="tp_claim_reference" />
    <property name="tpVehicleRegistration" column="tp_vehicle_registration" />
    <property name="tpVehicleManufacturer" column="tp_vehicle_manufacturer" />
    <property name="tpVehicleModel" column="tp_vehicle_model" />
    <property name="tpVehicleClassId" column="tp_vehicle_class_id" />
    <property name="tpName" column="tp_name" />
    <property name="tpAddress1" column="tp_address1" />
    <property name="tpAddress2" column="tp_address2" />
    <property name="tpAddress3" column="tp_address3" />
    <property name="tpAddress4" column="tp_address4" />
    <property name="tpAddress5" column="tp_address5" />
    <property name="tpPostcode" column="tp_postcode" />
    <property name="tpTelephoneDay" column="tp_telephone_day" />
    <property name="tpTelephoneEvening" column="tp_telephone_evening" />
    <property name="tpEmail" column="tp_email" />
    <property name="incidentDate" column="incident_date" not-null="true" />
    <property name="location" column="location" />
    <property name="policeInvolved" column="police_involved" not-null="true" />
    <property name="incidentDescription" column="incident_description" />
    <property name="vehicleLocation" column="vehicle_location" />
    <property name="proposedRentalClassId" column="proposed_rental_class_id" />
    <property name="claimStatus" column="claim_status" not-null="true" />
  </class>
</hibernate-mapping>

