
<%@ taglib uri="/struts-tags" prefix="s" %>

<form id="f5"  action="dummyAction">
    <fieldset class="x-fieldset">
        <legend>Third-Party Details</legend>
        <div style="display:none" class="form-container">
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Title</label>
            <input type="text" class="chox-ttxt" id="CTPDTitle" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                First Name(s)</label>
            <input type="text" class="chox-ttxt" id="CTPDFirstnames" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Surname</label>
            <input type="text" class="chox-ttxt" id="CTPDSurname" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Address 1</label>
            <input type="text" class="chox-ttxt" id="CTPDAddress1" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Address 2</label>
            <input type="text" class="chox-ttxt" id="CTPDAddress2" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Address 3</label>
            <input type="text" class="chox-ttxt" id="CTPDAddress3" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Address 4</label>
            <input type="text" class="chox-ttxt" id="CTPDAddress4" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Address 5</label>
            <input type="text" class="chox-ttxt" id="CTPDAddress5" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Postcode</label>
            <input type="text" class="chox-ttxt" id="CTPDPostcode" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Telephone Day</label>
            <input type="text" class="chox-ttxt" id="CTPDTelephoneDay" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Telepone Evening</label>
            <input type="text" class="chox-ttxt" id="CTPDTelephoneEvening" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Email</label>
            <input type="text" class="chox-ttxt" id="CTPDEmail" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Insurer</label>
            <input type="text" class="chox-ttxt" id="CTPDInsurer" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Policy Number</label>
            <input type="text" class="chox-ttxt" id="CTPDPolicyNumber" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                    Claim Number
                </label>
            <input type="text" class="chox-ttxt" id="CTPDClaimNumber" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Vehicle Manufacturer</label>
            <input type="text" class="chox-ttxt" id="CTPDVehicleManufacturer" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Vehicle Model</label>
            <input type="text" class="chox-ttxt" id="CTPDVehicleModel" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Vehicle Registration Number</label>
            <input type="text" class="chox-ttxt" id="CTPDVehicleRegistrationNumber" /></div>
            <div class="chox-form-item">
                <label class="chox-form-std-label">
                Vehicle Class</label>
            <input type="text" class="chox-ttxt" id="CTPDVehicleClass" /></div>
            <div class="chox-form-button">
                <input type="submit" value="Save Changes" />
            </div>
            <div class="chox-form-submit-result">&nbsp;</div>  
            
        </div>
    </fieldset>
</form>