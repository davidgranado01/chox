<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>idas</groupId>
    <artifactId>chox</artifactId>
    <packaging>pom</packaging>
    <version>2.0</version>
    <name>idas.chox</name>
    <url>https://www.idaschox.com</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <chox.core.version>2.0</chox.core.version>
        <chox.data.version>2.0</chox.data.version>
        <chox.events.version>1.0</chox.events.version>
        <chox.service.version>2.0</chox.service.version>
        <chox.web.version>2.0</chox.web.version>
        <chox.keoghs.version>1.0</chox.keoghs.version>
        
        <slf4j.version>1.7.25</slf4j.version>
        <jcl-over-slf4j.version>1.7.25</jcl-over-slf4j.version>
        <commons-logging.version>1.2</commons-logging.version>
        <aspectj.version>1.8.10</aspectj.version>
        
        <junit.version>4.10</junit.version>
        
        <commons-lang.version>3.1</commons-lang.version>
        
        <logback-core.version>1.1.9</logback-core.version>
        <logback-classic.version>1.1.9</logback-classic.version>
        <logback-access.version>1.1.9</logback-access.version>
        
        <jsoup.version>1.8.1</jsoup.version>
        
        <hibernate-core.version>4.3.11.Final</hibernate-core.version>
        <hibernate-ehcache.version>4.3.11.Final</hibernate-ehcache.version>
        <hibernate-validator.version>4.3.2.Final</hibernate-validator.version>
        
        <!-- For Java 7 use the following driver -->
        <postgresql-jdbc.version>9.3-1102-jdbc41</postgresql-jdbc.version>
        <!-- For Java 8 use the following driver -->
        <!--postgresql-jdbc.version>9.4-1202-jdbc42</postgresql-jdbc.version-->
        <!--postgresql-jdbc.version>42.0.0</postgresql-jdbc.version-->
        <!-- For Java 8, pgjdbc-ng driver -->
        <!--postgresql-jdbc.version>0.7.1</postgresql-jdbc.version-->

        <!-- Hikari CP -->
        <hikari.version>2.4.11</hikari.version> <!-- 2.6.1 for java 8 - update artifactId as well -->

        <h2database.version>1.3.164</h2database.version>
        <spring-core.version>4.1.4.RELEASE</spring-core.version>
        <spring-orm.version>4.1.4.RELEASE</spring-orm.version>
        <spring-test.version>4.1.4.RELEASE</spring-test.version>
        <spring-context.version>4.1.4.RELEASE</spring-context.version>
        <spring-jms.version>4.1.4.RELEASE</spring-jms.version>
        <spring-aop.version>4.1.4.RELEASE</spring-aop.version>
        <spring-jdbc.version>4.1.4.RELEASE</spring-jdbc.version>
        <spring-expression.version>4.1.4.RELEASE</spring-expression.version>
        <spring-beans.version>4.1.4.RELEASE</spring-beans.version>
        <spring-context-support.version>4.1.4.RELEASE</spring-context-support.version>
        <spring-web.version>4.1.4.RELEASE</spring-web.version>

        <spring-security-core.version>3.2.5.RELEASE</spring-security-core.version>
        <spring-security-config.version>3.2.5.RELEASE</spring-security-config.version>
        <spring-security-web.version>3.2.5.RELEASE</spring-security-web.version>

        <!--struts.version>2.3.32</struts.version-->
        <struts.version>2.5.10.1</struts.version>
       
        <quartz-scheduler.version>2.2.1</quartz-scheduler.version>
        
        <activeMQ.version>5.8.0</activeMQ.version>
        <!-- NB. Cannot send emails with version 1.5.4: MessagingException Could not connect to SMTP host: smtp.gmail.com, port: 465, response: -1 -->
        <mail.version>1.5.2</mail.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>2.3.2</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <source>1.7</source>
                    <target>1.7</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>cobertura-maven-plugin</artifactId>
                <version>2.5.1</version>
                <configuration>
                    <aggregate>true</aggregate>
                </configuration>
                <executions>
                    <execution>
                        <phase>test</phase>
                        <goals>
                            <!-- Uncomment for report generation and comment the bottom goal -->
<!--                             <goal>cobertura</goal> -->
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <modules>
        <module>idas.chox.core</module>
        <module>idas.chox.data</module>
        <module>idas.chox.events</module>
        <module>idas.chox.service</module>
        <module>idas.chox.web</module>
        <module>wsUploadClient</module>
        <module>idas.chox.jmsClient</module>
        <module>reportToExcel</module>
        <module>reportToExcelTemplate</module>
        <module>emailNotifications</module>
        <module>keoghs</module>
    </modules>

</project>
