 <?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>idas</groupId>
    <artifactId>chox</artifactId>
    <packaging>pom</packaging>
    <version>2.1</version>
    <name>idas.chox</name>
    <url>https://www.idaschox.com</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <chox.core.version>2.1</chox.core.version>
        <chox.data.version>2.1</chox.data.version>
        <chox.events.version>1.1</chox.events.version>
        <chox.service.version>2.1</chox.service.version>
        <chox.web.version>2.1</chox.web.version>
        <chox.keoghs.version>1.1</chox.keoghs.version>
        
        <slf4j.version>1.7.26</slf4j.version>
        <jcl-over-slf4j.version>1.7.26</jcl-over-slf4j.version>
        <aspectj.version>1.9.4</aspectj.version>
        
        <junit.version>4.13-beta-3</junit.version>
        
        <commons-lang.version>3.9</commons-lang.version>
        
        <logback.version>1.2.3</logback.version>
        
        <jsoup.version>1.12.1</jsoup.version>
        
        <hibernate-core.version>5.4.4.Final</hibernate-core.version>
        <hibernate-ehcache.version>5.4.4.Final</hibernate-ehcache.version>
        <hibernate-validator.version>6.0.17.Final</hibernate-validator.version>
        
        <!-- Java 8 Official Postgres Driver -->
        <postgresql-jdbc.version>42.2.6</postgresql-jdbc.version>

        <!-- Java 8, pgjdbc-ng driver -->
        <!--postgresql-jdbc-ng.version>0.7.1</postgresql-jdbc-ng.version--> <!-- use 0.7 for Java 7 -->

        <!-- Hikari CP -->
        <hikari.version>3.3.1</hikari.version>

        <h2database.version>1.3.164</h2database.version>
        <spring-core.version>5.1.9.RELEASE</spring-core.version> <!-- update to 4.3.18.RELEASE, requires CXF update to 3, latest is 3.2.5 -->
        <spring-orm.version>5.1.9.RELEASE</spring-orm.version>
        <spring-test.version>5.1.9.RELEASE</spring-test.version>
        <spring-context.version>5.1.9.RELEASE</spring-context.version>
        <spring-jms.version>5.1.9.RELEASE</spring-jms.version>
        <spring-aop.version>5.1.9.RELEASE</spring-aop.version>
        <spring-jdbc.version>5.1.9.RELEASE</spring-jdbc.version>
        <spring-expression.version>5.1.9.RELEASE</spring-expression.version>
        <spring-beans.version>5.1.9.RELEASE</spring-beans.version>
        <spring-context-support.version>5.1.9.RELEASE</spring-context-support.version>
        <spring-web.version>5.1.9.RELEASE</spring-web.version>

        <spring-security-core.version>5.1.6.RELEASE</spring-security-core.version>
        <spring-security-config.version>5.1.6.RELEASE</spring-security-config.version>
        <spring-security-web.version>5.1.6.RELEASE</spring-security-web.version>

        <struts.version>2.5.20</struts.version>
       
        <quartz-scheduler.version>2.3.1</quartz-scheduler.version>
        
        <cxf.version>3.3.2</cxf.version>

        <mail.version>1.6.2</mail.version>
        <json-lib.version>2.4</json-lib.version>
        <gson.version>2.8.5</gson.version>
        <jxls.version>2.7.0</jxls.version>
        <jxls-poi.version>1.3.0</jxls-poi.version>
        <poi.version>4.1.1</poi.version> <!-- was 3.17 -->
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.5</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.5</version>
        </plugin>
        </plugins>
    </build>
    <modules>
        <module>idas.chox.core</module>
        <module>idas.chox.data</module>
        <module>idas.chox.events</module>
        <!--module>keoghs</module-->
        <module>idas.chox.service</module>
        <module>idas.chox.web</module>
        <module>wsUploadClient</module>
        <module>reportToExcel</module>
        <module>reportToExcelTemplate</module>
        <!--module>emailNotifications</module-->
    </modules>

</project>
