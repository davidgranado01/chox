<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>idas</groupId>
    <artifactId>chox</artifactId>
    <packaging>pom</packaging>
    <version>2.0</version>
    <name>idas.chox</name>
    <url>https://www.idaschox.com</url>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <chox.core.version>2.0</chox.core.version>
        <chox.data.version>2.0</chox.data.version>
        <chox.events.version>1.0</chox.events.version>
        <chox.service.version>2.0</chox.service.version>
        <chox.web.version>2.0</chox.web.version>
        
        <slf4j.version>1.6.6</slf4j.version>
        <jcl-over-slf4j.version>1.6.4</jcl-over-slf4j.version>
        <commons-logging.version>1.1.1</commons-logging.version>
        <aspectj.version>1.7.2</aspectj.version>
        
        <junit.version>4.10</junit.version>
        
        <commons-lang.version>3.1</commons-lang.version>
        
        <logback-core.version>1.0.6</logback-core.version>
        <logback-classic.version>1.0.6</logback-classic.version>
        <logback-access.version>1.0.6</logback-access.version>
        
        <jsoup.version>1.8.1</jsoup.version>
        
        <hibernate-core.version>3.6.8.Final</hibernate-core.version>
        <hibernate-ehcache.version>3.6.8.Final</hibernate-ehcache.version>
        <hibernate-validator.version>4.2.0.Final</hibernate-validator.version>
        
        <!-- For Java 7 and 8, use the following driver -->
        <postgresql-jdbc.version>9.3-1102-jdbc41</postgresql-jdbc.version>

        <!-- PostgreSQL Driver for Java 1.6 -->
<!--        <postgresql-jdbc.version>9.3-1102-jdbc4</postgresql-jdbc.version>-->

        <h2database.version>1.3.164</h2database.version>
        
        <spring-core.version>3.2.8.RELEASE</spring-core.version>
        <spring-orm.version>3.2.8.RELEASE</spring-orm.version>
        <spring-test.version>3.2.8.RELEASE</spring-test.version>
        <spring-context.version>3.2.8.RELEASE</spring-context.version>
        <spring-jms.version>3.2.8.RELEASE</spring-jms.version>
        <spring-security-core.version>3.2.3.RELEASE</spring-security-core.version>
        <spring-aop.version>3.2.8.RELEASE</spring-aop.version>
        <spring-jdbc.version>3.2.8.RELEASE</spring-jdbc.version>
        <spring-expression.version>3.2.8.RELEASE</spring-expression.version>
        <spring-beans.version>3.2.8.RELEASE</spring-beans.version>
        <spring-context-support.version>3.2.8.RELEASE</spring-context-support.version>
        <spring-web.version>3.2.8.RELEASE</spring-web.version>
        <spring-security-config.version>3.2.3.RELEASE</spring-security-config.version>
        <spring-security-web.version>3.2.3.RELEASE</spring-security-web.version>

        <struts.version>2.3.16.3</struts.version>
       
        <quartz-scheduler.version>2.1.7</quartz-scheduler.version>
        
        <activeMQ.version>5.8.0</activeMQ.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>2.3.2</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <source>1.7</source>
                    <target>1.7</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>cobertura-maven-plugin</artifactId>
                <version>2.5.1</version>
                <configuration>
                    <aggregate>true</aggregate>
                </configuration>
                <executions>
                    <execution>
                        <phase>test</phase>
                        <goals>
                            <!-- Uncomment for report generation and comment the bottom goal -->
<!--                             <goal>cobertura</goal> -->
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <modules>
        <module>idas.chox.core</module>
        <module>idas.chox.data</module>
        <module>idas.chox.events</module>
        <module>idas.chox.service</module>
        <module>idas.chox.web</module>
        <module>wsUploadClient</module>
        <module>idas.chox.jmsClient</module>
        <module>reportToExcel</module>
        <module>reportToExcelTemplate</module>
    </modules>

</project>