<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>idas</groupId>
    <artifactId>chox</artifactId>
    <packaging>pom</packaging>
    <version>2.0</version>
    <name>idas.chox</name>
    <url>https://www.idaschox.com</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <chox.core.version>2.0</chox.core.version>
        <chox.data.version>2.0</chox.data.version>
        <chox.events.version>1.0</chox.events.version>
        <chox.service.version>2.0</chox.service.version>
        <chox.web.version>2.0</chox.web.version>
        <chox.keoghs.version>1.0</chox.keoghs.version>
        
        <slf4j.version>1.7.25</slf4j.version>
        <jcl-over-slf4j.version>1.7.25</jcl-over-slf4j.version>
        <aspectj.version>1.8.10</aspectj.version>
        
        <junit.version>4.10</junit.version>
        
        <commons-lang.version>3.5</commons-lang.version>

        <xalan.version>2.7.2</xalan.version>
        
        <logback.version>1.2.3</logback.version>
        
        <jsoup.version>1.10.2</jsoup.version>
        
        <hibernate-core.version>4.3.11.Final</hibernate-core.version>
        <hibernate-ehcache.version>4.3.11.Final</hibernate-ehcache.version>
        <hibernate-validator.version>5.4.1.Final</hibernate-validator.version>
        
        <!-- Java 8 Official Postgres Driver -->
        <postgresql-jdbc.version>42.1.4</postgresql-jdbc.version>

        <!-- Java 8, pgjdbc-ng driver -->
        <!--postgresql-jdbc-ng.version>0.7.1</postgresql-jdbc-ng.version--> <!-- use 0.7 for Java 7 -->

        <!-- Hikari CP -->
        <hikari.version>2.6.2</hikari.version>

        <h2database.version>1.3.164</h2database.version>
        <spring-core.version>4.1.9.RELEASE</spring-core.version>
        <spring-orm.version>4.1.9.RELEASE</spring-orm.version>
        <spring-test.version>4.1.9.RELEASE</spring-test.version>
        <spring-context.version>4.1.9.RELEASE</spring-context.version>
        <spring-jms.version>4.1.9.RELEASE</spring-jms.version>
        <spring-aop.version>4.1.9.RELEASE</spring-aop.version>
        <spring-jdbc.version>4.1.9.RELEASE</spring-jdbc.version>
        <spring-expression.version>4.1.9.RELEASE</spring-expression.version>
        <spring-beans.version>4.1.9.RELEASE</spring-beans.version>
        <spring-context-support.version>4.1.9.RELEASE</spring-context-support.version>
        <spring-web.version>4.1.9.RELEASE</spring-web.version>

        <spring-security-core.version>3.2.10.RELEASE</spring-security-core.version>
        <spring-security-config.version>3.2.10.RELEASE</spring-security-config.version>
        <spring-security-web.version>3.2.10.RELEASE</spring-security-web.version>

        <struts.version>2.5.13</struts.version>
       
        <quartz-scheduler.version>2.3.0</quartz-scheduler.version>
        
        <activeMQ.version>5.8.0</activeMQ.version>
        <mail.version>1.5.6</mail.version>
        <json-lib.version>2.4</json-lib.version>
        <gson.version>2.8.0</gson.version>
        <jxls-core.version>1.0.6</jxls-core.version>
        <poi.version>3.16</poi.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>2.3.2</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>cobertura-maven-plugin</artifactId>
                <version>2.5.1</version>
                <configuration>
                    <aggregate>true</aggregate>
                </configuration>
                <executions>
                    <execution>
                        <phase>test</phase>
                        <goals>
                            <!-- Uncomment for report generation and comment the bottom goal -->
<!--                             <goal>cobertura</goal> -->
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <modules>
        <module>idas.chox.core</module>
        <module>idas.chox.data</module>
        <module>idas.chox.events</module>
        <module>idas.chox.service</module>
        <module>idas.chox.web</module>
        <module>wsUploadClient</module>
        <module>idas.chox.jmsClient</module>
        <module>reportToExcel</module>
        <module>reportToExcelTemplate</module>
        <module>emailNotifications</module>
        <module>keoghs</module>
    </modules>

</project>
