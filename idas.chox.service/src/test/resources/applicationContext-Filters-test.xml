    </bean>

    <bean id="InvoicesReferredToEngineer" class="idas.chox.service.filters.FilterByStatus">
        <property name="claimService" ref="claimService"/>
        <property name="name" value="Invoice Referred By Claim Handler"/>
        <property name="key" value="InvoicesReferredToEngineer"/>
        <property name="status" value="InvoiceReferredToEngineer"/>
        <property name="isCheckWorkGroup" value="false"/>
        <property name="isCheckOwnership" value="false"/>
