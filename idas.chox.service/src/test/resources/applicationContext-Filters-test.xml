    <bean id="ClaimUnacknowledgedUnassigned" class="idas.chox.service.filters.FilterByStatus">
        <property name="claimService" ref="claimService"/>
        <property name="name" value="Claim Unacknowledged Unassigned"/>
        <property name="key" value="ClaimUnacknowledgedUnassigned"/>
        <property name="status" value="ClaimUnacknowledgedUnassigned"/>
        <property name="isCheckWorkGroup" value="true"/>
        <property name="isCheckOwnership" value="false"/>
    </bean>

    <bean id="AwaitingInvoiceData" class="idas.chox.service.filters.FilterByStatus">
        <property name="claimService" ref="claimService"/>
        <property name="name" value= "Awaiting Invoice Data"/>
        <property name="key" value= "AwaitingInvoiceData"/>
        <property name="status" value= "AwaitingInvoiceData"/>
        <property name="isCheckWorkGroup" value="false"/>
        <property name="isCheckOwnership" value="false"/>
    </bean>

    <bean id="HireUpdateAnomalies" class="idas.chox.service.filters.HireUpdateAnomalies">
        <property name="claimService" ref="claimService"/>
        <property name="name" value= "Hire Update Anomalies"/>
        <property name="key" value= "HireUpdateAnomalies"/>
        <property name="isCheckWorkGroup" value="true"/>
        <property name="isCheckOwnership" value="true"/>
    </bean>

    <bean id="PenaltyChargesApplied" class="idas.chox.service.filters.PenaltyChargesApplied">
        <property name="claimService" ref="claimService"/>
        <property name="name" value= "Penalty Charges Applied"/>
        <property name="key" value= "PenaltyChargesApplied"/>
        <property name="isCheckWorkGroup" value="false"/>
        <property name="isCheckOwnership" value="false"/>
