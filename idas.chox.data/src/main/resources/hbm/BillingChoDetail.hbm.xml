<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.BillingChoDetail" schema="public" table="billing_cho_detail">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
        <generator class="sequence">
            <param name="sequence_name">billing_cho_detail_id_seq</param>
        </generator>
    </id>
    <many-to-one class="idas.chox.core.model.BillingCho" column="billing_cho_id" name="billing"/>
    <many-to-one class="idas.chox.core.model.Claim" column="claim_reference_id" name="claim"/>
    <property column="received_date" name="receivedDate"/>
    <property column="trigger_date" name="triggerDate"/>
    <property column="trigger_point" name="triggerPoint"/>
    <property column="comment" name="comment"/>
    <property column="net_claim_cost" name="billAmount"/>
    <property column="vat_net_claim_cost" name="vatOnBillAmount"/>
    <property column="gross_claim_cost" name="grossBillAmount"/>
    <property column="amount_received" name="amountReceived"/>
    <property column="reconciled" name="reconciled"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" lazy="false" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
  </class>
</hibernate-mapping>
