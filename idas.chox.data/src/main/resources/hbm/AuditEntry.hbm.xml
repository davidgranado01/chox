<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="idas.chox.core.model.AuditEntry" table="audit_history">
        <cache usage="read-write"/>
        <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">audit_history_id_seq</param>
            </generator>
        </id>
        <property column="table_name" name="tableName" not-null="true"/>
        <property column="object_id" name="objectId" not-null="true"/>
        <property column="parameter_name" name="parameterName" not-null="true"/>
        <property column="old_value" name="oldValue"/>
        <property column="new_value" name="newValue"/>
        <property column="created_date" name="createdDate"/>
        <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    </class>
</hibernate-mapping>
