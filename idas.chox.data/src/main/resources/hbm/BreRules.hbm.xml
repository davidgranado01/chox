<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="idas.chox.core.model.BreRules" table="bre_rules">
        <cache usage="read-only"/>
        <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">bre_rules_id_seq</param>
            </generator>
        </id>
        <property column="rule_id" name="ruleName" not-null="true"/>
        <property column="name" name="ruleDescription" not-null="true"/>
    </class>
</hibernate-mapping>
