<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.Insurer" table="insurer">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">insurer_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="name" name="name"/>
    <property column="status" name="status"/>
    <property column="address1" name="address1" not-null="true"/>
    <property column="address2" name="address2" not-null="true"/>
    <property column="address3" name="address3"/>
    <property column="address4" name="address4"/>
    <property column="address5" name="address5"/>
    <property column="postcode" name="postcode" not-null="true"/>
    <property column="phone" name="phone"/>
    <property column="support_procedure" name="supportProcedure"/>
    <property column="vat_no" name="vatNo" not-null="true"/>
    <property column="company_no" name="companyNo" not-null="true"/>
    <property column="admin_handling_charge" name="adminHandlingCharge"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="is_workgroup_enable" name="workgroupEnable"/>
    <property column="is_fnol_enable" name="fnolEnable"/>
    <property column="is_supervisor_enable" name="supervisorEnable"/>
    <property column="is_engineers_enable" name="engineersEnable"/>
    <property column="is_claim_ownership_enable" name="claimOwnershipEnable"/>
    <property column="is_claim_locked" name="claimLocked"/>
    <property column="is_support_available" name="onlineSupportEnable"/>
    <property column="is_task_management_enable" name="taskManagementEnable"/>
    <property column="is_third_pary_intervention_activated" name="thirdPartyInterventionActivated"/>
    <property column="tpi_identifier" name="tpiIdentificationString"/>
    <property column="gta_regex_expression" name="gtaRegexExpression"/>
    <property column="tpi_regex_expression" name="tpiRegexExpression"/>
    <property column="subscriber_regex_expression" name="subscriberRegexExpression"/>
    <property column="fixed_fee_regex_expression" name="fixedFeeRegexExpression"/>
    <property column="collaboration_regex_expression" name="collaborationProtocolRegexExpression"/>
    <property column="insurer_vs_insurer_regex_expression" name="insurerVsInsurerRegexExpression"/>
    <property column="insurer_manual_regex_expression" name="insurerManualRegexExpression"/>
    <property column="is_tpi_auto_routing_enable" name="tpiAutoRoutingEnable" not-null="true"/>
    <property column="is_gta_auto_routing_enable" name="gtaAutoRoutingEnable" not-null="true"/>
    <property column="is_subscriber_auto_routing_enable" name="subscriberAutoRoutingEnable" not-null="true"/>
    <property column="is_fixed_fee_auto_routing_enable" name="fixedFeeAutoRoutingEnable" not-null="true"/>
    <property column="is_collaboration_auto_routing_enable" name="colaborationProtocolAutoRoutingEnable" not-null="true"/>
    <property column="is_insurer_vs_insurer_auto_routing_enable" name="insurerVsInsurerAutoRoutingEnable" not-null="true"/>
    <property column="is_insurer_manual_auto_routing_enable" name="insurerManualAutoRoutingEnable" not-null="true"/>
    <property column="force_password_change" name="forcePasswordChange" not-null="true"/>
    <property column="unique_password_history" name="uniquePasswordHistory" not-null="true"/>
    <property column="minimum_password_length" name="minimumPasswordLength" not-null="true"/>
    <property column="is_insurer_discount_enable" name="insurerDiscountEnable"/>
    <property column="is_invoice_upload_enabled" name="invoiceUploadEnabled"  not-null="true"/>
    <property column="is_claim_upload_enabled" name="claimUploadEnabled" not-null="true"/>
    <property column="claim_audit_review_enable" name="claimAuditReviewEnable" not-null="true"/>
    <property column="allow_subscriber_claims" name="allowSubscriberClaims" not-null="true"/>
    <property column="allow_fixedfee_claims" name="allowFixedFeeClaims" not-null="true"/>
    <property column="allow_collaboration_claims" name="allowCollaborationProtocolClaims" not-null="true"/>
    <property column="days_before_escalated" name="daysBeforeEscalated"/>
    <property column="times_in_status_contested" name="timesInStatusContested"/>
    <property column="enable_ip_whitelist" name="enableIPWhitelist" not-null="true"/>
    <property column="max_login_attempts" name="maxLoginAttempts" not-null="true"/>
    <property column="block_time" name="blockTime" not-null="true"/>
    <property column="disable_private_notes" name="disablePrivateNotes" not-null="true"/>
    <property column="blocked_message" name="blockedMessage" not-null="true"/>
    <property column="enable_manual_invoice_workgroups" name="enableManualInvoiceWorkgroups" not-null="true"/>
    <property column="enable_manual_invoice_ownership" name="enableManualInvoiceOwnership" not-null="true"/>
    <property column="ecd_increase_trigger" name="ecdIncreaseTriggerPercentage" not-null="true"/>
    <property column="restrict_export" name="restrictExport" not-null="true"/>
    <property column="gta_payments_team_enable" name="gtaPaymentsTeamEnable" not-null="true"/>
    <property column="subscriber_payments_team_enable" name="subscriberPaymentsTeamEnable" not-null="true"/>
    <property column="fixed_fee_payments_team_enable" name="fixedFeePaymentsTeamEnable" not-null="true"/>
    <property column="insurer_vs_insurer_payments_team_enable" name="insurerVsInsurerPaymentsTeamEnable" not-null="true"/>
    <property column="collaboration_payments_team_enable" name="collaborationPaymentsTeamEnable" not-null="true"/>
    <property column="insurer_manual_payments_team_enable" name="insurerManualPaymentsTeamEnable" not-null="true"/>
    <property column="tpi_payments_team_enable" name="tpiPaymentsTeamEnable" not-null="true"/>
    <property column="branding" name="branding" type="idas.chox.data.hibernate.BrandMapping"/>
    <property column="is_payment_disputes_enable" name="paymentDisputesEnable" not-null="true"/>
    <property column="acceptance_reason_enable" name="acceptanceReasonEnable" not-null="true"/>
    <property column="automatic_routing_strategy" name="automaticRoutingStrategy"
        type="idas.chox.data.hibernate.AutomaticRoutingStrategyMapping" not-null="true"/>
    <property column="complete_routing" name="completeRoutingEnable" not-null="true"/>
    <property column="enable_kbbs_dashboard" name="enableKbbsDashboard" not-null="true"/>
    <property column="enable_lou_dates" name="enableLouDates" not-null="true"/>
    <property column="kbbs_manager_password" name="kbbsManagerPassword"/>
    <property column="kbbs_operative_password" name="kbbsOperativePassword"/>
    <many-to-one class="idas.chox.core.model.Workgroup" column="invoice_workgroup" name="invoiceWorkgroup"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="invoice_owner" name="invoiceOwner"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <many-to-one class="idas.chox.core.model.Insurer" column="related_insurer" name="relatedInsurer"/>
    
    <bag cascade="all,delete-orphan" inverse="true" lazy="extra" name="vehicleClassCeilings">
      <key column="insurer_id"/>
      <one-to-many class="idas.chox.core.model.VehicleClassCeiling"/>
    </bag>
    
    <filter condition="id IN (:insurerIds)" name="insurer_filter"/>
    
  </class>
  
  <filter-def name="insurer_filter">
      <filter-param name="insurerIds" type="integer"/>
  </filter-def>
    
</hibernate-mapping>
