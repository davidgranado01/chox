<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.Insurer" table="insurer">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">insurer_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="name" name="name"/>
    <property column="status" name="status"/>
    <property column="address1" name="address1" not-null="true"/>
    <property column="address2" name="address2" not-null="true"/>
    <property column="address3" name="address3"/>
    <property column="address4" name="address4"/>
    <property column="address5" name="address5"/>
    <property column="postcode" name="postcode" not-null="true"/>
    <property column="phone" name="phone"/>
    <property column="support_procedure" name="supportProcedure"/>
    <property column="vat_no" name="vatNo" not-null="true"/>
    <property column="company_no" name="companyNo" not-null="true"/>
    <property column="admin_handling_charge" name="adminHandlingCharge"/>
    <property column="cho_agreed_benefit_value" name="choAgreedBenefitValue"/>
    <property column="scs_agreed_benefit_share_value" name="scsAgreedBenefitShareValue"/>
    <property column="fixed_transactional_fee_value" name="fixedTransactionalFeeValue"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="is_workgroup_enable" name="workgroupEnable"/>
    <property column="is_fnol_enable" name="fnolEnable"/>
    <property column="is_supervisor_enable" name="supervisorEnable"/>
    <property column="is_engineers_enable" name="engineersEnable"/>
    <property column="is_fixed_transactional_fee" name="fixedTransactionalFee"/>
    <property column="is_auto_routing_enable" name="autoRoutingEnable"/>
    <property column="is_auto_routing_enable_price" name="autoRoutingEnablePrice"/>
    <property column="is_claim_ownership_enable" name="claimOwnershipEnable"/>
    <property column="is_claim_locked" name="claimLocked"/>
    <property column="is_support_available" name="onlineSupportEnable"/>
    <property column="is_task_management_enable" name="taskManagementEnable"/>
    <property column="is_third_pary_intervention_activated" name="thirdPartyInterventionActivated"/>
    <property column="tpi_identifier" name="tpiIdentificationString"/>
    <property column="tpi_regex_expression" name="tpiRegexExpression"/>
    <property column="force_password_change" name="forcePasswordChange" not-null="true"/>
    <property column="unique_password_history" name="uniquePasswordHistory" not-null="true"/>
    <property column="minimum_password_length" name="minimumPasswordLength" not-null="true"/>
    <property column="is_insurer_discount_enable" name="insurerDiscountEnable"/>
    <property column="is_upload_enabled" name="uploadEnabled"/>
    <property column="allow_subscriber_claims" name="allowSubscriberClaims" not-null="true"/>
    <property column="days_before_escalated" name="daysBeforeEscalated"/>
    <property column="times_in_status_contested" name="timesInStatusContested"/>
    <property column="enable_ip_whitelist" name="enableIPWhitelist" not-null="true"/>
    <property column="ecd_increase_trigger" name="ecdIncreaseTriggerPercentage" not-null="true"/>
    <many-to-one class="idas.chox.core.model.Workgroup" column="tpi_workgroup" name="tpiWorkgroup"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="tpi_claim_owner" name="tpiClaimOwner"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <many-to-one class="idas.chox.core.model.Insurer" column="related_insurer" name="relatedInsurer"/>
    
    <bag cascade="all,delete-orphan" inverse="true" lazy="extra" name="vehicleClassCeilings">
      <key column="insurer_id"/>
      <one-to-many class="idas.chox.core.model.VehicleClassCeiling"/>
    </bag>
    
    <filter condition="id IN (:insurerIds)" name="insurer_filter"/>
    
  </class>
  
  <filter-def name="insurer_filter">
      <filter-param name="insurerIds" type="integer"/>
  </filter-def>
    
</hibernate-mapping>
