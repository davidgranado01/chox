<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.ReasonOfRejectionTemplate" table="reason_of_rejection_template">
    <cache usage="read-only"/>
    <id column="id" name="id">
		<generator class="sequence">
			<param name="sequence">reason_of_rejection_template_id_seq</param>
		</generator>
	</id>
    <property column="name" name="name"/>
    <property column="restricted" name="restricted"/>
    <property column="type" name="type"/>
    <property column="description" name="description"/>
  </class>
</hibernate-mapping>
