<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.Incident" table="incident">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">incident_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="date" name="date" not-null="true"/>
    <property column="time" name="time"/>
    <property column="location" name="location"/>
    <property column="incident_description" name="incidentDescription"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <property column="created_date" name="createdDate"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="is_police_involved" name="isPoliceInvolved" not-null="false"/>
    <one-to-one cascade="save-update,delete" class="idas.chox.core.model.Witness" name="witness" property-ref="incident"/>
    <one-to-one cascade="save-update,delete" class="idas.chox.core.model.Injury" name="injury" property-ref="incident"/>
  </class>
</hibernate-mapping>
