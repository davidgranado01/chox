<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.Incident" table="incident">
    <id column="id" name="id">
      <generator class="increment"/>
    </id>
    <property column="date" name="date" not-null="true"/>
    <property column="location" name="location"/>
    <property column="incident_description" name="incidentDescription"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <property column="created_date" name="createdDate"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="is_police_involved" name="isPoliceInvolved" not-null="true"/>
    <one-to-one cascade="save-update,delete" name="witness" class="idas.chox.core.model.Witness" property-ref="incident"/>
    <one-to-one cascade="save-update,delete" name="injury" class="idas.chox.core.model.Injury" property-ref="incident"/>
  </class>
</hibernate-mapping>
