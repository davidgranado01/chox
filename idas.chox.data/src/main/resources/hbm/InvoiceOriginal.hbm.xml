<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="idas.chox.core.model.InvoiceOriginal" table="invoice_original">
        <cache usage="read-write"/>
        <id column="id" name="id">
             <generator class="sequence">
                <param name="sequence">invoice_original_id_seq</param>
            </generator>
        </id>
        <version column="version" name="version" unsaved-value="null"/>
        <property column="date_invoiced" name="dateInvoicedOriginal" />
        <property column="hire_net" name="hireNetOriginal"/>
        <property column="hire_vat" name="hireVatOriginal"/>
        <property column="hire_gross" name="hireGrossOriginal"/>
        <property column="repair_net" name="repairNetOriginal"/>
        <property column="repair_vat" name="repairVatOriginal"/>
        <property column="repair_gross" name="repairGrossOriginal"/>
        <property column="engineer_fee_net" name="engineerFeeNetOriginal"/>
        <property column="engineer_fee_vat" name="engineerFeeVatOriginal"/>
        <property column="engineer_fee_gross" name="engineerFeeGrossOriginal"/>
        <property column="storage_recovery_net" name="storageRecoveryNetOriginal"/>
        <property column="storage_recovery_vat" name="storageRecoveryVatOriginal"/>
        <property column="storage_recovery_gross" name="storageRecoveryGrossOriginal"/>
        <property column="total_loss_net" name="totalLossFeeNetOriginal"/>
        <property column="total_loss_vat" name="totalLossFeeVatOriginal"/>
        <property column="total_loss_gross" name="totalLossFeeGrossOriginal"/>
        <property column="total_net" name="totalNetOriginal"/>
        <property column="total_vat" name="totalVatOriginal"/>
        <property column="total_gross" name="totalGrossOriginal"/>
        <property column="claims_handling_invoice_amount" name="claimsHandlingInvoiceAmountOriginal"/>
        <property column="deduction_for_claims_handling_fee" name="deductionForClaimsHandlingFeeOriginal"/>
        <property column="discount" name="discountOriginal"/>
        <property column="insurer_discount" name="insurerDiscountOriginal"/>
        <property column="full_total_to_pay" name="fullTotalToPayOriginal"/>
        <property column="total_to_pay" name="totalToPayOriginal"/>
        <property column="collaboration_fee" name="collaborationFeeOriginal"/>
        <property column="collaboration_qty" name="collaborationQtyOriginal"/>
        <property column="miscellaneous_fee" name="miscellaneousFeeOriginal"/>
        <property column="miscellaneous_qty" name="miscellaneousQtyOriginal"/>
        <property column="automatic_fee" name="automaticFeeOriginal"/>
        <property column="automatic_qty" name="automaticQtyOriginal"/>
        <property column="additional_driver_fee" name="additionalDriverFeeOriginal"/>
        <property column="additional_driver_qty" name="additionalDriverQtyOriginal"/>
        <property column="sat_nav_fee" name="satNavFeeOriginal"/>
        <property column="sat_nav_qty" name="satNavQtyOriginal"/>
        <property column="estate_fee" name="estateFeeOriginal"/>
        <property column="estate_qty" name="estateQtyOriginal"/>
        <property column="baby_seat_fee" name="babySeatFeeOriginal"/>
        <property column="baby_seat_qty" name="babySeatQtyOriginal"/>
        <property column="tow_bars_fee" name="towBarsFeeOriginal"/>
        <property column="tow_bars_qty" name="towBarsQtyOriginal"/>
        <property column="non_standard_insurance_premium_fee" name="nonStandardInsurancePremiumFeeOriginal"/>
        <property column="non_standard_insurance_premium_qty" name="nonStandardInsurancePremiumQtyOriginal"/>
        <property column="admin_fee" name="adminFeeOriginal"/>
        <property column="admin_qty" name="adminQtyOriginal"/>
        <property column="roof_rack_fee" name="roofRackFeeOriginal"/>
        <property column="roof_rack_qty" name="roofRackQtyOriginal"/>
        <property column="dual_control_fee" name="dualControlFeeOriginal"/>
        <property column="dual_control_qty" name="dualControlQtyOriginal"/>
        <property column="delivery_collection_fee" name="deliveryCollectionFeeOriginal"/>
        <property column="delivery_collection_qty" name="deliveryCollectionQtyOriginal"/>
        <property column="created_date" name="createdDate"/>
        <property column="last_modified_date" name="lastModifiedDate"/>
