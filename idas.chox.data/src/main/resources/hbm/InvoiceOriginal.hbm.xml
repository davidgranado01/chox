        <property column="excess_amount_collected" name="excessAmountCollectedOriginal"/>
        <property column="vat_amount_collected" name="vatAmountCollectedOriginal"/>
        <property column="hire_penalty_charge" name="hirePenaltyChargeOriginal"/>
        <property column="hire_penalty_percentage" name="hirePenaltyPercentageOriginal"/>
        <property column="repair_penalty_charge" name="repairPenaltyChargeOriginal"/>
        <property column="repair_penalty_percentage" name="repairPenaltyPercentageOriginal"/>
        <property column="total_penalty_charge" name="totalPenaltyChargeOriginal"/>
        <property column="interim_payment_amount" name="interimPaymentOriginal"/>
        <property column="repair_admin_fee" name="repairAdminFeeOriginal"/>
        <property column="repair_acquisition_fee" name="repairAcquisitionFeeOriginal"/>
        <property column="repair_parts" name="repairPartsOriginal"/>
        <property column="repair_labour" name="repairLabourOriginal"/>
        <property column="repair_materials" name="repairMaterialsOriginal"/>
        <property column="repair_specialist" name="repairSpecialistOriginal"/>
