<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.WebUserRole" table="web_user_role">
    <cache usage="read-only"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">web_user_role_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="name" name="name"/>
    <property column="type_id" name="typeId" not-null="true"/>
    <property column="description" name="description"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="created_date" name="createdDate"/>
    <property column="is_workgroup_related" name="workgroupRelated"/>
    <property column="is_ownership_related" name="ownershipRelated"/>
    <property column="is_fnol_related" name="fnolRelated"/>
    <property column="is_engineer_related" name="engineerRelated"/>
    <property column="show_workgroup_disabled" name="showWorkgroupDisabled" not-null="true"/>
    <property column="show_ownership_disabled" name="showOwnershipDisabled" not-null="true"/>
    <property column="show_insurer_upload_disabled" name="showInsurerUploadDisabled" not-null="true"/>
    <property column="show_admin_only" name="showAdminOnly" not-null="true"/>
    <property column="can_be_assigned_tasks" name="canBeAssignedTasks" not-null="true"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
  </class>
</hibernate-mapping>
