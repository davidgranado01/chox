<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="idas.chox.core.model.PenaltyCharge" table="penalty_charge">
        <cache usage="nonstrict-read-write"/>
        <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">penalty_charge_id_seq</param>
            </generator>
        </id>
        <property column="penalty_type" name="penaltyType" not-null="true">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">idas.chox.core.model.PenaltyCharge$PenaltyType</param>
                <param name="type">12</param>
            </type>
        </property>
        <property column="penalty_start_age" name="penaltyStartAge" not-null="true"/>
        <property column="penalty_start_date" name="penaltyStartDate" not-null="true"/>
        <property column="hire_penalty_percentage_dsc" name="hirePenaltyPercentageDsc"/>
        <property column="hire_penalty_percentage_val" name="hirePenaltyPercentageVal"/>
        <property column="repair_penalty_percentage_dsc" name="repairPenaltyPercentageDsc"/>
        <property column="repair_penalty_percentage_val" name="repairPenaltyPercentageVal"/>
    </class>
</hibernate-mapping>
