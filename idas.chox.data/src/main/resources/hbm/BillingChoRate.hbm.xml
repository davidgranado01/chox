<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" " http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.BillingChoRate" schema="public" table="billing_cho_rate">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
        <generator class="sequence">
            <param name="sequence">billing_cho_rate_id_seq</param>
        </generator>
    </id>
    <many-to-one class="idas.chox.core.model.Chorganisation" column="chorganisation_id" name="chorganisation"/>
    <property column="min_volume" name="minVolume" not-null="true"/>
    <property column="max_volume" name="maxVolume" not-null="false"/>
    <property column="fee" name="fee" not-null="true"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" lazy="false" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
  </class>
</hibernate-mapping>
