<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.VehicleHire" table="vehicle_hire">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">vehicle_hire_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="vehicle_registration" name="vehicleRegistration" not-null="false"/>
    <property column="vehicle_manufacturer" name="vehicleManufacturer" not-null="false"/>
    <property column="vehicle_model" name="vehicleModel" not-null="false"/>
    <property column="rental_start" name="rentalStart" not-null="false"/>
    <property column="rental_start_original" name="rentalStartOriginal" not-null="false"/>
    <property column="rental_end" name="rentalEnd"/>
    <property column="rental_end_original" name="rentalEndOriginal"/>
    <property column="collection_reason" name="collectionReason" not-null="false"/>
    <property column="days" name="days"/>
    <property column="days_original" name="daysOriginal"/>
<!--
    <property column="cdw_fee" name="miscellaneousFee" not-null="false"/>
    <property column="automatic_fee" name="automaticFee" not-null="false"/>
    <property column="sat_nav_fee" name="satNavFee" not-null="false"/>
    <property column="estate_fee" name="estateFee" not-null="false"/>
    <property column="baby_seat_fee" name="babySeatFee" not-null="false"/>
    <property column="tow_bars_fee" name="towBarsFee" not-null="false"/>
    <property column="non_standard_insurance_premium_fee" name="nonStandardInsurancePremiumFee" not-null="false"/>
    <property column="admin_fee" name="adminFee" not-null="false"/>
    <property column="roof_rack_fee" name="roofRackFee" not-null="false"/>
    <property column="dual_control_fee" name="dualControlFee" not-null="false"/>
    <property column="delivery_collection_fee" name="deliveryCollectionFee" not-null="false"/>
-->
    <property column="hpi_vehicle_manufacturer" name="hpiVehicleManufacturer"/>
    <property column="hpi_vehicle_model" name="hpiVehicleModel"/>
    <property column="hpi_first_registration" name="hpiFirstRegistration"/>
    <property column="hpi_vehicle_year" name="hpiVehicleYear"/>
    <property column="hpi_vehicle_capacity" name="hpiVehicleCapacity"/>
    <property column="hpi_vehicle_doorplan" name="hpiVehicleDoorplan"/>
    <property column="hpi_vehicle_transmission" name="hpiVehicleTransmission"/>
    <property column="hpi_error" name="hpiError"/>
    <property column="courtesy_car_provided" name="courtesyCarProvided" not-null="false"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <property column="created_date" name="createdDate"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <many-to-one class="idas.chox.core.model.VehicleClass" column="vehicle_class_id" name="vehicleClass"/>
    <many-to-one class="idas.chox.core.model.VehicleClass" column="vehicle_class_original_id" name="vehicleClassOriginal"/>
  </class>
</hibernate-mapping>
