<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.History" table="history">
    <cache usage="read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">history_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="narrative" name="narrative"/>
    <property column="process_date" name="processDate"/>
    <property column="is_public" name="isPublic" not-null="true"/>
    <property column="is_old" name="isOld" not-null="true"/>
    <property column="type" name="type"/>
    <property column="rule_id" name="ruleId" not-null="true"/>
    <property column="is_system" name="isSystem" not-null="true"/>
    <many-to-one class="idas.chox.core.model.Claim" column="claim_id" name="claim"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
  </class>
</hibernate-mapping>
