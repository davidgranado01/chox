<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.WebUser" table="web_user">
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">web_user_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="user_name" name="userName" not-null="true"/>
    <property column="email" name="email" not-null="true"/>
    <property column="first_name" name="firstName" not-null="true"/>
    <property column="last_name" name="lastName" not-null="true"/>
    <property column="password" name="password" not-null="true"/>
    <property column="telephone" name="telephone" not-null="false" />
    <property column="status" name="status" not-null="true"/>
    <property column="is_expired" name="isExpired"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <property column="created_date" name="createdDate"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <many-to-one class="idas.chox.core.model.Chorganisation" column="chorganisation_id" lazy="false" name="chorganisation"/>
    <many-to-one class="idas.chox.core.model.Insurer" column="insurer_id" lazy="false" name="insurer"/>
    <set cascade="none" lazy="false" name="roles" table="web_user_user_role">
      <key column="web_user_id"/>
      <many-to-many class="idas.chox.core.model.WebUserRole" column="web_user_role_id"/>
    </set>
    <set cascade="none" lazy="false" name="workgroups" table="web_user_workgroup">
      <key column="user_id"/>
      <many-to-many class="idas.chox.core.model.Workgroup" column="workgroup_id"/>
    </set>
  </class>
</hibernate-mapping>
