<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.Notification" table="notification">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">notification_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="type" name="type"/>
    <property column="message" name="message"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="acknowledge" name="acknowledged"/>
    <property column="is_deleted" name="deleted" not-null="true"/>
    <many-to-one cascade="none" class="idas.chox.core.model.Claim" column="claim_id" name="claim"/>
    <many-to-one cascade="none" class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <many-to-one cascade="none" class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
  </class>
</hibernate-mapping>
