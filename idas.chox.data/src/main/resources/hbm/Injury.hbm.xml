<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.Injury" table="injury">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">injury_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="name" name="name"/>
    <property column="address1" name="address1"/>
    <property column="address2" name="address2"/>
    <property column="address3" name="address3"/>
    <property column="address4" name="address4"/>
    <property column="address5" name="address5"/>
    <property column="postcode" name="postcode"/>
    <property column="telephone_day" name="telephoneDay"/>
    <property column="telephone_evening" name="telephoneEvening"/>
    <property column="email" name="email"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <many-to-one class="idas.chox.core.model.Incident" column="incident_id" name="incident" unique="true"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <component class="idas.chox.core.model.Solicitor" name="solicitor">
      <!-- class attribute optional -->
      <property column="solicitor_name" name="name"/>
      <property column="solicitor_address1" name="address1"/>
      <property column="solicitor_address2" name="address2"/>
      <property column="solicitor_address3" name="address3"/>
      <property column="solicitor_address4" name="address4"/>
      <property column="solicitor_address5" name="address5"/>
      <property column="solicitor_postcode" name="postcode"/>
      <property column="solicitor_telephone" name="telephone"/>
      <property column="solicitor_email" name="email"/>
      <property column="solicitor_is_appointed" name="isAppointed" not-null="true"/>
    </component>
  </class>
</hibernate-mapping>
