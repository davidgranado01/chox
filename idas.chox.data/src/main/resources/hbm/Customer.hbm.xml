<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.Customer" table="customer">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">customer_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="title" name="title" not-null="true"/>
    <property column="first_name" name="firstName" not-null="true"/>
    <property column="last_name" name="lastName" not-null="true"/>
    <property column="address1" name="address1"/>
    <property column="address2" name="address2"/>
    <property column="address3" name="address3"/>
    <property column="address4" name="address4"/>
    <property column="address5" name="address5"/>
    <property column="postcode" name="postcode"/>
    <property column="telephone_day" name="telephoneDay"/>
    <property column="telephone_evening" name="telephoneEvening"/>
    <property column="email" name="email"/>
    <property column="vehicle_registration" name="vehicleRegistration" not-null="true"/>
    <property column="vehicle_manufacturer" name="vehicleManufacturer" not-null="true"/>
    <property column="vehicle_model" name="vehicleModel" not-null="true"/>
    <property column="vehicle_year" name="vehicleYear"/>
    <property column="location" name="location"/>
    <property column="damage" name="damage"/>
    <property column="initial_ecd" name="initialECD" not-null="false"/>
    <property column="policy_number" name="policyNumber"/>
    <property column="claim_reference" name="claimReference"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="is_primary_driver" name="isPrimaryDriver" not-null="true"/>
    <property column="is_usable" name="isUsable"/>
    <property column="is_active" name="isActive" not-null="true"/>
    <property column="comprehensive" name="comprehensive" not-null="true"/>
    <property column="is_total_loss" name="isTotalLoss" not-null="true"/>
    <property column="is_total_loss_original" name="isTotalLossOriginal" not-null="false"/>
    <property column="insurer_name" name="insurerName" not-null="true"/>
    <property column="age" name="age"/>
    <property column="occupation" name="occupation"/>
    <property column="policy_usage" name="policyUsage"/>
    <property column="access_other_vehicle" name="canAccessOtherVehicle"/>
    <property column="other_vehicle_used" name="otherVehicleUsed"/>
    <property column="other_vehicle" name="otherVehicle"/>
    <property column="courtesy_car" name="courtesyCarEntitled"/>
    <property column="specific_vehicle" name="specificVehicleRequired"/>
    <property column="specific_vehicle_reason" name="specificVehicleReason"/>
    <property column="vehicle_type_required" name="typeVehicleRequired"/>
    <property column="special_requirements" name="specialRequirements"/>
    <property column="average_daily_mileage" name="averageDailyMileage"/>
    <property column="hpi_vehicle_manufacturer" name="hpiVehicleManufacturer"/>
    <property column="hpi_vehicle_model" name="hpiVehicleModel"/>
    <property column="hpi_vehicle_year" name="hpiVehicleYear"/>
    <property column="hpi_first_registration" name="hpiFirstRegistration"/>
    <property column="hpi_vehicle_capacity" name="hpiVehicleCapacity"/>
    <property column="hpi_vehicle_doorplan" name="hpiVehicleDoorplan"/>
    <property column="hpi_vehicle_transmission" name="hpiVehicleTransmission"/>
    <property column="hpi_error" name="hpiError"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <many-to-one class="idas.chox.core.model.VehicleClass" column="vehicle_class_id" name="vehicleClass"/>
  </class>
</hibernate-mapping>
