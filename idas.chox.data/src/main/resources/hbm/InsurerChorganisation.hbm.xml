<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.InsurerChorganisation" table="insurer_chorganisation">
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">insurer_chorganisation_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="status" name="status" not-null="true"/>
    <property column="special_price" name="specialPriceActivated" not-null="true"/>
    <property column="is_third_pary_intervention_activated" name="thirdPartyInterventionActivated"/>
    <property column="is_tpi_claim_only" name="tpiClaimOnly"/>
    <property column="tpi_identifier" name="tpiIdentificationString"/>
    <property column="tpi_regex_expression" name="tpiRegexExpression"/>
    <many-to-one class="idas.chox.core.model.Workgroup" column="tpi_workgroup" name="tpiWorkgroup"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="tpi_claim_owner" name="tpiClaimOwner"/>
    <many-to-one class="idas.chox.core.model.Insurer" column="insurer_id" name="insurer"/>
    <many-to-one class="idas.chox.core.model.Chorganisation" column="chorganisation_id" name="chorganisation"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
  </class>
</hibernate-mapping>
