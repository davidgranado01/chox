<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.Workgroup" table="workgroup">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">workgroup_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="name" name="name" not-null="true"/>
    <property column="site" name="site" not-null="true"/>
    <property column="team" name="team" not-null="true"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="stp_excluded" name="stpExcluded" not-null="true"/>
    <property column="status" name="status" not-null="true"/>
    <property column="created_date" name="createdDate"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.Insurer" column="insurer_id" name="insurer" not-null="true"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <filter condition="insurer_id IN (:insurerIds)" name="insurer_filter"/>
    <!-- The below filter is no longer used. So removing from the filter list-->
    <!--<filter condition=":workgroupId = id" name="Workgroup_WorkgroupFilter"/>-->
  </class>
<!--
  <filter-def name="Workgroup_WorkgroupFilter">
    <filter-param name="workgroupId" type="integer"/>
  </filter-def>-->
  <filter-def name="insurer_filter">
      <filter-param name="insurerIds" type="integer"/>
  </filter-def>
  
</hibernate-mapping>
