<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.BrePenaltyBand" table="bre_penalty_band">
    <cache usage="read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">bre_penalty_band_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <many-to-one class="idas.chox.core.model.BreBand" column="bre_band_id" name="breBand"/>
    <property column="claim_type" name="claimType"
        type="idas.chox.data.hibernate.ClaimTypeMapping" not-null="true"/>
    <property column="start_date" name="startDate" not-null="true"/>
    <property column="hire_day_1" name="hireDay1" not-null="true"/>
    <property column="hire_day_2" name="hireDay2" not-null="true"/>
    <property column="hire_day_3" name="hireDay3" not-null="true"/>
    <property column="hire_period_start_day_1" name="hirePeriodStartDay1" not-null="true"/>
    <property column="hire_period_start_day_2" name="hirePeriodStartDay2" not-null="true"/>
    <property column="hire_period_start_day_3" name="hirePeriodStartDay3" not-null="true"/>
    <property column="repair_day_1" name="repairDay1" not-null="true"/>
    <property column="repair_day_2" name="repairDay2" not-null="true"/>
    <property column="repair_day_3" name="repairDay3" not-null="true"/>
    <property column="repair_period_start_day_1" name="repairPeriodStartDay1" not-null="true"/>
    <property column="repair_period_start_day_2" name="repairPeriodStartDay2" not-null="true"/>
    <property column="repair_period_start_day_3" name="repairPeriodStartDay3" not-null="true"/>
    <property column="use_commercial_day_1" name="useCommercialDay1" not-null="true"/>
    <property column="use_commercial_day_2" name="useCommercialDay2" not-null="true"/>
    <property column="use_commercial_day_3" name="useCommercialDay3" not-null="true"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <property column="created_date" name="createdDate"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
  </class>
</hibernate-mapping>
