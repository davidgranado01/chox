<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="idas.chox.core.model.ChoBillingBand" table="cho_billing_band">
        <cache usage="read-write"/>
        <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">cho_billing_band_id_seq</param>
            </generator>
        </id>
        <version column="version" name="version" unsaved-value="null"/>
        <property column="band_name" name="bandName" not-null="true"/>
        <property column="cost_per_claim" name="costPerClaim" not-null="true"/>
        <property column="exclude_supplementary" name="excludeSupplementary" not-null="true"/>
        <property column="trigger_status" name="triggerStatus" not-null="true"/>
        <property column="created_date" name="createdDate"/>
        <property column="last_modified_date" name="lastModifiedDate"/>
        <many-to-one class="idas.chox.core.model.Chorganisation" column="chorganisation_id" name="chorganisation"/>
        <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
        <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>    

        <filter condition="chorganisation_id IN (:chorganisationIds)" name="chorganisation_filter"/>
        
    </class>
    
    <filter-def name="chorganisation_filter">
        <filter-param name="chorganisationIds" type="integer"/>
    </filter-def>
  
</hibernate-mapping>
