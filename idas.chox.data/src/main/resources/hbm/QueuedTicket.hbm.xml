<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="idas.chox.core.model.QueuedTicket" table="queued_ticket">
        <cache usage="nonstrict-read-write"/>
        <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">queued_ticket_id_seq</param>
            </generator>
        </id>
        <property column="sender" name="sender" />
        <property column="old_reference" name="oldReference"/>
        <property column="new_reference" name="newReference"/>
        <property column="created_date" name="createdDate"/>
    </class>
</hibernate-mapping>
