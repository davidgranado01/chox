<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.Claim" table="claim">
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">claim_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="managing_repair" name="managingRepair" not-null="true"/>
    <property column="managing_repair_original" name="managingRepairOriginal"/>
    <property column="managing_repair_last_modified_date" name="managingRepairLastModified"/>
    <property column="policy_holder_contact_date" name="policyHolderContactDate"/>
    <property column="cho_reference" name="choReference"/>
    <property column="status" name="status" not-null="true"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="claim_number" name="claimNumber"/>
    <property column="gta_notice_date" name="gtaNoticeDate"/>
    <property column="credit_agreement_date" name="creditAgreementDate"/>
    <property column="indeminty_amount" name="indemnityAmount"/>
    <property column="percentage_liability_accepted" name="percentageLiabilityAccepted"/>
    <property column="is_quantum_dispute" name="isQuantumDispute"/>
    <property column="is_fnol_reviewed" name="isFnolReviewed"/>
    <property column="is_total_loss_chase" name="totalLossChase"/>
    <property column="tpi_claim_status" name="tpiClaimStatus"/>
    <property column="is_invoice_review_required" name="isInvoiceReviewRequired"/>
    <property column="status_modified_date" name="statusModifiedDate"/>
    <property column="previous_status" name="previousStatus"/>
    <property column="percentage_liability_cho" name="percentageLiabilityCho"/>
    <property column="liability_agreed_date" name="liabilityAgreedDate"/>
    <property column="liability_status_modified_date" name="liabilityStatusModifiedDate"/>
    <property column="liability_modified_date" name="liabilityModifiedDate"/>
    <property column="sla_ext_days" name="slaExtDays" not-null="true"/>
    <property column="no_attachments" name="noAttachments" not-null="true"/>
    <property column="remaining_sla_days_str" name="remainingSlaDays" />
    <property column="remaining_sla_days" name="remainingSlaDaysInt" />
    <property column="liability_status" name="liabilityStatus"
        type="idas.chox.data.hibernate.LiabilityStatusMapping"/>
    <property column="auto_penalty_charges" name="autoPenaltyChargeEnabled"/>
    <property column="claim_type" name="claimType"
        type="idas.chox.data.hibernate.ClaimTypeMapping" not-null="true"/>
    <property column="manual_invoice_approved" name="manualInvoiceApproved"/>
    <property column="final_review_cho" name="finalReviewCho" not-null="true"/>
    <property column="final_review_ins" name="finalReviewIns" not-null="true"/>
    <property column="final_review_date_cho" name="finalReviewDateCho" />
    <property column="final_review_date_ins" name="finalReviewDateIns" />
    <property column="is_payment_dispute" name="paymentDispute" not-null="true"/>
    <property column="with_solicitor" name="caseWithClientsSolicitor" not-null="true"/>
    <property column="date_marked_with_solicitor" name="dateMarkedWithSolicitor"/>
    <property column="user_marked_with_solicitor" name="userMarkedWithSolicitor"/>
    <property column="fraud_check_status" name="fraudCheckStatus"/>
    <property column="fraud_result_acknowledged" name="fraudResultAcknowledged"/>
    <property column="sent_to_keoghs" name="sentToKeoghs"/>
    <property column="last_review_date" name="lastReviewDate" />
    <many-to-one class="idas.chox.core.model.KeoghsRequest" column="keoghs_request_id" name="keoghsRequest"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="final_review_by_cho" name="finalReviewByCho" />
    <many-to-one class="idas.chox.core.model.WebUser" column="final_review_by_ins" name="finalReviewByIns" />
    <many-to-one class="idas.chox.core.model.ReasonOfRejection" column="reason_of_rejection_id" name="reasonOfRejection"/>
    <many-to-one class="idas.chox.core.model.Chorganisation" column="chorganisation_id" name="chorganisation"/>
    <many-to-one class="idas.chox.core.model.Insurer" column="insurer_id" name="insurer"/>
    <many-to-one class="idas.chox.core.model.Workgroup" column="workgroup_id" name="workgroup"/>
    <many-to-one class="idas.chox.core.model.Workgroup" column="workgroup_id_original" name="workgroupOriginal"/>
    <many-to-one cascade="save-update,delete" class="idas.chox.core.model.Customer" column="customer_id" name="customer"/>
    <many-to-one cascade="save-update,delete" class="idas.chox.core.model.EngineerReport" column="engineer_report_id" name="engineerReport"/>
    <many-to-one cascade="save-update,delete" class="idas.chox.core.model.HireMonitoringDetail" column="hire_monitoring_detail_id" name="hireMonitoringDetail"/>
    <many-to-one cascade="save-update,delete" class="idas.chox.core.model.InsurerHireMonitoringDetail" column="insurer_hire_monitoring_detail_id" name="insurerHireMonitoringDetail"/>
    <many-to-one cascade="save-update,delete" class="idas.chox.core.model.Incident" column="incident_id" name="incident"/>
    <many-to-one cascade="save-update,delete" class="idas.chox.core.model.Invoice" column="invoice_id" name="invoice"/>
    <many-to-one cascade="save-update,delete" class="idas.chox.core.model.ThirdParty" column="third_party_id" name="thirdParty"/>
    <many-to-one cascade="save-update,delete" class="idas.chox.core.model.VehicleHire" column="vehicle_hire_id" name="vehicleHire"/>
    <many-to-one cascade="save-update,delete" class="idas.chox.core.model.InsurerVehicleHire" column="insurer_vehicle_hire_id" name="insurerVehicleHire"/>
    <many-to-one cascade="save-update,delete" class="idas.chox.core.model.ClaimAuditReview" column="audit_review_id" name="claimAuditReview"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="claim_owner_id" name="claimOwner"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="claim_owner_id_original" name="claimOwnerOriginal"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="cho_claim_owner_id" name="supplierClaimOwner"/>
    <bag cascade="all,delete-orphan" inverse="true" lazy="extra" name="hireMonitoringEcds" order-by="created_date asc">
      <key column="claim_id"/>
      <one-to-many class="idas.chox.core.model.HireMonitoringEcd"/>
    </bag>
    <bag cascade="all,delete-orphan" inverse="true" lazy="extra" name="insurerHireMonitoringEcds" order-by="created_date asc">
      <key column="claim_id"/>
      <one-to-many class="idas.chox.core.model.InsurerHireMonitoringEcd"/>
    </bag>
    <bag cascade="all, delete-orphan" inverse="true" name="attachments">
      <key column="claim_id"/>
      <one-to-many class="idas.chox.core.model.Attachment"/>
    </bag>
    <bag cascade="all,delete-orphan" inverse="true" lazy="extra" name="histories" order-by="created_date asc">
      <key column="claim_id"/>
      <one-to-many class="idas.chox.core.model.History"/>
    </bag>
    <bag cascade="all,delete-orphan" inverse="true" lazy="extra" name="comments" order-by="created_date asc">
      <key column="claim_id"/>
      <one-to-many class="idas.chox.core.model.Comment"/>
    </bag>
    <filter condition="chorganisation_id IN (:choIds)" name="cho_filter"/>
    <filter condition="insurer_id IN (:insurerIds)" name="insurer_filter"/>
    <filter condition=":claimOwnershipId = claim_owner_id" name="Claim_OwnershipFilter"/>
    <filter condition=":claimSupplierOwnershipId = cho_claim_owner_id" name="Claim_SupplierOwnershipFilter"/>
    <filter condition="workgroup_id IN (:workgroupIds)" name="Claim_WorkgroupFilter"/>
  </class>
  <filter-def name="cho_filter">
      <filter-param name="choIds" type="integer"/>
  </filter-def>
  <filter-def name="insurer_filter">
      <filter-param name="insurerIds" type="integer"/>
  </filter-def>
  <filter-def name="Claim_WorkgroupFilter">
    <filter-param name="workgroupIds" type="integer"/>
  </filter-def>
  <filter-def name="Claim_OwnershipFilter">
    <filter-param name="claimOwnershipId" type="integer"/>
  </filter-def>
  <filter-def name="Claim_SupplierOwnershipFilter">
    <filter-param name="claimSupplierOwnershipId" type="integer"/>
  </filter-def>
</hibernate-mapping>
