<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.ReasonOfRejection" table="reason_of_rejection">
    <cache usage="read-write"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">reason_of_rejection_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="name" name="rorName"/>
    <property column="restricted" name="restricted"/>
    <property column="type" name="type"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.Insurer" column="insurer_id" name="insurer"/>
    <property column="created_date" name="createdDate"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <property column="description" name="description"/>
    <property column="gta_active" name="gtaActive" not-null="true"/>
    <property column="collaboration_active" name="collaborationActive" not-null="true"/>
    <property column="insurer_vs_insurer_active" name="insurerVsInsurerActive" not-null="true"/>
    <property column="subscriber_active" name="subscriberActive" not-null="true"/>
    <property column="fixed_fee_active" name="fixedFeeActive" not-null="true"/>
    <property column="insurer_upload_active" name="insurerUploadActive" not-null="true"/>
    <property column="tpi_active" name="tpiActive" not-null="true"/>
  </class>
</hibernate-mapping>
