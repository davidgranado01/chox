<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="idas.chox.core.model.Chorganisation" table="chorganisation">
        <cache usage="nonstrict-read-write"/>
        <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">chorganisation_id_seq</param>
            </generator>
        </id>
        <version column="version" name="version" unsaved-value="null"/>
        <property column="name" name="name" not-null="true"/>
        <property column="address1" name="address1" not-null="true"/>
        <property column="address2" name="address2" not-null="true"/>
        <property column="address3" name="address3"/>
        <property column="address4" name="address4"/>
        <property column="address5" name="address5"/>
        <property column="postcode" name="postcode" not-null="true"/>
        <property column="phone" name="phone"/>
        <property column="vat_no" name="vatNo" not-null="true"/>
        <property column="company_no" name="companyNo" not-null="true"/>
        <property column="status" name="status" not-null="true"/>
        <property column="is_delegated_authority" name="delegatedAuthority" not-null="true"/>
        <property column="created_date" name="createdDate"/>
        <property column="last_modified_date" name="lastModifiedDate"/>
        <property column="is_claim_ownership_enable" name="claimOwnershipEnable"/>
        <property column="is_fixed_transactional_fee" name="fixedTransactionalFee"/>
        <property column="fixed_transactional_fee_value" name="fixedTransactionalFeeValue"/>
        <property column="adjust_daily_rate_charge" name="adjustDailyRateCharge"/>
        <property column="daily_rate_charge_limit" name="dailyRateChargeLimit"/>
        <property column="is_task_management_enable" name="taskManagementEnable"/>
        <property column="is_third_pary_intervention_activated" name="thirdPartyInterventionActivated"/>
        <property column="force_password_change" name="forcePasswordChange" not-null="true"/>
        <property column="unique_password_history" name="uniquePasswordHistory" not-null="true"/>
        <property column="minimum_password_length" name="minimumPasswordLength" not-null="true"/>
        <property column="max_allowed_sla_ext_for_subscriber" name="maxAllowedSlaExtForSubscriber" not-null="true"/>
        <property column="max_allowed_sla_ext_for_fixed_fee" name="maxAllowedSlaExtForFixedFee" not-null="true"/>
        <property column="insurer_upload_only" name="insurerUploadOnly" not-null="true"/>
        <property column="enable_subscriber_claims" name="enableSubscriberClaims" not-null="true"/>
        <property column="enable_collaboration_claims" name="enableCollaborationProtocolClaims" not-null="true"/>
        <property column="enable_fixedfee_claims" name="enableFixedFeeClaims" not-null="true"/>
        <property column="auto_penalty_charges" name="autoPenaltyChargeEnabled"/>
        <property column="enable_ip_whitelist" name="enableIPWhitelist" not-null="true"/>
        <property column="max_login_attempts" name="maxLoginAttempts" not-null="true"/>
        <property column="block_time" name="blockTime" not-null="true"/>
        <property column="disable_private_notes" name="disablePrivateNotes" not-null="true"/>
        <property column="blocked_message" name="blockedMessage" not-null="true"/>
        <property column="restrict_export" name="restrictExport" not-null="true"/>
        <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy"/>
        <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
        
        <filter condition="id IN (:choIds)" name="cho_filter"/>

    </class>
    
    <filter-def name="cho_filter">
          <filter-param name="choIds" type="integer"/>
    </filter-def>
    
</hibernate-mapping>
