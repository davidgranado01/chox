<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.AdminFee" table="admin_fee">
    <cache usage="read-only"/>
    <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">admin_fee_id_seq</param>
            </generator>
    </id>
    <version column="version" name="version" unsaved-value="null"/>
    <property column="fee" name="fee" not-null="true"/>
    <property column="start_date" name="startDate" not-null="true"/>
    <property column="managing_repair" name="managingRepair" not-null="true"/>
    <property column="cover_note_required" name="coverNoteRequired" not-null="true"/>
    <property column="last_modified_date" name="lastModifiedDate" not-null="true"/>
    <property column="created_date" name="createdDate" not-null="true"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy" not-null="true"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" name="createdBy" not-null="true"/>
  </class>
</hibernate-mapping>
