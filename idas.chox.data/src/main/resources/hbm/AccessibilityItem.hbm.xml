<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="idas.chox.core.model.AccessibilityItem" table="accessibility_item">
        <cache usage="read-only"/>
        <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence_name">accessibility_item_id_seq</param>
            </generator>
        </id>
        <property column="role" name="role" not-null="true"/>
        <property column="access_right" name="accessRight" not-null="true"/>
        <many-to-one class="idas.chox.core.model.Accessibility" column="accessibility_id" name="Accessibility" not-null="true"/>
    </class>
</hibernate-mapping>
