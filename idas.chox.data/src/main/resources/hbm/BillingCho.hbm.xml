<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="idas.chox.core.model.BillingCho" schema="public" table="billing_cho">
    <cache usage="nonstrict-read-write"/>
    <id column="id" name="id">
        <generator class="sequence">
            <param name="sequence">billing_cho_id_seq</param>
        </generator>
    </id>
    <many-to-one class="idas.chox.core.model.Chorganisation" column="cho_id" name="cho"/>
    <property column="schedule_name" name="scheduleName" type="string"/>
    <property column="date_from" name="dateFrom"/>
    <property column="date_to" name="dateTo"/>
    <property column="invoice_amount" name="invoiceAmount"/>
    <property column="number_submitted" name="numberInvoicesSubmitted"/>
    <property column="number_received" name="numberPaymentsReceived"/>
    <property column="amount_received" name="amountReceived"/>
    <property column="manual" name="manual"/>
    <property column="reconciled" name="reconciled"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="created_by" lazy="false" name="createdBy"/>
    <many-to-one class="idas.chox.core.model.WebUser" column="last_modified_by" name="lastModifiedBy"/>
    <property column="created_date" name="createdDate"/>
    <property column="last_modified_date" name="lastModifiedDate"/>
    <set cascade="all" inverse="true" name="billingDetails">
      <key column="billing_cho_id"/>
      <one-to-many class="idas.chox.core.model.BillingChoDetail"/>
    </set>
  </class>
</hibernate-mapping>
