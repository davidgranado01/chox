<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="idas.chox.core.model.Accessibility" table="accessibility">
        <cache usage="read-only"/>
        <id column="id" name="id">
            <generator class="sequence">
                <param name="sequence">accessibility_id_seq</param>
            </generator>
        </id>
        <property column="name" name="name" not-null="true"/>
        <property column="claim_type" name="claimType" type="idas.chox.data.hibernate.ClaimTypeMapping"/>
        <property column="is_workgroup_check" name="workgroupCheck"/>
        <property column="is_ownership_check" name="ownershipCheck"/>
        <property column="check_workgroup_enabled" name="checkWorkgroupEnabled"/>
        <property column="check_claimownership_enabled" name="checkClaimOwnershipEnabled"/>
        <property column="check_supplier_ownership" name="checkSupplierClaimOwnershipEnabled"/>
        <property column="check_fnol_enabled" name="checkFnolEnabled"/>
        <property column="check_engineer_enabled" name="checkEngineerEnabled"/>
        <property column="check_manual_inv_workgroup_enabled" name="checkManualInvoiceWrokgroupEnabled"/>
        <property column="check_manual_inv_claimownership_enabled" name="checkManualInvoiceClaimOwnershipEnabled"/>
        <set lazy="extra" name="AccessibilityItem">
            <key column="accessibility_id"/>
            <one-to-many class="idas.chox.core.model.AccessibilityItem"/>
        </set>
    </class>
</hibernate-mapping>
